import { fetch } from 'wix-fetch';
import { getSecret } from 'wix-secrets-backend';

const TELEGRAM_CHAT_ID = '1578329343';

function formatDT(value) {
  if (!value) return '—';
  try {
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return String(value);
    return d.toLocaleString('el-GR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Athens' });
  } catch (_) { return String(value); }
}

export async function testTelegramNotification() {
  const result = { secretFound: false, tokenLength: 0, apiStatus: null, apiResponse: null, error: null };
  try {
    const token = await getSecret('TELEGRAM_BOT_TOKEN');
    result.secretFound = !!token;
    result.tokenLength = token ? String(token).trim().length : 0;
    if (!token) return result;
    const res = await fetch(`https://api.telegram.org/bot${String(token).trim()}/sendMessage`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chat_id: TELEGRAM_CHAT_ID, text: '✅ Test από Diamond Rent A Car — σύνδεση Telegram επιβεβαιώθηκε!' })
    });
    result.apiStatus = res.status;
    result.apiResponse = await res.json();
  } catch (err) {
    result.error = err.message || String(err);
  }
  return result;
}

export async function sendTelegramNotification(booking) {
  try {
    const token = await getSecret('TELEGRAM_BOT_TOKEN');
    if (!token) return;
    const lines = [
      '🚗 <b>Νέα Κράτηση!</b>',
      '',
      `📋 <b>${booking.bookingNumber || '—'}</b>`,
      `👤 ${booking.customerName || '—'}  📞 ${booking.phone || '—'}`,
      `📧 ${booking.email || '—'}`,
      '',
      `🚙 ${booking.vehicleCategoryName || booking.category || '—'}`,
      `📍 Παραλαβή: ${booking.pickuppoint || '—'}`,
      `   ${formatDT(booking.pickupDateTime)}`,
      `📍 Επιστροφή: ${booking.dropoffpoint || '—'}`,
      `   ${formatDT(booking.dropoffDateTime)}`,
      `📅 ${booking.billableDays || 1} ημέρ${(booking.billableDays || 1) === 1 ? 'α' : 'ες'}`,
      '',
      `🛡️ Ασφάλιση: ${String(booking.selectedPackage || '—').toUpperCase()}`,
    ];
    if (booking.extras) lines.push(`➕ Extras: ${booking.extras}`);
    const originCity = String(booking.city || booking.originCity || '').trim();
    if (originCity) lines.push(`🏙️ Πόλη: ${originCity}`);
    if (booking.flightNumber) lines.push(`✈️ Πτήση: ${booking.flightNumber}`);
    if (booking.dropoffInfo) lines.push(`🔄 Επιστροφή: ${booking.dropoffInfo}`);
    lines.push('', `💶 Σύνολο: <b>${Number(booking.totalPrice || 0).toFixed(2)} €</b>`);
    const comments = String(booking.internalMemo || '').trim();
    if (comments) lines.push(`💬 Σχόλια: ${comments}`);
    const res = await fetch(`https://api.telegram.org/bot${String(token).trim()}/sendMessage`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chat_id: TELEGRAM_CHAT_ID, text: lines.join('\n'), parse_mode: 'HTML' })
    });
    const json = await res.json();
    if (!json.ok) {
      console.error('[telegram] sendMessage failed', JSON.stringify(json));
    } else {
      console.log('[telegram] sendMessage ok, message_id:', json.result?.message_id);
    }
  } catch (err) {
    console.error('[telegram] sendTelegramNotification error', err?.message || String(err));
  }
}

export async function sendTelegramCancelNotification(booking) {
  try {
    const token = await getSecret('TELEGRAM_BOT_TOKEN');
    if (!token) return;
    const lines = [
      '❌ <b>Ακύρωση Κράτησης!</b>',
      '',
      `📋 <b>${booking.bookingNumber || '—'}</b>`,
      `👤 ${booking.driverName || '—'}  📞 ${booking.driverPhone || '—'}`,
      `📧 ${booking.driverEmail || '—'}`,
      '',
      `🚙 ${booking.vehicleName || '—'}`,
      `📍 Παραλαβή: ${booking.pickupLocation || '—'}  ${formatDT(booking.pickupDateTime)}`,
      `📍 Επιστροφή: ${booking.dropoffLocation || '—'}  ${formatDT(booking.dropoffDateTime)}`,
      '',
      `💶 Σύνολο: <b>${Number(booking.totalPrice || 0).toFixed(2)} €</b>`,
    ];
    if (booking.cancelReason) lines.push(`💬 Λόγος: ${booking.cancelReason}`);
    const res = await fetch(`https://api.telegram.org/bot${String(token).trim()}/sendMessage`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chat_id: TELEGRAM_CHAT_ID, text: lines.join('\n'), parse_mode: 'HTML' })
    });
    const json = await res.json();
    if (!json.ok) console.error('[telegram] cancelNotification failed', JSON.stringify(json));
  } catch (err) { console.error('[telegram] sendTelegramCancelNotification error', err?.message || String(err)); }
}

export async function sendTelegramEditNotification(booking, changes) {
  try {
    const token = await getSecret('TELEGRAM_BOT_TOKEN');
    if (!token) return;
    const lines = [
      '✏️ <b>Τροποποίηση Κράτησης!</b>',
      '',
      `📋 <b>${booking.bookingNumber || '—'}</b>`,
      `👤 ${booking.driverName || '—'}  📞 ${booking.driverPhone || '—'}`,
      `🚙 ${booking.vehicleName || '—'}`,
      '',
      '🔄 <b>Αλλαγές:</b>',
    ];
    if (changes.pickupDateTime) lines.push(`📅 Νέα παραλαβή: ${formatDT(changes.pickupDateTime)}`);
    if (changes.dropoffDateTime) lines.push(`📅 Νέα επιστροφή: ${formatDT(changes.dropoffDateTime)}`);
    if (changes.pickupLocation) lines.push(`📍 Σημείο παραλαβής: ${changes.pickupLocation}`);
    if (changes.dropoffLocation) lines.push(`📍 Σημείο επιστροφής: ${changes.dropoffLocation}`);
    if (changes.notes !== undefined) lines.push(`💬 Σημειώσεις: ${changes.notes || '(αδειο)'}`);
    const res = await fetch(`https://api.telegram.org/bot${String(token).trim()}/sendMessage`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chat_id: TELEGRAM_CHAT_ID, text: lines.join('\n'), parse_mode: 'HTML' })
    });
    const json = await res.json();
    if (!json.ok) console.error('[telegram] editNotification failed', JSON.stringify(json));
  } catch (err) { console.error('[telegram] sendTelegramEditNotification error', err?.message || String(err)); }
}

export async function sendTelegramReviewNotification({ booking, rating, comment }) {
  try {
    const token = await getSecret('TELEGRAM_BOT_TOKEN');
    if (!token) return;
    const stars = '⭐'.repeat(Math.min(5, Math.max(1, Number(rating) || 5)));
    const lines = [
      `⭐ <b>Νέα Αξιολόγηση!</b>`,
      '',
      `📋 <b>${booking.bookingNumber || '—'}</b>`,
      `🚙 ${booking.vehicleName || '—'}`,
      `${stars} <b>${rating}/5</b>`,
    ];
    if (comment) lines.push(`💬 "${comment}"`);
    const res = await fetch(`https://api.telegram.org/bot${String(token).trim()}/sendMessage`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chat_id: TELEGRAM_CHAT_ID, text: lines.join('\n'), parse_mode: 'HTML' })
    });
    const json = await res.json();
    if (!json.ok) console.error('[telegram] reviewNotification failed', JSON.stringify(json));
  } catch (err) { console.error('[telegram] sendTelegramReviewNotification error', err?.message || String(err)); }
}
