
import wixData from 'wix-data';
import { requireStaffAccess } from 'backend/staffAccess.jsw';

const COLLECTIONS = {
  vehicles: 'VehiclesNew',
  fleet: 'FleetNew',
  bookings: 'BookingsNew',
  rentals: 'RentalsNew'
};
const COLLECTION_CANDIDATES = {
  fleet: ['Fleet', 'FleetNew'],
  bookings: ['BookingsNew', 'Bookings'],
  rentals: ['RentalsNew', 'Rentals'],
  vehicles: ['Vehicles', 'VehiclesNew']
};

function txt(v){ return String(v ?? '').trim(); }
function num(v){ const n = Number(v); return Number.isFinite(n) ? n : null; }
function bool(v){
  if (typeof v === 'boolean') return v;
  const raw = txt(v).toLowerCase();
  return raw === 'true' || raw === '1' || raw === 'yes';
}
function iso(v){
  const raw = txt(v);
  if (!raw) return '';
  const d = new Date(raw);
  return Number.isNaN(d.getTime()) ? raw : d.toISOString();
}
function money(v){
  const n = Number(v || 0);
  return Number.isFinite(n) ? Math.round(n * 100) / 100 : 0;
}
function normalizeFleet(item = {}, category = null){
  return {
    fleetVehicleId: txt(item.fleetVehicleId || item._id),
    plate: txt(item.plate),
    model: txt(item.model),
    categoryCode: txt(item.categoryCode || category?.categoryCode),
    categoryId: txt(item.categoryId || category?.categoryRecordId),
    categoryLabel: txt(item.categoryLabel || category?.categoryLabel),
    vehicleLabel: txt(item.vehicleLabel || [txt(item.plate), txt(item.model)].filter(Boolean).join(' - ')),
    active: bool(item.active),
    status: txt(item.status),
    operationalStatus: txt(item.operationalStatus),
    currentStationCode: txt(item.currentStationCode),
    currentStationLabel: txt(item.currentStationLabel),
    mileage: num(item.mileage),
    fuelLevel: num(item.fuelLevel),
    fuelType: txt(item.fuelType),
    excess: num(item.excess),
    ownershipState: txt(item.ownershipState),
    poolType: txt(item.poolType),
    readyToGo: bool(item.readyToGo),
    hardHold: bool(item.hardHold),
    notes: txt(item.notes),
    mediaGallery: txt(item.mediaGallery),
    needsReview: txt(item.needsReview),
    legacyCreatedAt: iso(item.legacyCreatedAt),
    legacyUpdatedAt: iso(item.legacyUpdatedAt),
    legacyOwner: txt(item.legacyOwner)
  };
}
function normalizeCategory(item = {}){
  return {
    categoryRecordId: txt(item.categoryRecordId || item._id),
    categoryCode: txt(item.categoryCode),
    categoryLabel: txt(item.categoryLabel),
    basePricePerDay: num(item.basePricePerDay),
    active: bool(item.active),
    status: txt(item.status),
    image: txt(item.image),
    engineCc: txt(item.engineCc),
    transmission: txt(item.transmission),
    fuelType: txt(item.fuelType),
    seats: txt(item.seats),
    doors: txt(item.doors),
    airCondition: bool(item.airCondition),
    luggageSmall: txt(item.luggageSmall),
    luggageLarge: txt(item.luggageLarge)
  };
}
function chargesGross(raw){
  if (!raw) return 0;
  try {
    const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;
    if (parsed && typeof parsed === 'object') {
      if (parsed.gross != null) return money(parsed.gross);
      const sum = ['rental','insurance','options','transport','damages','surcharges','nightFee','ageFee']
        .reduce((acc, key) => acc + money(parsed[key] || 0), 0) - money(parsed.discount || 0);
      return money(sum);
    }
  } catch (_) {}
  return 0;
}
function compareDateDesc(a,b){
  const ad = new Date(a || 0).getTime() || 0;
  const bd = new Date(b || 0).getTime() || 0;
  return bd - ad;
}

async function firstSuccessful(items = [], fn){
  let lastErr = null;
  for (const item of items) {
    try { return await fn(item); } catch (err) { lastErr = err; }
  }
  if (lastErr) throw lastErr;
  return null;
}

async function findManyByField(collectionNames = [], field, values = []){
  const uniq = Array.from(new Set((values || []).map((v) => txt(v)).filter(Boolean)));
  if (!uniq.length) return [];
  const rows = [];
  for (const name of collectionNames) {
    try {
      const res = await wixData.query(name).hasSome(field, uniq).limit(1000).find({ suppressAuth: true });
      rows.push(...(res.items || []));
    } catch (_) {}
  }
  return rows;
}

async function findFleetRecordByAnyId(rawId){
  const targetId = txt(rawId);
  if (!targetId) return null;
  for (const collectionName of COLLECTION_CANDIDATES.fleet) {
    try {
      const byInternal = await wixData.get(collectionName, targetId, { suppressAuth: true });
      if (byInternal) return byInternal;
    } catch (_) {}
    try {
      const byFleetVehicleId = await wixData.query(collectionName)
        .eq('fleetVehicleId', targetId)
        .limit(1)
        .find({ suppressAuth: true });
      if ((byFleetVehicleId.items || [])[0]) return byFleetVehicleId.items[0];
    } catch (_) {}
  }
  return null;
}

async function findBookingsByIds(ids = []){
  const bookingIds = Array.from(new Set((ids || []).map((v) => txt(v)).filter(Boolean)));
  const map = new Map();
  for (let i = 0; i < bookingIds.length; i += 50) {
    const chunk = bookingIds.slice(i, i + 50);
    if (!chunk.length) continue;
    const rows = [];
    for (const collectionName of COLLECTION_CANDIDATES.bookings) {
      try {
        const byBusinessId = await wixData.query(collectionName).hasSome('bookingId', chunk).limit(1000).find({ suppressAuth: true });
        rows.push(...(byBusinessId.items || []));
      } catch (_) {}
      try {
        const byInternalId = await wixData.query(collectionName).hasSome('_id', chunk).limit(1000).find({ suppressAuth: true });
        rows.push(...(byInternalId.items || []));
      } catch (_) {}
    }
    rows.forEach((item) => {
      const businessId = txt(item.bookingId);
      const internalId = txt(item._id);
      if (businessId) map.set(businessId, item);
      if (internalId) map.set(internalId, item);
    });
  }
  return map;
}

export async function getVehicleCardData({ sessionToken, fleetVehicleId } = {}) {
  await requireStaffAccess({ sessionToken, area: 'fleet', action: 'View' });
  const targetId = txt(fleetVehicleId);
  if (!targetId) throw new Error('MISSING_FLEET_VEHICLE_ID');

  const fleetRecord = await findFleetRecordByAnyId(targetId);
  if (!fleetRecord) throw new Error('FLEET_VEHICLE_NOT_FOUND');
  const categoryQuery = await firstSuccessful(COLLECTION_CANDIDATES.vehicles, async (collectionName) => (
    txt(fleetRecord.categoryId)
      ? wixData.query(collectionName).eq('categoryRecordId', txt(fleetRecord.categoryId)).limit(1).find({ suppressAuth: true })
      : wixData.query(collectionName).eq('categoryCode', txt(fleetRecord.categoryCode)).limit(1).find({ suppressAuth: true })
  ));
  const categoryRecord = normalizeCategory((categoryQuery?.items || [])[0] || {});
  const fleet = normalizeFleet(fleetRecord, categoryRecord);

  const internalId = txt(fleetRecord._id);
  const fleetVehicleBusinessId = txt(fleetRecord.fleetVehicleId || targetId);
  const rentalCandidates = COLLECTION_CANDIDATES.rentals;
  const rentalsByInternal = await findManyByField(rentalCandidates, 'assignedVehicleId', [internalId]);
  const rentalsByBusiness = await findManyByField(rentalCandidates, 'assignedVehicleId', [fleetVehicleBusinessId]);
  const rentalsByFleetVehicleId = await findManyByField(rentalCandidates, 'fleetVehicleId', [fleetVehicleBusinessId, internalId]);

  const rentalsMap = new Map();
  [...rentalsByInternal, ...rentalsByBusiness, ...rentalsByFleetVehicleId].forEach((item) => {
    const key = txt(item.rentalId || item._id || item.bookingId);
    if (key) rentalsMap.set(key, item);
  });
  const rentals = Array.from(rentalsMap.values());
  const bookingsMap = await findBookingsByIds(rentals.map((r) => txt(r.bookingId)));

  const rentalsHistory = rentals.map((r) => {
    const booking = bookingsMap.get(txt(r.bookingId)) || {};
    return {
      rentalId: txt(r.rentalId || r._id),
      bookingId: txt(r.bookingId),
      bookingNumber: txt(booking.bookingNumber),
      customerName: txt(booking.customerName),
      pickupDateTime: iso(booking.pickupDateTime),
      dropoffDateTime: iso(booking.dropoffDateTime),
      pickupPoint: txt(booking.pickupPoint),
      dropoffPoint: txt(booking.dropoffPoint),
      rentalState: txt(r.rentalState),
      paymentStatus: txt(r.paymentStatus || r.financialSnapshot?.settlement?.paymentStatus || booking.paymentStatus),
      totalGross: money(r.financialSnapshot?.totals?.gross ?? booking.financialSnapshot?.totals?.gross ?? chargesGross(r.chargesJson || booking.chargesJson)),
      totalBalance: money(r.financialSnapshot?.settlement?.balance ?? booking.financialSnapshot?.settlement?.balance ?? 0),
      checkoutAt: iso(r.checkoutAt),
      checkinAt: iso(r.checkinAt),
      checkoutOdometer: num(r.checkoutOdometer),
      checkinOdometer: num(r.checkinOdometer),
      checkoutFuelLevel: num(r.checkoutFuelLevel),
      checkinFuelLevel: num(r.checkinFuelLevel)
    };
  }).sort((a,b) => compareDateDesc(a.pickupDateTime, b.pickupDateTime));

  const summary = {
    totalRentals: rentalsHistory.length,
    activeRentals: rentalsHistory.filter((row) => ['Open Rental','Check-Out','Out','Active Rental','Pre Check-In'].includes(txt(row.rentalState))).length,
    bookingOnly: rentalsHistory.filter((row) => txt(row.rentalState) === 'Booking').length,
    lifetimeRevenue: money(rentalsHistory.reduce((sum, row) => sum + money(row.totalGross), 0)),
    outstandingExposure: money(rentalsHistory.reduce((sum, row) => sum + money(row.totalBalance), 0)),
    lastCheckoutAt: rentalsHistory.find((row) => row.checkoutAt)?.checkoutAt || '',
    lastCheckinAt: rentalsHistory.find((row) => row.checkinAt)?.checkinAt || '',
    operationalFlags: {
      readyToGo: !!fleet.readyToGo,
      hardHold: !!fleet.hardHold,
      serviceBlocked: ['service','blocked','inactive'].includes(txt(fleet.operationalStatus || fleet.status).toLowerCase())
    }
  };

  return { success: true, fleet, category: categoryRecord, summary, rentals: rentalsHistory };
}

export async function saveVehicleCardData({ sessionToken, fleetVehicleId, patch = {} } = {}) {
  await requireStaffAccess({ sessionToken, area: 'fleet', action: 'Edit' });
  const targetId = txt(fleetVehicleId);
  if (!targetId) throw new Error('MISSING_FLEET_VEHICLE_ID');
  const current = await findFleetRecordByAnyId(targetId);
  if (!current) throw new Error('FLEET_VEHICLE_NOT_FOUND');

  const next = {
    ...current,
    plate: txt(patch.plate ?? current.plate),
    model: txt(patch.model ?? current.model),
    categoryCode: txt(patch.categoryCode ?? current.categoryCode),
    categoryId: txt(patch.categoryId ?? current.categoryId),
    categoryLabel: txt(patch.categoryLabel ?? current.categoryLabel),
    vehicleLabel: txt(patch.vehicleLabel ?? current.vehicleLabel),
    active: patch.active == null ? current.active : !!patch.active,
    status: txt(patch.status ?? current.status),
    operationalStatus: txt(patch.operationalStatus ?? current.operationalStatus),
    currentStationCode: txt(patch.currentStationCode ?? current.currentStationCode),
    currentStationLabel: txt(patch.currentStationLabel ?? current.currentStationLabel),
    mileage: patch.mileage == null || patch.mileage === '' ? current.mileage : Number(patch.mileage),
    fuelLevel: patch.fuelLevel == null || patch.fuelLevel === '' ? current.fuelLevel : Number(patch.fuelLevel),
    fuelType: txt(patch.fuelType ?? current.fuelType),
    excess: patch.excess == null || patch.excess === '' ? current.excess : Number(patch.excess),
    ownershipState: txt(patch.ownershipState ?? current.ownershipState),
    poolType: txt(patch.poolType ?? current.poolType),
    readyToGo: patch.readyToGo == null ? current.readyToGo : !!patch.readyToGo,
    hardHold: patch.hardHold == null ? current.hardHold : !!patch.hardHold,
    notes: txt(patch.notes ?? current.notes),
    mediaGallery: txt(patch.mediaGallery ?? current.mediaGallery),
    needsReview: txt(patch.needsReview ?? current.needsReview),
    legacyUpdatedAt: new Date().toISOString()
  };

  const targetCollection = COLLECTION_CANDIDATES.fleet.includes(txt(current._collectionName))
    ? txt(current._collectionName)
    : COLLECTIONS.fleet;
  const updated = await wixData.update(targetCollection, next, { suppressAuth: true });
  return { success: true, fleet: normalizeFleet(updated) };
}

export async function getFleetBoard({ sessionToken } = {}) {
  await requireStaffAccess({ sessionToken, area: 'fleet', action: 'View' });

  // 1. All active fleet vehicles — include category reference so vehicles added
  // via Wix CMS (which only populate the reference, not the direct string fields)
  // still resolve categoryCode / categoryLabel correctly.
  const fleetRes = await wixData.query('FleetNew')
    .eq('active', true)
    .include('category')
    .limit(500)
    .find({ suppressAuth: true });
  const vehicles = fleetRes.items || [];

  // 2. All non-closed rentals (to find currently active/out vehicles)
  let rentals = [];
  try {
    const rRes = await wixData.query('RentalsNew')
      .limit(500)
      .find({ suppressAuth: true });
    rentals = (rRes.items || []).filter(r => {
      const st = txt(r.rentalState || '').toLowerCase();
      return !['closed rental','cancelled','voided','completed'].some(c => st.includes(c));
    });
  } catch (_) {}

  // 3. Booking details for active rentals
  const bookingIds = [...new Set(rentals.map(r => txt(r.bookingId)).filter(Boolean))];
  const bookingMap = new Map();
  for (let i = 0; i < bookingIds.length; i += 50) {
    const chunk = bookingIds.slice(i, i + 50);
    try {
      const bRes = await wixData.query('BookingsNew').hasSome('_id', chunk).limit(100).find({ suppressAuth: true });
      (bRes.items || []).forEach(b => { bookingMap.set(txt(b._id), b); if (txt(b.bookingId)) bookingMap.set(txt(b.bookingId), b); });
    } catch (_) {}
  }

  // 4. Map vehicle → active rental
  const vehicleRentalMap = new Map();
  for (const r of rentals) {
    const vId  = txt(r.assignedVehicleId || '');
    const vPlt = txt(r.assignedVehiclePlate || '').toLowerCase();
    const b    = bookingMap.get(txt(r.bookingId)) || {};
    const info = {
      rentalId:        txt(r._id),
      bookingId:       txt(r.bookingId || b._id || ''),
      bookingNumber:   txt(b.bookingNumber || r.bookingNumber || ''),
      customerName:    txt(b.customerName  || r.customerName  || ''),
      pickupDateTime:  txt(b.pickupDateTime  || r.checkoutAt  || ''),
      dropoffDateTime: txt(b.dropoffDateTime || r.checkinAt   || ''),
      rentalState:     txt(r.rentalState || ''),
      paymentStatus:   txt(r.paymentStatus || '')
    };
    if (vId)  vehicleRentalMap.set(vId, info);
    if (vPlt) vehicleRentalMap.set(vPlt, info);
  }

  // 5. Normalize
  const normalized = vehicles.map(v => {
    const id  = txt(v._id);
    const plt = txt(v.plate).toLowerCase();
    const ar  = vehicleRentalMap.get(id) || vehicleRentalMap.get(plt) || null;
    return {
      fleetVehicleId:       txt(v.fleetVehicleId || id),
      plate:                txt(v.plate),
      model:                txt(v.model),
      vehicleLabel:         txt(v.vehicleLabel || [txt(v.plate), txt(v.model)].filter(Boolean).join(' - ')),
      categoryCode:         txt(v.categoryCode  || v.category?.categoryCode),
      categoryLabel:        txt(v.categoryLabel || v.category?.categoryLabel || v.category?.title),
      status:               txt(v.status),
      operationalStatus:    txt(v.operationalStatus),
      currentStationCode:   txt(v.currentStationCode),
      currentStationLabel:  txt(v.currentStationLabel),
      fuelLevel:            num(v.fuelLevel) || 0,
      fuelType:             txt(v.fuelType),
      mileage:              num(v.mileage)   || 0,
      readyToGo:            bool(v.readyToGo),
      hardHold:             bool(v.hardHold),
      notes:                txt(v.notes),
      activeRental: ar
    };
  });

  // Sort: available first, then out, notready, hold, maintenance
  const priority = v => {
    if (v.hardHold) return 4;
    const st = (v.operationalStatus || v.status || '').toLowerCase();
    if (['service','maintenance','blocked','repair'].some(s => st.includes(s))) return 5;
    if (v.activeRental) return 1;
    if (!v.readyToGo) return 2;
    return 0;
  };
  normalized.sort((a, b) => priority(a) - priority(b));

  const summary = {
    total:       normalized.length,
    available:   normalized.filter(v => !v.hardHold && !v.activeRental && v.readyToGo).length,
    out:         normalized.filter(v => !!v.activeRental).length,
    notReady:    normalized.filter(v => !v.readyToGo && !v.hardHold && !v.activeRental).length,
    hold:        normalized.filter(v => v.hardHold).length,
    maintenance: normalized.filter(v => {
      const st = (v.operationalStatus || v.status || '').toLowerCase();
      return ['service','maintenance','blocked','repair'].some(s => st.includes(s));
    }).length
  };

  return { success: true, vehicles: normalized, summary };
}
