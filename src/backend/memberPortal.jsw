import wixData from 'wix-data';
import { PORTAL_SESSION_TTL_HOURS } from 'backend/siteConfig';
import { currentMember, members as wixMembers } from 'wix-members-backend';
import { sendTelegramCancelNotification, sendTelegramEditNotification, sendTelegramReviewNotification } from 'backend/telegramService.jsw';

function generateToken() {
  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
  let t = '';
  for (let i = 0; i < 48; i++) t += chars.charAt(Math.floor(Math.random() * chars.length));
  return t;
}

async function resolveSession(customerId, sessionToken) {
  if (!customerId || !sessionToken) return null;
  const res = await wixData.query('PortalSessions')
    .eq('customerId', String(customerId))
    .eq('sessionToken', String(sessionToken))
    .limit(1)
    .find({ suppressAuth: true });
  const session = res.items && res.items[0];
  if (!session) return null;
  if (new Date(session.expiresAt) < new Date()) return null;
  return session;
}

function sanitizeBooking(b) {
  return {
    _id: b._id,
    bookingNumber: b.bookingNumber,
    status: b.status,
    pickupDateTime: b.pickupDateTime,
    dropoffDateTime: b.dropoffDateTime,
    pickupLocation: b.pickupLocation,
    dropoffLocation: b.dropoffLocation,
    vehicleName: b.vehicleName || b.categoryName || '',
    categoryId: b.categoryId || '',
    insurance: b.insurance || '',
    extras: b.extras || [],
    basePrice: b.basePrice || 0,
    totalPrice: b.totalPrice || b.finalPrice || 0,
    currency: 'EUR',
    notes: b.notes || '',
    driverName: b.customerName || b.firstName || '',
    driverEmail: b.customerEmail || b.email || '',
    driverPhone: b.customerPhone || b.phone || '',
    driverAge: b.driverAge || null,
    canceledAt: b.canceledAt || null,
    cancelReason: b.cancelReason || '',
    memberRating: b.memberRating || null,
    memberReview: b.memberReview || ''
  };
}

export async function signIn({ email, bookingRef }) {
  if (!email || !bookingRef) return { ok: false, error: 'missing_fields' };

  const normalizedEmail = String(email).trim().toLowerCase();
  const normalizedRef = String(bookingRef).trim().toUpperCase();

  const bookingRes = await wixData.query('BookingsNew')
    .eq('bookingNumber', normalizedRef)
    .limit(1)
    .find({ suppressAuth: true });

  const booking = bookingRes.items && bookingRes.items[0];
  if (!booking) return { ok: false, error: 'not_found' };

  const bookingEmail = String(booking.customerEmail || booking.email || '').trim().toLowerCase();
  if (bookingEmail !== normalizedEmail) return { ok: false, error: 'not_found' };

  const customerId = String(booking.customerId || booking._id);

  let customer = null;
  if (booking.customerId) {
    const custRes = await wixData.query('Customers')
      .eq('_id', String(booking.customerId))
      .limit(1)
      .find({ suppressAuth: true });
    customer = custRes.items && custRes.items[0];
  }

  const token = generateToken();
  const ttl = Number.isFinite(PORTAL_SESSION_TTL_HOURS) ? PORTAL_SESSION_TTL_HOURS : 8;
  const expiresAt = new Date(Date.now() + ttl * 60 * 60 * 1000).toISOString();

  await wixData.insert('PortalSessions', {
    customerId,
    sessionToken: token,
    expiresAt,
    createdAt: new Date().toISOString()
  }, { suppressAuth: true });

  return {
    ok: true,
    customerId,
    sessionToken: token,
    customer: {
      _id: customer ? customer._id : customerId,
      name: (customer ? (customer.name || customer.customerName) : null) || booking.customerName || booking.firstName || '',
      email: (customer ? (customer.email || customer.customerEmail) : null) || normalizedEmail,
      phone: (customer ? (customer.phone || customer.customerPhone) : null) || booking.customerPhone || booking.phone || ''
    }
  };
}

export async function signOut({ customerId, sessionToken }) {
  if (!customerId || !sessionToken) return { ok: true };
  try {
    const res = await wixData.query('PortalSessions')
      .eq('customerId', String(customerId))
      .eq('sessionToken', String(sessionToken))
      .limit(1)
      .find({ suppressAuth: true });
    if (res.items && res.items[0]) {
      await wixData.remove('PortalSessions', res.items[0]._id, { suppressAuth: true });
    }
  } catch (_) {}
  return { ok: true };
}

export async function getCustomerProfile({ customerId, sessionToken }) {
  const session = await resolveSession(customerId, sessionToken);
  if (!session) return { ok: false, error: 'unauthorized' };

  const res = await wixData.query('Customers')
    .eq('_id', String(customerId))
    .limit(1)
    .find({ suppressAuth: true });
  const profile = res.items && res.items[0];
  if (!profile) return { ok: false, error: 'not_found' };

  return {
    ok: true,
    profile: {
      _id: profile._id,
      name: profile.name || profile.customerName || '',
      email: profile.email || profile.customerEmail || '',
      phone: profile.phone || profile.customerPhone || ''
    }
  };
}

export async function getCustomerBookings({ customerId, sessionToken, filter }) {
  const session = await resolveSession(customerId, sessionToken);
  if (!session) return { ok: false, error: 'unauthorized' };

  const now = new Date().toISOString();
  let q = wixData.query('BookingsNew')
    .eq('customerId', String(customerId))
    .descending('_createdDate')
    .limit(100);

  if (filter === 'upcoming') {
    q = q.gt('pickupDateTime', now).ne('status', 'Canceled');
  } else if (filter === 'active') {
    q = q.le('pickupDateTime', now).ge('dropoffDateTime', now).ne('status', 'Canceled');
  } else if (filter === 'past') {
    q = q.lt('dropoffDateTime', now);
  }

  const res = await q.find({ suppressAuth: true });
  return {
    ok: true,
    bookings: (res.items || []).map(sanitizeBooking),
    total: res.totalCount || (res.items || []).length
  };
}

export async function getBookingDetail({ bookingId, customerId, sessionToken }) {
  const session = await resolveSession(customerId, sessionToken);
  if (!session) return { ok: false, error: 'unauthorized' };

  const res = await wixData.query('BookingsNew')
    .eq('_id', String(bookingId))
    .eq('customerId', String(customerId))
    .limit(1)
    .find({ suppressAuth: true });
  const b = res.items && res.items[0];
  if (!b) return { ok: false, error: 'not_found' };

  return { ok: true, booking: sanitizeBooking(b) };
}

export async function updateBooking({ bookingId, changes, customerId, sessionToken }) {
  const session = await resolveSession(customerId, sessionToken);
  if (!session) return { ok: false, error: 'unauthorized' };

  const res = await wixData.query('BookingsNew')
    .eq('_id', String(bookingId))
    .eq('customerId', String(customerId))
    .limit(1)
    .find({ suppressAuth: true });
  const booking = res.items && res.items[0];
  if (!booking) return { ok: false, error: 'not_found' };
  if (booking.status === 'Canceled') return { ok: false, error: 'already_canceled' };
  if (new Date(booking.pickupDateTime) <= new Date()) return { ok: false, error: 'pickup_passed' };

  const allowed = ['pickupDateTime', 'dropoffDateTime', 'pickupLocation', 'dropoffLocation', 'notes'];
  const patch = {};
  for (const key of allowed) {
    if (changes && changes[key] !== undefined) patch[key] = changes[key];
  }
  if (!Object.keys(patch).length) return { ok: false, error: 'no_changes' };

  const updated = await wixData.update('BookingsNew', { ...booking, ...patch }, { suppressAuth: true });
  return { ok: true, booking: sanitizeBooking(updated) };
}

export async function cancelBooking({ bookingId, reason, customerId, sessionToken }) {
  const session = await resolveSession(customerId, sessionToken);
  if (!session) return { ok: false, error: 'unauthorized' };

  const res = await wixData.query('BookingsNew')
    .eq('_id', String(bookingId))
    .eq('customerId', String(customerId))
    .limit(1)
    .find({ suppressAuth: true });
  const booking = res.items && res.items[0];
  if (!booking) return { ok: false, error: 'not_found' };
  if (booking.status === 'Canceled') return { ok: false, error: 'already_canceled' };
  if (new Date(booking.pickupDateTime) <= new Date()) return { ok: false, error: 'pickup_passed' };

  const updated = await wixData.update('BookingsNew', {
    ...booking,
    status: 'Canceled',
    canceledAt: new Date().toISOString(),
    cancelReason: String(reason || '').trim() || 'Customer request'
  }, { suppressAuth: true });

  return { ok: true, booking: sanitizeBooking(updated) };
}

async function memberEmail() {
  const m = await currentMember.getMember({ fieldsets: ['FULL'] });
  if (!m) return null;
  return ((m.contactDetails && m.contactDetails.emails && m.contactDetails.emails[0]) || m.loginEmail || '').toLowerCase().trim() || null;
}

async function ownedBooking(bookingId, email) {
  const res = await wixData.query('BookingsNew').eq('_id', String(bookingId)).limit(1).find({ suppressAuth: true });
  const b = res.items && res.items[0];
  if (!b) return { err: 'not_found' };
  const bEmail = String(b.customerEmail || b.email || '').toLowerCase().trim();
  if (bEmail !== email) return { err: 'unauthorized' };
  return { booking: b };
}

export async function cancelMyBooking({ bookingId, reason }) {
  let email;
  try { email = await memberEmail(); } catch (_) { return { ok: false, error: 'unauthorized' }; }
  if (!email) return { ok: false, error: 'unauthorized' };
  const { booking, err } = await ownedBooking(bookingId, email);
  if (err) return { ok: false, error: err };
  if (booking.status === 'Canceled') return { ok: false, error: 'already_canceled' };
  if (new Date(booking.pickupDateTime) <= new Date()) return { ok: false, error: 'pickup_passed' };
  const updated = await wixData.update('BookingsNew', {
    ...booking,
    status: 'Canceled',
    canceledAt: new Date().toISOString(),
    cancelReason: String(reason || '').trim() || 'Customer request'
  }, { suppressAuth: true });
  const result = sanitizeBooking(updated);
  try { await sendTelegramCancelNotification(result); } catch (_) {}
  return { ok: true, booking: result };
}

export async function updateMyBooking({ bookingId, changes }) {
  let email;
  try { email = await memberEmail(); } catch (_) { return { ok: false, error: 'unauthorized' }; }
  if (!email) return { ok: false, error: 'unauthorized' };
  const { booking, err } = await ownedBooking(bookingId, email);
  if (err) return { ok: false, error: err };
  if (booking.status === 'Canceled') return { ok: false, error: 'already_canceled' };
  if (new Date(booking.dropoffDateTime) <= new Date()) return { ok: false, error: 'booking_passed' };
  const allowed = ['pickupDateTime', 'dropoffDateTime', 'pickupLocation', 'dropoffLocation', 'notes'];
  const patch = {};
  for (const key of allowed) {
    if (changes && changes[key] !== undefined) patch[key] = changes[key];
  }
  if (!Object.keys(patch).length) return { ok: false, error: 'no_changes' };
  if (patch.pickupDateTime || patch.dropoffDateTime) {
    const np = new Date(patch.pickupDateTime || booking.pickupDateTime);
    const nd = new Date(patch.dropoffDateTime || booking.dropoffDateTime);
    if (nd <= np) return { ok: false, error: 'invalid_dates' };
  }
  const updated = await wixData.update('BookingsNew', { ...booking, ...patch }, { suppressAuth: true });
  const result = sanitizeBooking(updated);
  try { await sendTelegramEditNotification(result, patch); } catch (_) {}
  return { ok: true, booking: result };
}

export async function updateMyProfile({ firstName, lastName, phone }) {
  let member;
  try { member = await currentMember.getMember({ fieldsets: ['FULL'] }); } catch (_) { return { ok: false, error: 'unauthorized' }; }
  if (!member) return { ok: false, error: 'unauthorized' };
  const contactDetails = {};
  if (firstName !== undefined) contactDetails.firstName = String(firstName || '').trim();
  if (lastName !== undefined) contactDetails.lastName = String(lastName || '').trim();
  if (phone !== undefined) contactDetails.phones = String(phone || '').trim() ? [String(phone).trim()] : [];
  try {
    await wixMembers.updateMember(member._id, { contactDetails });
    return { ok: true };
  } catch (err) {
    console.warn('updateMyProfile error', err);
    return { ok: false, error: 'update_failed' };
  }
}

export async function getMyBookings(filter) {
  let member;
  try { member = await currentMember.getMember({ fieldsets: ['FULL'] }); } catch (_) { return { ok: false, error: 'unauthorized' }; }
  if (!member) return { ok: false, error: 'unauthorized' };
  const email = ((member.contactDetails && member.contactDetails.emails && member.contactDetails.emails[0]) || member.loginEmail || '').toLowerCase().trim();
  if (!email) return { ok: false, error: 'unauthorized' };
  const now = new Date().toISOString();
  function buildQ(field) {
    let q = wixData.query('BookingsNew').eq(field, email).descending('_createdDate').limit(100);
    if (filter === 'upcoming') q = q.gt('pickupDateTime', now).ne('status', 'Canceled');
    else if (filter === 'past') q = q.lt('dropoffDateTime', now);
    return q.find({ suppressAuth: true });
  }
  const [r1, r2] = await Promise.all([buildQ('customerEmail'), buildQ('email')]);
  const seen = new Set();
  const items = [...(r1.items || []), ...(r2.items || [])]
    .filter(function(b) { if (seen.has(b._id)) return false; seen.add(b._id); return true; })
    .sort(function(a, b) { return new Date(b._createdDate || 0) - new Date(a._createdDate || 0); });
  return { ok: true, bookings: items.map(sanitizeBooking), total: items.length };
}

export async function getMyProfile() {
  let member;
  try { member = await currentMember.getMember({ fieldsets: ['FULL'] }); } catch (_) { return { ok: false, error: 'unauthorized' }; }
  if (!member) return { ok: false, error: 'unauthorized' };
  const d = member.contactDetails || {};
  return {
    ok: true,
    profile: {
      memberId: member._id,
      name: ((d.firstName || '') + ' ' + (d.lastName || '')).trim(),
      firstName: d.firstName || '',
      lastName: d.lastName || '',
      email: (d.emails && d.emails[0]) || member.loginEmail || '',
      phone: (d.phones && d.phones[0]) || ''
    }
  };
}

export async function checkBookingAvailability({ categoryId, pickupDateTime, dropoffDateTime, excludeBookingId }) {
  if (!categoryId) return { ok: true, available: true, conflicts: 0 };
  try {
    const res = await wixData.query('BookingsNew')
      .eq('categoryId', String(categoryId))
      .ne('status', 'Canceled')
      .limit(200)
      .find({ suppressAuth: true });
    const pickup = new Date(pickupDateTime);
    const dropoff = new Date(dropoffDateTime);
    const conflicts = (res.items || []).filter(b => {
      if (excludeBookingId && b._id === String(excludeBookingId)) return false;
      if (b.status === 'Completed') return false;
      return new Date(b.pickupDateTime) < dropoff && new Date(b.dropoffDateTime) > pickup;
    });
    return { ok: true, available: conflicts.length === 0, conflicts: conflicts.length };
  } catch (err) {
    console.warn('checkBookingAvailability error', err);
    return { ok: true, available: true, conflicts: 0 };
  }
}

export async function submitBookingReview({ bookingId, rating, comment }) {
  let email;
  try { email = await memberEmail(); } catch (_) { return { ok: false, error: 'unauthorized' }; }
  if (!email) return { ok: false, error: 'unauthorized' };
  const { booking, err } = await ownedBooking(bookingId, email);
  if (err) return { ok: false, error: err };
  const r = Math.min(5, Math.max(1, Number(rating) || 5));
  const c = String(comment || '').trim();
  try {
    await wixData.update('BookingsNew', { ...booking, memberRating: r, memberReview: c }, { suppressAuth: true });
  } catch (e) { console.warn('submitBookingReview update failed', e); }
  try {
    await wixData.insert('BookingReviews', {
      bookingId: String(bookingId),
      bookingNumber: booking.bookingNumber || '',
      vehicleName: booking.vehicleName || booking.categoryName || '',
      customerEmail: email,
      rating: r,
      comment: c,
      createdAt: new Date().toISOString()
    }, { suppressAuth: true });
  } catch (e) { console.warn('submitBookingReview insert failed (collection may not exist yet)', e); }
  try { await sendTelegramReviewNotification({ booking: sanitizeBooking(booking), rating: r, comment: c }); } catch (_) {}
  return { ok: true };
}

export async function getExtendedProfile() {
  let email;
  try { email = await memberEmail(); } catch (_) { return { ok: false, error: 'unauthorized' }; }
  if (!email) return { ok: false, error: 'unauthorized' };
  const res = await wixData.query('Customers').eq('email', email).limit(1).find({ suppressAuth: true });
  const c = res.items && res.items[0];
  function toDateInput(d) { if (!d) return ''; try { return new Date(d).toISOString().slice(0, 10); } catch (_) { return ''; } }
  return {
    ok: true,
    extended: {
      // Personal
      dateOfBirth: toDateInput(c?.dateOfBirth),
      nationality: c?.nationality || '',
      taxNumber: c?.taxNumber || '',
      // ID document
      idNumber: c?.idNumber || '',
      idIssueCountry: c?.idIssueCountry || '',
      idIssueDate: toDateInput(c?.idIssueDate),
      idExpiry: toDateInput(c?.idExpiry),
      // Driver licence
      licenseNumber: c?.licenseNumber || '',
      licenseCountry: c?.licenseCountry || '',
      licenseIssueDate: toDateInput(c?.licenseIssueDate),
      licenseExpiry: toDateInput(c?.licenseExpiry),
      // Address
      address: c?.address || '',
      city: c?.city || '',
      zipCode: c?.zipCode || '',
      country: c?.country || '',
      // Legacy compat — compute age band from dateOfBirth if available
      driverAge: c?.driverAge || (() => {
        if (!c?.dateOfBirth) return '';
        const age = Math.floor((Date.now() - new Date(c.dateOfBirth)) / 31557600000);
        if (age >= 19 && age <= 22) return '19-22';
        if (age >= 23 && age <= 69) return '23-69';
        if (age >= 70) return '70+';
        return '';
      })()
    }
  };
}

export async function updateExtendedProfile({
  dateOfBirth, nationality, taxNumber,
  idNumber, idIssueCountry, idIssueDate, idExpiry,
  licenseNumber, licenseCountry, licenseIssueDate, licenseExpiry,
  address, city, zipCode, country,
  firstName, lastName, phone
}) {
  let email;
  try { email = await memberEmail(); } catch (_) { return { ok: false, error: 'unauthorized' }; }
  if (!email) return { ok: false, error: 'unauthorized' };
  const res = await wixData.query('Customers').eq('email', email).limit(1).find({ suppressAuth: true });
  const existing = res.items && res.items[0];

  const s = (v) => v !== undefined ? String(v || '').trim() : undefined;
  const d = (v) => { if (v === undefined) return undefined; if (!v) return null; const dt = new Date(v); return isNaN(dt.getTime()) ? null : dt; };

  const patch = {};
  if (dateOfBirth !== undefined) patch.dateOfBirth = d(dateOfBirth);
  if (nationality !== undefined) patch.nationality = s(nationality);
  if (taxNumber !== undefined) patch.taxNumber = s(taxNumber);
  if (idNumber !== undefined) patch.idNumber = s(idNumber);
  if (idIssueCountry !== undefined) patch.idIssueCountry = s(idIssueCountry);
  if (idIssueDate !== undefined) patch.idIssueDate = d(idIssueDate);
  if (idExpiry !== undefined) patch.idExpiry = d(idExpiry);
  if (licenseNumber !== undefined) patch.licenseNumber = s(licenseNumber);
  if (licenseCountry !== undefined) patch.licenseCountry = s(licenseCountry);
  if (licenseIssueDate !== undefined) patch.licenseIssueDate = d(licenseIssueDate);
  if (licenseExpiry !== undefined) patch.licenseExpiry = d(licenseExpiry);
  if (address !== undefined) patch.address = s(address);
  if (city !== undefined) patch.city = s(city);
  if (zipCode !== undefined) patch.zipCode = s(zipCode);
  if (country !== undefined) patch.country = s(country);
  // Keep Customers record in sync with Wix Members names/phone (for backroom)
  if (firstName !== undefined) patch.firstName = s(firstName);
  if (lastName !== undefined) {
    patch.lastName = s(lastName);
    patch.fullName = ((s(firstName) || existing?.firstName || '') + ' ' + s(lastName)).trim();
    patch.Title = patch.fullName || existing?.Title || email;
  }
  if (phone !== undefined) patch.mobilePhone = s(phone);

  try {
    if (existing) {
      await wixData.update('Customers', { ...existing, ...patch }, { suppressAuth: true });
    } else {
      const fn = s(firstName) || '';
      const ln = s(lastName) || '';
      const fullName = (fn + ' ' + ln).trim() || email;
      await wixData.insert('Customers', {
        Title: fullName, email, fullName,
        firstName: fn, lastName: ln,
        mobilePhone: s(phone) || '',
        isActive: true,
        ...patch
      }, { suppressAuth: true });
    }
    return { ok: true };
  } catch (err) {
    console.warn('updateExtendedProfile error', err.message);
    return { ok: false, error: 'update_failed' };
  }
}

// ─── Notifications ────────────────────────────────────────────────────────────
// Requires a Wix CMS collection named "MemberNotifications" with fields:
//   memberId (Text), type (Text), title (Text), body (Text),
//   isRead (Boolean, default false), relatedBookingId (Text, optional)

async function getMemberId() {
  const m = await currentMember.getMember({ fieldsets: ['FULL'] });
  return m ? m._id : null;
}

export async function getMyNotifications() {
  let memberId;
  try { memberId = await getMemberId(); } catch (_) { return { ok: false, error: 'unauthorized' }; }
  if (!memberId) return { ok: false, error: 'unauthorized' };
  try {
    const res = await wixData.query('MemberNotifications')
      .eq('memberId', memberId)
      .descending('_createdDate')
      .limit(50)
      .find({ suppressAuth: true });
    return { ok: true, notifications: res.items || [] };
  } catch (err) {
    console.warn('getMyNotifications error', err.message);
    // Collection may not exist yet — return empty list gracefully
    return { ok: true, notifications: [] };
  }
}

export async function markNotificationRead({ notificationId }) {
  if (!notificationId) return { ok: false };
  let memberId;
  try { memberId = await getMemberId(); } catch (_) { return { ok: false }; }
  if (!memberId) return { ok: false };
  try {
    const res = await wixData.query('MemberNotifications')
      .eq('_id', String(notificationId))
      .eq('memberId', memberId)
      .limit(1)
      .find({ suppressAuth: true });
    const item = res.items && res.items[0];
    if (!item) return { ok: false };
    await wixData.update('MemberNotifications', { ...item, isRead: true }, { suppressAuth: true });
    return { ok: true };
  } catch (err) {
    console.warn('markNotificationRead error', err.message);
    return { ok: false };
  }
}

export async function readAllMyNotifications() {
  let memberId;
  try { memberId = await getMemberId(); } catch (_) { return { ok: false }; }
  if (!memberId) return { ok: false };
  try {
    const res = await wixData.query('MemberNotifications')
      .eq('memberId', memberId)
      .eq('isRead', false)
      .limit(100)
      .find({ suppressAuth: true });
    const updates = (res.items || []).map(item =>
      wixData.update('MemberNotifications', { ...item, isRead: true }, { suppressAuth: true })
    );
    await Promise.all(updates);
    return { ok: true };
  } catch (err) {
    console.warn('readAllMyNotifications error', err.message);
    return { ok: false };
  }
}

export async function deleteMyNotification({ notificationId }) {
  if (!notificationId) return { ok: false };
  let memberId;
  try { memberId = await getMemberId(); } catch (_) { return { ok: false }; }
  if (!memberId) return { ok: false };
  try {
    const res = await wixData.query('MemberNotifications')
      .eq('_id', String(notificationId))
      .eq('memberId', memberId)
      .limit(1)
      .find({ suppressAuth: true });
    if (res.items && res.items[0]) {
      await wixData.remove('MemberNotifications', res.items[0]._id, { suppressAuth: true });
    }
    return { ok: true };
  } catch (err) {
    console.warn('deleteMyNotification error', err.message);
    return { ok: false };
  }
}

// ─── Support Tickets ──────────────────────────────────────────────────────────
// Requires Wix CMS collection "SupportTickets" with fields:
//   memberId (Text), memberEmail (Text), subject (Text),
//   category (Text), status (Text, default "open"),
//   messages (Long Text — JSON array of {sender, text, createdAt}),
//   bookingId (Text, optional)

export async function getMyTickets() {
  let memberId;
  try { memberId = await getMemberId(); } catch (_) { return { ok: false, error: 'unauthorized' }; }
  if (!memberId) return { ok: false, error: 'unauthorized' };
  try {
    const res = await wixData.query('SupportTickets')
      .eq('memberId', memberId)
      .descending('_createdDate')
      .limit(50)
      .find({ suppressAuth: true });
    return { ok: true, tickets: res.items || [] };
  } catch (err) {
    console.warn('getMyTickets error', err.message);
    return { ok: true, tickets: [] };
  }
}

export async function createMyTicket({ subject, category, message, bookingId }) {
  if (!subject || !message) return { ok: false, error: 'missing_fields' };
  let memberId;
  try { memberId = await getMemberId(); } catch (_) { return { ok: false, error: 'unauthorized' }; }
  if (!memberId) return { ok: false, error: 'unauthorized' };
  let mEmail = '';
  try { mEmail = (await memberEmail()) || ''; } catch (_) {}
  const messages = JSON.stringify([{
    sender: 'member',
    text: String(message).trim().slice(0, 2000),
    createdAt: new Date().toISOString()
  }]);
  try {
    await wixData.insert('SupportTickets', {
      memberId,
      memberEmail: mEmail,
      subject: String(subject).trim().slice(0, 200),
      category: String(category || 'general').trim(),
      status: 'open',
      messages,
      bookingId: bookingId ? String(bookingId) : ''
    }, { suppressAuth: true });
    return { ok: true };
  } catch (err) {
    console.warn('createMyTicket error', err.message);
    return { ok: false, error: 'server_error' };
  }
}

export async function replyToMyTicket({ ticketId, message }) {
  if (!ticketId || !message) return { ok: false, error: 'missing_fields' };
  let memberId;
  try { memberId = await getMemberId(); } catch (_) { return { ok: false, error: 'unauthorized' }; }
  if (!memberId) return { ok: false, error: 'unauthorized' };
  try {
    const res = await wixData.query('SupportTickets')
      .eq('_id', String(ticketId))
      .eq('memberId', memberId)
      .limit(1)
      .find({ suppressAuth: true });
    const ticket = res.items && res.items[0];
    if (!ticket) return { ok: false, error: 'not_found' };
    if (ticket.status === 'closed') return { ok: false, error: 'ticket_closed' };
    let msgs = [];
    try { msgs = JSON.parse(ticket.messages || '[]'); } catch (_) {}
    msgs.push({ sender: 'member', text: String(message).trim().slice(0, 2000), createdAt: new Date().toISOString() });
    const updated = await wixData.update('SupportTickets', {
      ...ticket,
      messages: JSON.stringify(msgs),
      status: ticket.status === 'resolved' ? 'open' : ticket.status
    }, { suppressAuth: true });
    return { ok: true, ticket: updated };
  } catch (err) {
    console.warn('replyToMyTicket error', err.message);
    return { ok: false, error: 'server_error' };
  }
}
