// ==========================
// Helpers
// ==========================
async function generateBookingNumber() {
    const year = new Date().getFullYear();

    const results = await wixData.query("BookingsNew")
        .startsWith("bookingNumber", `RNT-${year}-`)
        .descending("_createdDate")
        .limit(1)
        .find({ suppressAuth: true });

    let nextNumber = 1;

    if (results.items.length && results.items[0].bookingNumber) {
        const parts = String(results.items[0].bookingNumber).split("-");
        const lastSeq = Number(parts[2]);
        if (!Number.isNaN(lastSeq)) nextNumber = lastSeq + 1;
    }

    return `RNT-${year}-${String(nextNumber).padStart(4, "0")}`;
}

async function hasOverlap(vehicleId, start, end, excludeBookingId) {
    const res = await wixData.query("BookingsNew")
        .eq("assignedVehicle", vehicleId)
        .ne("status", "Canceled")
        .lt("pickupDateTime", end)      // pickup < newEnd
        .gt("dropoffDateTime", start)   // dropoff > newStart
        .limit(1000)
        .find({ suppressAuth: true });

    const items = res.items || [];
    return items.some(b => b._id !== excludeBookingId);
}

async function getActiveFleetCountByCategoryKeys(categoryKeys = []) {
  const uniqueKeys = [...new Set((categoryKeys || []).map(v => String(v || '').trim()).filter(Boolean))];
  for (const key of uniqueKeys) {
    const res = await wixData.query("FleetNew")
      .eq("active", true)
      .eq("category", key)
      .limit(1000)
      .find({ suppressAuth: true });
    if ((res.items || []).length) return res.items.length;
  }
  return 0;
}

async function countOverlappingBookingsByCategoryKeys(categoryKeys, start, end, excludeBookingId) {
  const uniqueKeys = [...new Set((categoryKeys || []).map(v => String(v || '').trim()).filter(Boolean))];
  const seen = new Set();
  let total = 0;

  for (const key of uniqueKeys) {
    let q = wixData.query("BookingsNew")
      .eq("categoryId", key)
      .ne("status", "Canceled")
      .lt("pickupDateTime", end)
      .gt("dropoffDateTime", start)
      .limit(1000);

    if (excludeBookingId) q = q.ne("_id", excludeBookingId);

    const res = await q.find({ suppressAuth: true });
    for (const item of (res.items || [])) {
      if (seen.has(item._id)) continue;
      seen.add(item._id);
      total += 1;
    }
  }

  return total;
}

const BUSINESS_TIMEZONE = 'Europe/Athens';

function readPart(parts, type) {
  const hit = (parts || []).find(p => p.type === type);
  return hit ? Number(hit.value) : 0;
}

function getTimeZoneOffsetMs(date, timeZone = BUSINESS_TIMEZONE) {
  const dtf = new Intl.DateTimeFormat('en-GB', {
    timeZone,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hourCycle: 'h23'
  });
  const parts = dtf.formatToParts(date);
  const asUtc = Date.UTC(
    readPart(parts, 'year'),
    readPart(parts, 'month') - 1,
    readPart(parts, 'day'),
    readPart(parts, 'hour'),
    readPart(parts, 'minute'),
    readPart(parts, 'second')
  );
  return asUtc - date.getTime();
}

function parseBusinessLocalDateTime(value, timeZone = BUSINESS_TIMEZONE) {
  if (!value && value !== 0) return null;
  if (value instanceof Date) return Number.isNaN(value.getTime()) ? null : value;

  const raw = String(value).trim();
  const match = raw.match(/^(\d{4})-(\d{2})-(\d{2})[T\s](\d{2}):(\d{2})(?::(\d{2}))?$/);
  if (match) {
    const [, yy, mm, dd, hh, mi, ss = '00'] = match;
    const guessUtc = new Date(Date.UTC(Number(yy), Number(mm) - 1, Number(dd), Number(hh), Number(mi), Number(ss)));
    const offsetA = getTimeZoneOffsetMs(guessUtc, timeZone);
    let candidate = new Date(guessUtc.getTime() - offsetA);
    const offsetB = getTimeZoneOffsetMs(candidate, timeZone);
    if (offsetB !== offsetA) candidate = new Date(guessUtc.getTime() - offsetB);
    return Number.isNaN(candidate.getTime()) ? null : candidate;
  }

  const parsed = new Date(raw);
  return Number.isNaN(parsed.getTime()) ? null : parsed;
}

function athensHour(date, timeZone = BUSINESS_TIMEZONE) {
  const dtf = new Intl.DateTimeFormat('en-GB', { timeZone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
  const parts = dtf.formatToParts(date);
  return { hour: readPart(parts, 'hour'), minute: readPart(parts, 'minute') };
}

function isNightShift(date, timeZone = BUSINESS_TIMEZONE) {
  if (!(date instanceof Date) || Number.isNaN(date.getTime())) return false;
  const { hour } = athensHour(date, timeZone);
  return hour < 8 || hour >= 22;
}

function deriveAgeFee(driverAge) {
  const age = String(driverAge || '').trim();
  if (age === '19-22') return 16;
  if (age === '70+') return 10;
  return 0;
}

function toFiniteNumber(value, fallback = 0) {
  const num = Number(value);
  return Number.isFinite(num) ? num : fallback;
}

function cleanText(value) {
  return (value ?? '').toString().trim();
}

// Wix module/messaging boundaries can deliver arrays as plain objects — coerce instead of discarding
function toArrayLike(value) {
  if (Array.isArray(value)) return value;
  if (value && typeof value === 'object') return Object.values(value);
  return [];
}

function normalizeCatalogArrays(catalog) {
  if (!catalog || typeof catalog !== 'object') return catalog;
  return {
    ...catalog,
    pricingSeasons: toArrayLike(catalog.pricingSeasons),
    categoryRateRules: toArrayLike(catalog.categoryRateRules),
    feeRules: toArrayLike(catalog.feeRules),
    pickupLocations: toArrayLike(catalog.pickupLocations)
  };
}

// Inline automatic fees — self-contained. Calling computeAutomaticFees across the
// pricingCatalog module boundary corrupts the feeRules payload in production
// (same failure mode that forced the inline season resolver), which made quotes
// silently fall back to hardcoded amounts (16/15) instead of the admin rules.
function inlineComputeAutomaticFees({ driverAge, pickupDateTime, dropoffDateTime, businessSettings, feeRules }) {
  const rules = toArrayLike(feeRules).filter((rule) => rule && typeof rule === 'object' && rule.active !== false);
  const settings = businessSettings || {};
  const nightStart = toFiniteNumber(settings.nightStartHour, 22);
  const nightEnd = toFiniteNumber(settings.nightEndHour, 8);
  const nightAt = (date) => {
    if (!(date instanceof Date) || Number.isNaN(date.getTime())) return false;
    const { hour } = athensHour(date);
    return nightStart > nightEnd ? (hour >= nightStart || hour < nightEnd) : (hour >= nightStart && hour < nightEnd);
  };
  const typeOf = (rule) => cleanText(rule.ruleType || rule.type);
  const amountOf = (rule, fallback) => {
    const amount = Number(rule?.amount ?? rule?.price);
    return Number.isFinite(amount) ? amount : fallback;
  };
  const ageText = cleanText(driverAge);
  const ageMatches = rules.filter((rule) => typeOf(rule) === 'ageRange' && cleanText(rule.audienceGroup || rule.group) === ageText);
  const ageRule = ageMatches.find((rule) => rule._id) || ageMatches[0] || null;
  const ageFee = ageRule ? amountOf(ageRule, deriveAgeFee(ageText)) : deriveAgeFee(ageText);
  const findNight = (type) => rules.find((rule) => typeOf(rule) === type) || rules.find((rule) => typeOf(rule) === 'night') || null;
  const pickupRule = findNight('nightPickup');
  const dropoffRule = findNight('nightDropoff');
  const pickupNight = nightAt(pickupDateTime) ? (pickupRule ? amountOf(pickupRule, 15) : 15) : 0;
  const dropoffNight = nightAt(dropoffDateTime) ? (dropoffRule ? amountOf(dropoffRule, 15) : 15) : 0;
  return {
    ageFee: Number(Number(ageFee).toFixed(2)),
    nightFee: Number((pickupNight + dropoffNight).toFixed(2)),
    appliedRules: {
      ageRule: ageRule ? { key: ageRule.key || '', label: ageRule.label || ageRule.title || '', amount: Number(ageFee) } : null,
      pickupNight: pickupNight ? { key: pickupRule?.key || 'nightPickup', label: pickupRule?.label || pickupRule?.title || 'Νυχτερινή χρέωση παραλαβής', amount: pickupNight } : null,
      dropoffNight: dropoffNight ? { key: dropoffRule?.key || 'nightDropoff', label: dropoffRule?.label || dropoffRule?.title || 'Νυχτερινή χρέωση επιστροφής', amount: dropoffNight } : null
    }
  };
}

// ==========================
// Inline dynamic pricing resolver (self-contained, no cross-module dependency)
// Digits-only date parsing: immune to format (ISO / D-M-Y), invisible characters and timezones.
// ==========================

function inlineDateParts(value) {
  const digits = String(value ?? '').match(/\d+/g) || [];
  if (digits.length < 3) return null;
  let y, m, d;
  if (digits[0].length === 4) { y = +digits[0]; m = +digits[1]; d = +digits[2]; }
  else if (digits[2].length === 4) { d = +digits[0]; m = +digits[1]; y = +digits[2]; }
  else return null;
  if (!y || !m || !d || m < 1 || m > 12 || d < 1 || d > 31) return null;
  return { y, m, d };
}

function athensDateParts(date) {
  const parts = new Intl.DateTimeFormat('en-GB', { timeZone: BUSINESS_TIMEZONE, year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(date);
  const get = (t) => Number((parts.find((p) => p.type === t) || {}).value || 0);
  return { y: get('year'), m: get('month'), d: get('day') };
}

function inlineSeasonMatches(pickupParts, season) {
  const s = inlineDateParts(season?.startDate || season?.start || season?.fromDate);
  const e = inlineDateParts(season?.endDate || season?.end || season?.toDate);
  if (!s || !e) return false;
  const cv = pickupParts.m * 100 + pickupParts.d;
  const sv = s.m * 100 + s.d;
  const ev = e.m * 100 + e.d;
  const repeat = season?.repeatYearly === true || String(season?.repeatYearly).toLowerCase() === 'true';
  if (repeat) return sv <= ev ? (cv >= sv && cv <= ev) : (cv >= sv || cv <= ev);
  const cFull = pickupParts.y * 10000 + cv;
  const sFull = s.y * 10000 + sv;
  const eFull = e.y * 10000 + ev;
  return cFull >= sFull && cFull <= eFull;
}

function inlineFindSeason(seasons, pickupParts) {
  const rows = toArrayLike(seasons).filter((row) => row && row.active !== false && inlineSeasonMatches(pickupParts, row));
  rows.sort((a, b) => (toFiniteNumber(b?.priority, 0) - toFiniteNumber(a?.priority, 0)) || (toFiniteNumber(a?.sortOrder, 9999) - toFiniteNumber(b?.sortOrder, 9999)));
  return rows[0] || null;
}

function inlineCodesMatch(ruleCode, candidate) {
  const a = cleanText(ruleCode).toUpperCase();
  const b = cleanText(candidate).toUpperCase();
  if (!a || !b) return false;
  return a === b || extractCategoryCode(a) === extractCategoryCode(b);
}

function inlineNormKey(value) {
  return cleanText(value).replace(/[^a-zA-Z0-9]+/g, '_').replace(/^_+|_+$/g, '').toLowerCase();
}

function inlineFindRule(rules, season, candidates, vehicleCategoryId, days) {
  const seasonKey = inlineNormKey(season?.key || '');
  const hits = toArrayLike(rules).filter((rule) => {
    if (!rule || rule.active === false) return false;
    const ruleCode = cleanText(rule.categoryCode || rule.category || '');
    if (candidates.length && ruleCode && !candidates.some((c) => inlineCodesMatch(ruleCode, c))) return false;
    if (!candidates.length && vehicleCategoryId && cleanText(rule.vehicleCategoryId) && cleanText(rule.vehicleCategoryId) !== vehicleCategoryId) return false;
    const min = Math.max(1, Math.floor(toFiniteNumber(rule.minDays, 1)));
    const max = Math.max(0, Math.floor(toFiniteNumber(rule.maxDays, 0)));
    if (days < min) return false;
    if (max > 0 && days > max) return false;
    const ruleSeason = inlineNormKey(rule.seasonKey || '');
    if (seasonKey) return !ruleSeason || ruleSeason === seasonKey;
    return !ruleSeason;
  });
  hits.sort((a, b) => {
    const sa = Number(inlineNormKey(a?.seasonKey || '') === seasonKey && seasonKey !== '');
    const sb = Number(inlineNormKey(b?.seasonKey || '') === seasonKey && seasonKey !== '');
    if (sa !== sb) return sb - sa;
    const minA = Math.max(1, Math.floor(toFiniteNumber(a?.minDays, 1)));
    const minB = Math.max(1, Math.floor(toFiniteNumber(b?.minDays, 1)));
    if (minA !== minB) return minB - minA;
    const maxA = Math.max(0, Math.floor(toFiniteNumber(a?.maxDays, 0))) || 999999;
    const maxB = Math.max(0, Math.floor(toFiniteNumber(b?.maxDays, 0))) || 999999;
    return (maxA - minA) - (maxB - minB);
  });
  return hits[0] || null;
}

function inlineResolveDynamicPricing({ catalog, categoryCandidates = [], vehicleCategoryId = '', billableDays = 1, pickupDateTime = null, fallbackPricePerDay = 0 }) {
  const days = Math.max(1, Math.floor(toFiniteNumber(billableDays, 1)));
  const candidates = toArrayLike(categoryCandidates).map((v) => cleanText(v)).filter(Boolean);
  const pickupOk = pickupDateTime instanceof Date && !Number.isNaN(pickupDateTime.getTime());
  const pickupParts = pickupOk ? athensDateParts(pickupDateTime) : null;
  const season = pickupParts ? inlineFindSeason(catalog?.pricingSeasons, pickupParts) : null;
  const rule = inlineFindRule(catalog?.categoryRateRules, season, candidates, cleanText(vehicleCategoryId), days);
  const pricePerDay = rule ? toFiniteNumber(rule.pricePerDay, fallbackPricePerDay) : toFiniteNumber(fallbackPricePerDay, 0);
  return {
    pricePerDay,
    source: rule ? 'dynamicRule' : 'vehicleBasePrice',
    crossSeason: false,
    season: season ? { key: season.key, label: season.label, startDate: season.startDate, endDate: season.endDate } : null,
    rule: rule ? { key: rule.key, label: rule.label, minDays: rule.minDays, maxDays: rule.maxDays, seasonKey: rule.seasonKey, categoryCode: rule.categoryCode || '', pricePerDay: toFiniteNumber(rule.pricePerDay, 0) } : null
  };
}

function buildVehicleCategoryDisplayName(categoryCode = '', title = '') {
  const code = cleanText(categoryCode).toUpperCase();
  const name = cleanText(title);
  const normalizedName = name.replace(/\s+/g, ' ').trim();
  if (code && normalizedName && new RegExp(`^${code}\\s*-`, 'i').test(normalizedName)) return normalizedName;
  if (code && name) return `${code} - ${name}`;
  return name || code || 'Όχημα';
}

function extractCategoryCode(value) {
  const raw = cleanText(value);
  if (!raw) return '';
  const match = raw.match(/^([A-Za-z0-9]+)\s*-/);
  return cleanText(match ? match[1] : raw).toUpperCase();
}

function normalizeLocationCompare(value) {
  return cleanText(value).toLowerCase();
}

function resolvePickupLocationFee(catalog, value, kind = 'both') {
  const rows = toArrayLike(catalog?.pickupLocations);
  const target = normalizeLocationCompare(value);
  if (!target) return 0;
  const hit = rows.find((item) => {
    const type = cleanText(item?.locationType || 'both').toLowerCase() || 'both';
    if (type !== 'both' && type !== cleanText(kind).toLowerCase()) return false;
    const label = normalizeLocationCompare(item?.label);
    const key = normalizeLocationCompare(item?.key);
    return target === label || target === key;
  });
  return Number(toFiniteNumber(hit?.extraFee, 0).toFixed(2));
}

// ==========================
// Create Booking (PRICE LOCK)
// ==========================


function vehicleCategoryImageUrl(value) {
  const src = value?.src || value?.url || value;
  if (!src) return '';
  const raw = String(src);
  if (/^https?:\/\//i.test(raw)) return raw;
  const match = raw.match(/^wix:image:\/\/v1\/([^\/]+)\//i);
  if (match) return `https://static.wixstatic.com/media/${match[1]}`;
  return raw;
}

function toImageArray(value) {
  if (!value) return [];
  if (Array.isArray(value)) return value.flatMap((item) => toImageArray(item));
  if (typeof value === 'object') {
    const src = vehicleCategoryImageUrl(value?.src || value?.url || value?.image || value?.fileUrl || '');
    if (src) return [src];
    const nested = [value?.images, value?.gallery, value?.photos, value?.items].flatMap((item) => toImageArray(item));
    return nested;
  }
  const url = vehicleCategoryImageUrl(value);
  return url ? [url] : [];
}

function uniqueImageList(values = []) {
  return Array.from(new Set((Array.isArray(values) ? values : []).filter(Boolean))).slice(0, 3);
}

function looksLikeFleetRecordId(value) {
  const s = String(value || '').trim();
  return /^[0-9a-f]{8}-[0-9a-f-]{12,}$/i.test(s) || /^[0-9a-f]{16,}$/i.test(s);
}
function deriveFleetCategoryCode(raw) {
  if (!raw) return '';
  if (typeof raw === 'object') {
    const candidates = [raw.category, raw.Category, raw.code, raw.key, raw.label, raw.title, raw.name, raw.value];
    for (const value of candidates) {
      const resolved = deriveFleetCategoryCode(value);
      if (resolved) return resolved;
    }
    return '';
  }
  const textValue = cleanText(raw);
  if (!textValue || looksLikeFleetRecordId(textValue)) return '';
  const dashPrefix = textValue.match(/^([A-Za-z0-9]{1,10})\s*[-–]/);
  if (dashPrefix) return String(dashPrefix[1]).toUpperCase();
  if (/^[A-Za-z0-9]{1,10}$/.test(textValue)) return textValue.toUpperCase();
  const prefix = textValue.match(/^([A-Za-z0-9]{1,10})\b/);
  return prefix ? String(prefix[1]).toUpperCase() : '';
}

function mapVehicleCategoryCatalogItem(item = {}) {
  const categoryCode = String(
    item.category ||
    item.Category ||
    item.categoryCode ||
    item.CategoryCode ||
    item.code ||
    item.Code ||
    ''
  ).trim();
  const title = String(
    item.title ||
    item.Title ||
    item.name ||
    item.Name ||
    item.displayName ||
    item.DisplayName ||
    item.model ||
    item.Model ||
    item.modelName ||
    item.ModelName ||
    item.vehicleModel ||
    item.VehicleModel ||
    item.representativeModel ||
    item.RepresentativeModel ||
    item.sampleModel ||
    item.SampleModel ||
    item.subtitle ||
    item.Subtitle ||
    item.note ||
    item.Note ||
    ''
  ).trim();
  const photos = uniqueImageList([
    ...toImageArray(item.photos),
    ...toImageArray(item.Photos),
    ...toImageArray(item.images),
    ...toImageArray(item.Images),
    ...toImageArray(item.image),
    ...toImageArray(item.Image),
    ...toImageArray(item.imageUrl),
    ...toImageArray(item.ImageUrl),
    ...toImageArray(item.photo),
    ...toImageArray(item.Photo),
    ...toImageArray(item.gallery),
    ...toImageArray(item.Gallery)
  ]);
  const displayName = buildVehicleCategoryDisplayName(categoryCode, title);
  const rawAc = item.airCondition ?? item.AirCondition ?? item.ac ?? item.AC;
  const acLabel = typeof rawAc === 'string'
    ? (/^(yes|true|1|ναι)$/i.test(rawAc.trim()) ? 'Ναι' : 'Όχι')
    : (rawAc ? 'Ναι' : 'Όχι');
  return {
    id: String(item._id || ''),
    itemType: 'category',
    source: 'vehicles',
    title,
    name: title || categoryCode || 'Όχημα',
    displayName,
    displayTitle: displayName,
    category: categoryCode,
    categoryCode,
    label: categoryCode,
    price: Number(
      item.price ||
      item.Price ||
      item.pricePerDay ||
      item.dailyPrice ||
      item.dayPrice ||
      item.basePrice ||
      item.BasePrice ||
      item.rate ||
      item.Rate ||
      item.priceDay ||
      item.PriceDay ||
      item.price_daily ||
      item.PriceDaily ||
      0
    ) || 0,
    image: photos[0] ? vehicleCategoryImageUrl(photos[0]) : '',
    photos: photos.map((src) => vehicleCategoryImageUrl(src)),
    active: (item.active ?? item.Active ?? true) !== false,
    status: String(item.status || item.Status || '').trim(),
    specs: {
      gearbox: item.transmission || item.Transmission || item.gearbox || item.Gearbox || '-',
      fuel: item.fuelType || item.FuelType || '-',
      seats: item.seats || item.Seats || '-',
      doors: item.doors || item.Doors || '-',
      bags: item.luggage1 || item.luggage || item.Luggage || item.bags || item.Bags || item.luggageBags || '-',
      luggage: item.luggage || item.Luggage || item.bags || item.Bags || item.luggageBags || '-',
      ac: acLabel,
      engineCc: item.engineCc || item.EngineCc || '-'
    }
  };
}

export async function getVehicleCategoriesCatalog() {
  const res = await wixData.query('VehiclesNew')
    .ascending('price')
    .limit(1000)
    .find({ suppressAuth: true });

  return (res.items || [])
    .filter((item) => (item?.active ?? item?.Active ?? true) !== false)
    .map(mapVehicleCategoryCatalogItem);
}


function isVehicleCategoryActive(item = {}) {
  return (item?.active ?? item?.Active ?? true) !== false;
}

async function findVehicleCategoryRecord({ vehicleId, categoryCode } = {}) {
  const id = cleanText(vehicleId || '');
  const code = cleanText(categoryCode || '');

  if (id) {
    try {
      const item = await wixData.get('VehiclesNew', id, { suppressAuth: true });
      if (item && isVehicleCategoryActive(item)) return item;
    } catch (err) {}
  }

  if (code) {
    const res = await wixData.query('VehiclesNew').limit(1000).find({ suppressAuth: true });
    const match = (res.items || []).find((item) => {
      if (!isVehicleCategoryActive(item)) return false;
      const itemCode = cleanText(item.category || item.Category || '');
      return itemCode === code;
    });
    if (match) return match;
  }

  return null;
}

export async function getVehicleCategoryDetails({ vehicleId, categoryCode } = {}) {
  const item = await findVehicleCategoryRecord({ vehicleId, categoryCode });
  if (!item) return null;
  return mapVehicleCategoryCatalogItem(item);
}


function buildFleetSpecs(entry = {}, fallback = {}) {
  return {
    gearbox: entry.transmission || entry.Transmission || entry.gearbox || fallback.gearbox || '-',
    fuel: entry.fuelType || entry.FuelType || entry.fuel || fallback.fuel || '-',
    seats: entry.seats || entry.Seats || fallback.seats || '-',
    doors: entry.doors || entry.Doors || fallback.doors || '-',
    bags: entry.luggage1 || entry.luggage || entry.Luggage || fallback.bags || fallback.luggage || '-',
    luggage: entry.luggage || entry.Luggage || fallback.luggage || fallback.bags || '-',
    ac: (entry.airCondition ?? entry.AirCondition) !== undefined ? ((entry.airCondition || entry.AirCondition) ? 'Ναι' : 'Όχι') : (fallback.ac || '-'),
    engineCc: entry.engineCc || entry.EngineCc || fallback.engineCc || '-'
  };
}

export async function getFleetModelsPreview({ vehicleId, categoryCode } = {}) {
  let resolvedCategoryCode = cleanText(categoryCode || '');
  let vehicleItem = null;
  if (!resolvedCategoryCode || vehicleId) {
    vehicleItem = await findVehicleCategoryRecord({ vehicleId, categoryCode: resolvedCategoryCode || '' });
    if (!resolvedCategoryCode) {
      resolvedCategoryCode = cleanText(vehicleItem?.category || vehicleItem?.Category || '');
    }
  }

  const vehiclesRes = await wixData.query('VehiclesNew').limit(1000).find({ suppressAuth: true }).catch(() => ({ items: [] }));
  const activeVehicleRows = (vehiclesRes.items || []).filter((item) => isVehicleCategoryActive(item));
  const vehicleByCode = new Map();
  const categoryCodeById = new Map();
  for (const row of activeVehicleRows) {
    const code = cleanText(row.category || row.Category || '').toUpperCase()
      || deriveFleetCategoryCode(row.title || row.Title || '');
    if (code && !vehicleByCode.has(code)) vehicleByCode.set(code, row);
    if (row._id && code) categoryCodeById.set(String(row._id), code);
  }
  if (!vehicleItem && resolvedCategoryCode) vehicleItem = vehicleByCode.get(cleanText(resolvedCategoryCode).toUpperCase()) || null;
  const resolveCategoryByRecordId = (raw) => {
    if (!raw) return '';
    const id = typeof raw === 'object' ? String(raw?._id || raw?.id || '') : cleanText(raw);
    return (id && categoryCodeById.get(id)) || '';
  };

  let query = wixData.query('FleetNew').limit(1000);
  try { query = query.include('Category'); } catch (err) {}
  const res = await query.find({ suppressAuth: true });
  const categoryFallbackImage = uniqueImageList([
    ...toImageArray(vehicleItem?.image || vehicleItem?.Image || ''),
    ...toImageArray(vehicleItem?.imageUrl || vehicleItem?.ImageUrl || '')
  ]);
  const categoryLabel = buildVehicleCategoryDisplayName(resolvedCategoryCode, vehicleItem?.title || vehicleItem?.Title || '');

  const grouped = new Map();
  for (const entry of (res.items || [])) {
    const entryCategoryCode =
      deriveFleetCategoryCode(entry?.Category) ||
      deriveFleetCategoryCode(entry?.category) ||
      deriveFleetCategoryCode(entry?.categoryCode) ||
      resolveCategoryByRecordId(entry?.categoryId) ||
      resolveCategoryByRecordId(entry?.Category) ||
      resolveCategoryByRecordId(entry?.category);
    // Strict: when a category is requested, drop entries whose category does
    // not match — including unresolved ones (they used to leak everywhere).
    if (resolvedCategoryCode && entryCategoryCode !== cleanText(resolvedCategoryCode).toUpperCase()) continue;
    const isActive = (entry?.active ?? entry?.Active ?? true) !== false;
    if (!isActive) continue;
    const model = cleanText(entry.model || entry.Model || entry.title || entry.Title || '');
    if (!model) continue;
    const key = model.toLowerCase();
    const matchedVehicle = vehicleByCode.get(entryCategoryCode) || vehicleItem || null;
    const matchedCategoryCode = entryCategoryCode || cleanText(matchedVehicle?.category || matchedVehicle?.Category || resolvedCategoryCode || '');
    const matchedCategoryLabel = buildVehicleCategoryDisplayName(matchedCategoryCode, matchedVehicle?.title || matchedVehicle?.Title || '');
    const slotFront = toImageArray(entry?.photoFront)[0] || '';
    const slotSide  = toImageArray(entry?.photoSide)[0]  || '';
    const slotBack  = toImageArray(entry?.photoBack)[0]  || '';
    const photos = uniqueImageList([
      slotFront, slotSide, slotBack,
      ...toImageArray(entry?.photos),
      ...toImageArray(entry?.Photos),
      ...toImageArray(entry?.gallery),
      ...toImageArray(entry?.Gallery),
      ...toImageArray(entry?.images),
      ...toImageArray(entry?.Images),
      ...toImageArray(entry?.album),
      ...toImageArray(entry?.Album),
      ...toImageArray(entry?.image),
      ...toImageArray(entry?.Image),
      ...toImageArray(entry?.photo),
      ...toImageArray(entry?.Photo),
      ...toImageArray(matchedVehicle?.image),
      ...toImageArray(matchedVehicle?.Image),
      ...categoryFallbackImage
    ]);
    const specs = buildFleetSpecs(entry, mapVehicleCategoryCatalogItem(matchedVehicle || {}).specs || {});
    if (!grouped.has(key)) {
      grouped.set(key, {
        id: String(matchedVehicle?._id || ''),
        vehicleCategoryId: String(matchedVehicle?._id || ''),
        itemType: 'model',
        source: 'fleet',
        model,
        title: model,
        name: model,
        displayName: model,
        displayTitle: model,
        label: matchedCategoryCode,
        category: matchedCategoryCode,
        categoryCode: matchedCategoryCode,
        categoryLabel: matchedCategoryLabel,
        image: photos[0] || '',
        photos,
        photoSlots: { front: slotFront, side: slotSide, back: slotBack },
        note: `Ενδεικτικό μοντέλο${matchedCategoryLabel ? ` · ${matchedCategoryLabel}` : ''}`,
        specs
      });
    } else {
      const current = grouped.get(key);
      current.photos = uniqueImageList([...(current.photos || []), ...photos]);
      if (!current.image && current.photos[0]) current.image = current.photos[0];
      const slots = current.photoSlots || (current.photoSlots = { front:'', side:'', back:'' });
      if (!slots.front && slotFront) slots.front = slotFront;
      if (!slots.side  && slotSide)  slots.side  = slotSide;
      if (!slots.back  && slotBack)  slots.back  = slotBack;
      if (!current.id && matchedVehicle?._id) current.id = String(matchedVehicle._id);
      if (!current.vehicleCategoryId && matchedVehicle?._id) current.vehicleCategoryId = String(matchedVehicle._id);
      if (!current.categoryCode && matchedCategoryCode) current.categoryCode = matchedCategoryCode;
      if (!current.category && matchedCategoryCode) current.category = matchedCategoryCode;
      if (!current.label && matchedCategoryCode) current.label = matchedCategoryCode;
      if (!current.categoryLabel && matchedCategoryLabel) current.categoryLabel = matchedCategoryLabel;
    }
  }

  return {
    category: categoryLabel || resolvedCategoryCode,
    items: Array.from(grouped.values()).sort((a, b) => String(a.model || a.name || '').localeCompare(String(b.model || b.name || ''), 'el'))
  };
}

export async function createBooking(data) {
    try {
        const {
            vehicleId,
            categoryId,
            category,
            pickupDateTime,
            dropoffDateTime,
            customerName,
            phone,
            email,
            selectedPackage,
            selectedExtras,
            driverAge,
            pickuppoint,
            dropoffpoint,
            flightNumber,
            dropoffInfo,
            originCity,
            customerComments,
            customerData,
            billingData,
            source
        } = data || {};

        if (!vehicleId || !categoryId || !pickupDateTime || !dropoffDateTime || !customerName || !email || !phone) {
            return { success: false, message: "Λείπουν υποχρεωτικά πεδία." };
        }

        const pickup = parseBusinessLocalDateTime(pickupDateTime);
        const dropoff = parseBusinessLocalDateTime(dropoffDateTime);
        if (!pickup || !dropoff || Number.isNaN(pickup.getTime()) || Number.isNaN(dropoff.getTime()) || dropoff <= pickup) {
            return { success: false, message: "Μη έγκυρες ημερομηνίες παραλαβής/παράδοσης." };
        }

        let pricingCatalog;
        try {
            pricingCatalog = await getPricingCatalog({ scope: 'all' });
        } catch (e) {
            pricingCatalog = getFallbackCatalogSnapshot();
        }
        pricingCatalog = normalizeCatalogArrays(pricingCatalog);

        const businessSettings = pricingCatalog?.businessSettings || {};
        const allowOverbooking = !!businessSettings?.allowOverbooking;

        const fleetCategoryKeys = [vehicleId, categoryId, category];

        const fleetCount = await getActiveFleetCountByCategoryKeys(fleetCategoryKeys);
        const overlaps = await countOverlappingBookingsByCategoryKeys(fleetCategoryKeys, pickup, dropoff, null);

        // When fleet is not configured (fleetCount=0) fall back to capacity=1 so
        // a second overlapping booking is still blocked even without FleetNew records.
        const effectiveCapacity = fleetCount > 0 ? fleetCount : 1;
        if (!allowOverbooking && overlaps >= effectiveCapacity) {
            return { success: false, message: "Δεν υπάρχει διαθεσιμότητα για τις συγκεκριμένες ημερομηνίες/ώρες." };
        }

        const vehicle = await wixData.get("VehiclesNew", vehicleId, { suppressAuth: true });
        if (!vehicle || !isVehicleCategoryActive(vehicle)) {
            return { success: false, message: "Η κατηγορία οχήματος δεν είναι διαθέσιμη." };
        }

        const rawCategoryId = cleanText(categoryId);
        const rawVehicleId = cleanText(vehicleId);
        const resolvedCategoryCode = extractCategoryCode(
          (rawCategoryId && rawCategoryId !== rawVehicleId ? rawCategoryId : '') ||
          category ||
          vehicle?.category ||
          vehicle?.Category ||
          ''
        );

        const bookingCatalogHasRules = Array.isArray(pricingCatalog?.categoryRateRules) && pricingCatalog.categoryRateRules.length > 0;
        const fallbackBasePricePerDay = bookingCatalogHasRules ? 0 : toFiniteNumber(vehicle.price, 0);
        const graceMinutes = toFiniteNumber(businessSettings?.billingGraceMinutes, 0);
        const { hours, billableDays } = computeBillableDaysDetailed(pickup, dropoff, 1, graceMinutes, BUSINESS_TIMEZONE);

        const insuranceMap = pricingCatalog?.maps?.insurance || {};
        const extrasMap = pricingCatalog?.maps?.extras || {};
        const dynamicPricing = inlineResolveDynamicPricing({
          catalog: pricingCatalog,
          categoryCandidates: [resolvedCategoryCode, cleanText(rawCategoryId && rawCategoryId !== rawVehicleId ? rawCategoryId : ''), cleanText(category), cleanText(vehicle?.category), cleanText(vehicle?.Category), cleanText(vehicle?.categoryCode), cleanText(vehicle?.label), cleanText(vehicle?.title)].filter(Boolean),
          vehicleCategoryId: String(vehicleId),
          billableDays,
          pickupDateTime: pickup,
          fallbackPricePerDay: fallbackBasePricePerDay
        });
        const basePricePerDay = toFiniteNumber(dynamicPricing?.pricePerDay, fallbackBasePricePerDay);

        const pkg = cleanText(selectedPackage || "cdw").toLowerCase();
        // Per-category insurance rate + excess (same resolution as computeQuote so the
        // booked price always matches the quoted price)
        const bookingInsurancePlans = Array.isArray(pricingCatalog?.insurancePlans) ? pricingCatalog.insurancePlans : [];
        const bookingInsurancePlan = bookingInsurancePlans.find(p => p?.key === pkg);
        const bookingCatCode = cleanText(resolvedCategoryCode).toUpperCase();
        const bookingCatInsRate = bookingCatCode && bookingInsurancePlan?.categoryRates && bookingInsurancePlan.categoryRates[bookingCatCode];
        const insuranceExtraPerDay = toFiniteNumber(bookingCatInsRate?.pricePerDay ?? insuranceMap[pkg], 0);
        const insuranceExcess = toFiniteNumber(bookingCatInsRate?.excess ?? bookingInsurancePlan?.excess, 0);

        const extrasInput = Array.isArray(selectedExtras) ? selectedExtras : [];
        const finalExtras = [];
        const extraLabels = [];
        const selectedExtrasDetails = [];
        let computedExtrasTotal = 0;

        for (const rawExtra of extrasInput) {
            const extraKey = cleanText(typeof rawExtra === 'object' ? (rawExtra.key || rawExtra.id || rawExtra.value || rawExtra.label || '') : rawExtra).trim();
            if (!extraKey || finalExtras.includes(extraKey)) continue;
            finalExtras.push(extraKey);

            const extraCfg = extrasMap[extraKey];
            // Mirror computeQuote: an unknown extra key is still priced at €0 (so the booked
            // total stays consistent with the quote) but we surface a warning instead of
            // silently swallowing it.
            if (!extraCfg) console.warn(`createBooking extra:missing:${extraKey} — not found in catalog, priced at €0`);
            const resolvedCfg = extraCfg || {};
            const label = cleanText(typeof rawExtra === 'object' ? (rawExtra.label || rawExtra.name || '') : '') || cleanText(resolvedCfg.label || extraKey);
            const mode = cleanText(typeof rawExtra === 'object' ? (rawExtra.mode || rawExtra.billingMode || '') : '') || cleanText(resolvedCfg.billingMode || resolvedCfg.mode || 'perDay');
            const unitPrice = Number(toFiniteNumber(typeof rawExtra === 'object' ? (rawExtra.pricePerDay ?? rawExtra.price ?? rawExtra.amount) : undefined, toFiniteNumber(resolvedCfg.price, 0)).toFixed(2));
            const qty = Math.max(1, Number(typeof rawExtra === 'object' ? (rawExtra.qty ?? rawExtra.quantity ?? 1) : 1) || 1);
            const lineTotal = Number((mode === 'perBooking' ? unitPrice * qty : unitPrice * qty * billableDays).toFixed(2));

            extraLabels.push(qty > 1 ? `${label || extraKey} ×${qty}` : (label || extraKey));
            selectedExtrasDetails.push({ key: extraKey, label: label || extraKey, mode: mode === 'perBooking' ? 'perBooking' : 'perDay', unitPrice, qty, lineTotal });
            computedExtrasTotal += lineTotal;
        }

        const computedBaseCost = Number((basePricePerDay * billableDays).toFixed(2));
        const computedInsuranceCost = Number((insuranceExtraPerDay * billableDays).toFixed(2));
        const automaticFees = inlineComputeAutomaticFees({
          driverAge,
          pickupDateTime: pickup,
          dropoffDateTime: dropoff,
          businessSettings,
          feeRules: pricingCatalog?.feeRules || []
        });
        // Money fields are server-authoritative: ignore anything the client sends to prevent price tampering.
        const finalAgeFee = Number(toFiniteNumber(automaticFees?.ageFee, deriveAgeFee(driverAge)).toFixed(2));
        const finalNightFee = Number(toFiniteNumber(automaticFees?.nightFee, ((isNightShift(pickup) ? 15 : 0) + (isNightShift(dropoff) ? 15 : 0))).toFixed(2));
        const finalBaseCost = computedBaseCost;
        const finalInsuranceCost = computedInsuranceCost;
        const finalExtrasCost = Number(computedExtrasTotal.toFixed(2));
        const finalPickupLocationFee = Number(resolvePickupLocationFee(pricingCatalog, pickuppoint, 'pickup').toFixed(2));
        const finalDropoffLocationFee = Number(resolvePickupLocationFee(pricingCatalog, dropoffpoint, 'dropoff').toFixed(2));
        const finalLocationFee = Number((finalPickupLocationFee + finalDropoffLocationFee).toFixed(2));
        const totalPrice = Number((finalBaseCost + finalInsuranceCost + finalExtrasCost + finalAgeFee + finalNightFee + finalLocationFee).toFixed(2));
        const vatRateDecimal = toFiniteNumber(businessSettings?.vatRateDecimal, VAT_RATE);
        const netAmount = Number((totalPrice / (1 + vatRateDecimal)).toFixed(2));
        const vatAmount = Number((totalPrice - netAmount).toFixed(2));

        const bookingNumber = await generateBookingNumber();
        const userId = wixUsersBackend.currentUser?.id || null;

        const residenceCity = cleanText(customerData?.city || "");
        const travelCity = cleanText(customerData?.originCity || originCity || data?.originCity || data?.city || "");
        const normalizedMainDriver = {
            ...(customerData || {}),
            fullName: cleanText(customerData?.fullName || customerName),
            phone: cleanText(customerData?.phone || phone),
            email: cleanText(customerData?.email || email),
            address: cleanText(customerData?.address || ""),
            city: residenceCity,
            originCity: travelCity,
            dob: cleanText(customerData?.dob || ""),
            notes: cleanText(customerData?.notes || customerComments || "")
        };

        const normalizedBilling = {
            ...(billingData || {}),
            invoiceType: cleanText(billingData?.invoiceType || ""),
            companyName: cleanText(billingData?.companyName || ""),
            profession: cleanText(billingData?.profession || ""),
            vatNumber: cleanText(billingData?.vatNumber || ""),
            taxOffice: cleanText(billingData?.taxOffice || ""),
            address: cleanText(billingData?.address || ""),
            city: cleanText(billingData?.city || ""),
            zip: cleanText(billingData?.zip || ""),
            country: cleanText(billingData?.country || ""),
            phone: cleanText(billingData?.phone || ""),
            companyEmail: cleanText(billingData?.companyEmail || ""),
            vatInclusive: billingData?.vatInclusive !== false,
            vatRate: toFiniteNumber(billingData?.vatRate, 0.24)
        };

        const booking = {
            bookingNumber,

            vehicleId: String(vehicleId),

categoryId: String(resolvedCategoryCode),
category: cleanText(extractCategoryCode(category) || resolvedCategoryCode),
vehicleCategoryCode: String(resolvedCategoryCode),
vehicleCategoryName: buildVehicleCategoryDisplayName(resolvedCategoryCode, cleanText(vehicle.title || vehicle.Title || '')),
vehicleCategoryTitle: cleanText(vehicle.title || vehicle.Title || ''),
vehicleCategoryImage: vehicleCategoryImageUrl(vehicle.image || vehicle.Image || ''),
vehicleCategorySpecs: mapVehicleCategoryCatalogItem(vehicle).specs,

            pickupDateTime: pickup,
            dropoffDateTime: dropoff,

            customerName: String(customerName),
            phone: String(phone),
            email: String(email),

            selectedPackage: pkg,
            selectedExtras: finalExtras,
            selectedExtrasDetails,
            extras: extraLabels.join(", "),

            driverAge: driverAge ? String(driverAge) : "",
            pickuppoint: pickuppoint ? String(pickuppoint) : "",
            dropoffpoint: dropoffpoint ? String(dropoffpoint) : "",

            durationHours: Number(hours.toFixed(2)),
            billableDays,

            basePricePerDay,
            basePriceSource: String(dynamicPricing?.source || 'vehicleBasePrice'),
            pricingSeasonKey: String(dynamicPricing?.season?.key || ''),
            pricingSeasonLabel: String(dynamicPricing?.season?.label || ''),
            crossSeasonPricing: dynamicPricing?.crossSeason === true,
            pricingRuleKey: String(dynamicPricing?.rule?.key || ''),
            pricingRuleLabel: String(dynamicPricing?.rule?.label || ''),
            insuranceExtraPerDay,
            insuranceExcess,
            baseCost: finalBaseCost,
            insuranceCost: finalInsuranceCost,
            extrasTotal: finalExtrasCost,
            ageFee: finalAgeFee,
            nightFee: finalNightFee,
            pickupLocationFee: finalPickupLocationFee,
            dropoffLocationFee: finalDropoffLocationFee,
            locationFee: finalLocationFee,
            totalPrice,
            netAmount,
            vatAmount,
            vatRate: vatRateDecimal,

            status: "Pending",

            mainDriver: normalizedMainDriver,
            billing: normalizedBilling,
            invoiceType: normalizedBilling.invoiceType,
            companyName: normalizedBilling.companyName,
            profession: normalizedBilling.profession,
            vatNumber: normalizedBilling.vatNumber,
            taxOffice: normalizedBilling.taxOffice,
            billingAddress: normalizedBilling.address,
            billingCity: normalizedBilling.city,
            billingZip: normalizedBilling.zip,
            billingCountry: normalizedBilling.country,
            companyPhone: normalizedBilling.phone,
            companyEmail: normalizedBilling.companyEmail,
            internalMemo: normalizedMainDriver.notes || "",
            pickupComment: flightNumber ? `Flight: ${String(flightNumber)}` : "",
            flightNumber: flightNumber ? String(flightNumber) : "",
            dropoffInfo: dropoffInfo ? String(dropoffInfo) : "",
            city: travelCity,
            customerCity: residenceCity,
            originCity: travelCity,

            memberId: userId || "",
            createdBy: userId,
            source: cleanText(source || data?.channel || "Website"),
            createdAtApp: new Date()
        };

        booking.pricingSnapshot = buildPricingSnapshot({
            catalog: pricingCatalog,
            booking,
            selectedPackage: pkg,
            selectedExtrasDetails,
            charges: {
              rental: finalBaseCost,
              insurance: finalInsuranceCost,
              options: finalExtrasCost,
              ageFee: finalAgeFee,
              nightFee: finalNightFee,
              transport: finalLocationFee,
              gross: totalPrice
            },
            graceMinutes,
            source: 'createBooking'
        });

        const inserted = await wixData.insert("BookingsNew", booking, { suppressAuth: true });
        notifyBookingSubmitted({ memberId: userId || '', email: String(email), bookingNumber: inserted.bookingNumber, bookingId: inserted._id }).catch(() => {});

        // Push booking to the member portal (fire and forget — never blocks booking creation)
        try {
            const [portalUrl, portalSecret] = await Promise.all([
                getSecret('PORTAL_WEBHOOK_URL').catch(() => ''),
                getSecret('PORTAL_WEBHOOK_SECRET').catch(() => ''),
            ]);
            if (portalUrl && portalSecret) {
                wixFetch(`${portalUrl}/api/sync/wix-booking`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Webhook-Secret': portalSecret },
                    body: JSON.stringify({
                        bookingNumber: inserted.bookingNumber,
                        wixId: inserted._id,
                        email: String(email),
                        customerName: String(customerName),
                        customerPhone: String(phone),
                        vehicleName: cleanText(vehicle.title || vehicle.Title || category || ''),
                        categoryId: String(resolvedCategoryCode),
                        pickupDateTime: pickup.toISOString(),
                        dropoffDateTime: dropoff.toISOString(),
                        pickupLocation: pickuppoint ? String(pickuppoint) : '',
                        dropoffLocation: dropoffpoint ? String(dropoffpoint) : '',
                        insurance: pkg,
                        driverAge: driverAge ? String(driverAge) : '',
                        totalPrice,
                        status: 'Pending',
                        notes: normalizedMainDriver.notes || '',
                        extras: selectedExtrasDetails.map(e => ({ name: e.qty > 1 ? `${e.label} ×${e.qty}` : e.label, price: e.lineTotal })),
                    }),
                }).catch(() => {});
            }
        } catch (_) {}

        return { success: true, bookingNumber: inserted.bookingNumber, _id: inserted._id, totalPrice, baseCost: finalBaseCost, insuranceCost: finalInsuranceCost, extrasCost: finalExtrasCost, ageFee: finalAgeFee, nightFee: finalNightFee, locationFee: finalLocationFee };

    } catch (err) {
        return { success: false, message: (err && err.message) ? err.message : String(err) };
    }
}

// ==========================
// Quote: compute price without creating a booking
// ==========================
export async function computeQuote(data) {
    try {
        const { vehicleId, categoryId, category, pickupDateTime, dropoffDateTime, selectedPackage, selectedExtras, driverAge, pickuppoint, dropoffpoint } = data || {};
        if (!vehicleId || !pickupDateTime || !dropoffDateTime) return { success: false, message: 'Missing required fields' };
        const pickup = parseBusinessLocalDateTime(pickupDateTime);
        const dropoff = parseBusinessLocalDateTime(dropoffDateTime);
        if (!pickup || !dropoff || Number.isNaN(pickup.getTime()) || Number.isNaN(dropoff.getTime()) || dropoff <= pickup) return { success: false, message: 'Invalid dates' };
        let pricingCatalog;
        try { pricingCatalog = await getPricingCatalog({ scope: 'all' }); } catch (e) { pricingCatalog = getFallbackCatalogSnapshot(); }
        const rawShapes = {
            seasons: Array.isArray(pricingCatalog?.pricingSeasons) ? `array(${pricingCatalog.pricingSeasons.length})` : typeof pricingCatalog?.pricingSeasons,
            rules: Array.isArray(pricingCatalog?.categoryRateRules) ? `array(${pricingCatalog.categoryRateRules.length})` : typeof pricingCatalog?.categoryRateRules,
            feeRules: Array.isArray(pricingCatalog?.feeRules) ? `array(${pricingCatalog.feeRules.length})` : typeof pricingCatalog?.feeRules
        };
        pricingCatalog = normalizeCatalogArrays(pricingCatalog);
        const vehicle = await wixData.get("VehiclesNew", vehicleId, { suppressAuth: true });
        const catalogHasRules = Array.isArray(pricingCatalog?.categoryRateRules) && pricingCatalog.categoryRateRules.length > 0;
        const fallbackBasePricePerDay = catalogHasRules ? 0 : toFiniteNumber(vehicle?.price, 0);
        const rawCategoryId = cleanText(categoryId);
        const rawVehicleId = cleanText(vehicleId);
        const resolvedCategoryCode = extractCategoryCode((rawCategoryId && rawCategoryId !== rawVehicleId ? rawCategoryId : '') || category || vehicle?.category || vehicle?.Category || '');
        const categoryCandidates = [rawCategoryId && rawCategoryId !== rawVehicleId ? rawCategoryId : '', cleanText(category), cleanText(vehicle?.category), cleanText(vehicle?.Category), cleanText(vehicle?.categoryCode), cleanText(vehicle?.label), cleanText(vehicle?.title)].filter(Boolean);
        const graceMinutes = toFiniteNumber((pricingCatalog?.businessSettings || {}).billingGraceMinutes, 0);
        const { billableDays } = computeBillableDaysDetailed(pickup, dropoff, 1, graceMinutes, BUSINESS_TIMEZONE);
        const insuranceMap = pricingCatalog?.maps?.insurance || {};
        const extrasMap = pricingCatalog?.maps?.extras || {};
        const insurancePlansArr = Array.isArray(pricingCatalog?.insurancePlans) ? pricingCatalog.insurancePlans : [];
        const insurancePlansByKey = {};
        insurancePlansArr.forEach(p => { if (p?.key) insurancePlansByKey[p.key] = p; });
        const dynamicPricing = inlineResolveDynamicPricing({ catalog: pricingCatalog, categoryCandidates: [resolvedCategoryCode, ...categoryCandidates], vehicleCategoryId: String(vehicleId), billableDays, pickupDateTime: pickup, fallbackPricePerDay: fallbackBasePricePerDay });
        let moduleResolverSeasonKey = null;
        try { moduleResolverSeasonKey = resolveDynamicPricingRate({ categoryCode: resolvedCategoryCode, categoryCandidates, vehicleCategoryId: String(vehicleId), billableDays, pickupDateTime: pickup, dropoffDateTime: dropoff, catalog: pricingCatalog, fallbackPricePerDay: fallbackBasePricePerDay })?.season?.key || null; } catch (e) { moduleResolverSeasonKey = `error:${e?.message || e}`; }
        const basePricePerDay = toFiniteNumber(dynamicPricing?.pricePerDay, fallbackBasePricePerDay);
        const pkg = cleanText(selectedPackage || 'cdw').toLowerCase();
        const quoteWarnings = [];
        if (catalogHasRules && dynamicPricing?.source !== 'dynamicRule') quoteWarnings.push('pricing:no-rule-match');
        if (pkg && pkg !== 'none' && pkg !== 'nodw' && !(pkg in insuranceMap)) quoteWarnings.push(`insurance:missing:${pkg}`);
        const insurancePlan = insurancePlansByKey[pkg];
        const catCode = cleanText(resolvedCategoryCode).toUpperCase();
        const catInsRate = catCode && insurancePlan?.categoryRates && insurancePlan.categoryRates[catCode];
        const insuranceExtraPerDay = toFiniteNumber(catInsRate?.pricePerDay ?? insuranceMap[pkg], 0);
        const insuranceExcess = toFiniteNumber(catInsRate?.excess ?? insurancePlan?.excess, 0);
        const extrasInput = Array.isArray(selectedExtras) ? selectedExtras : [];
        let computedExtrasTotal = 0;
        for (const rawExtra of extrasInput) {
            const extraKey = cleanText(typeof rawExtra === 'object' ? (rawExtra.key || rawExtra.id || rawExtra.value || rawExtra.label || '') : rawExtra).trim();
            if (!extraKey) continue;
            const extraCfg = extrasMap[extraKey];
            if (!extraCfg) quoteWarnings.push(`extra:missing:${extraKey}`);
            const resolvedCfg = extraCfg || {};
            const mode = cleanText(typeof rawExtra === 'object' ? (rawExtra.mode || rawExtra.billingMode || '') : '') || cleanText(resolvedCfg.billingMode || resolvedCfg.mode || 'perDay');
            const unitPrice = Number(toFiniteNumber(typeof rawExtra === 'object' ? (rawExtra.pricePerDay ?? rawExtra.price ?? rawExtra.amount) : undefined, toFiniteNumber(resolvedCfg.price, 0)).toFixed(2));
            const qty = Math.max(1, Number(typeof rawExtra === 'object' ? (rawExtra.qty ?? rawExtra.quantity ?? 1) : 1) || 1);
            computedExtrasTotal += Number((mode === 'perBooking' ? unitPrice * qty : unitPrice * qty * billableDays).toFixed(2));
        }
        const businessSettings = pricingCatalog?.businessSettings || {};
        const automaticFees = inlineComputeAutomaticFees({ driverAge, pickupDateTime: pickup, dropoffDateTime: dropoff, businessSettings, feeRules: pricingCatalog?.feeRules || [] });
        const finalAgeFee = Number(toFiniteNumber(automaticFees?.ageFee, deriveAgeFee(driverAge)).toFixed(2));
        const finalNightFee = Number(toFiniteNumber(automaticFees?.nightFee, ((isNightShift(pickup) ? 15 : 0) + (isNightShift(dropoff) ? 15 : 0))).toFixed(2));
        const finalBaseCost = Number((basePricePerDay * billableDays).toFixed(2));
        const finalInsuranceCost = Number((insuranceExtraPerDay * billableDays).toFixed(2));
        const finalExtrasCost = Number(computedExtrasTotal.toFixed(2));
        const finalPickupLocationFee = Number(resolvePickupLocationFee(pricingCatalog, pickuppoint, 'pickup').toFixed(2));
        const finalDropoffLocationFee = Number(resolvePickupLocationFee(pricingCatalog, dropoffpoint, 'dropoff').toFixed(2));
        const finalLocationFee = Number((finalPickupLocationFee + finalDropoffLocationFee).toFixed(2));
        const totalPrice = Number((finalBaseCost + finalInsuranceCost + finalExtrasCost + finalAgeFee + finalNightFee + finalLocationFee).toFixed(2));
        const seasonInfo = dynamicPricing?.season ? { key: dynamicPricing.season.key, label: dynamicPricing.season.label } : null;
        const pickupPartsDbg = athensDateParts(pickup);
        const diagnostics = data?.debug ? {
            engineBuild: 'inline-v4-fees',
            rawShapes,
            moduleResolverSeasonKey,
            categoryCandidates,
            billableDays,
            pickupParsed: pickup.toISOString(),
            pickupAthens: `${pickupPartsDbg.y}-${pickupPartsDbg.m}-${pickupPartsDbg.d}`,
            resolvedSeasonKey: dynamicPricing?.season?.key || null,
            seasons: (pricingCatalog?.pricingSeasons || []).map((s) => ({
                key: s.key,
                startDate: String(s.startDate || ''),
                endDate: String(s.endDate || ''),
                startCodes: Array.from(String(s.startDate || '')).map((ch) => ch.charCodeAt(0)).join(','),
                priority: s.priority,
                repeatYearly: s.repeatYearly === true,
                active: s.active !== false,
                inlineMatch: inlineSeasonMatches(pickupPartsDbg, s)
            })),
            rules: (pricingCatalog?.categoryRateRules || []).map((r) => ({ code: String(r.categoryCode || ''), season: String(r.seasonKey || ''), min: r.minDays, max: r.maxDays, price: r.pricePerDay, active: r.active !== false }))
        } : undefined;
        return { success: true, totalPrice, basePricePerDay, billableDays, baseCost: finalBaseCost, insuranceCost: finalInsuranceCost, insuranceExcess, extrasCost: finalExtrasCost, ageFee: finalAgeFee, nightFee: finalNightFee, locationFee: finalLocationFee, season: seasonInfo, rule: dynamicPricing?.rule || null, warnings: quoteWarnings, ...(diagnostics ? { diagnostics } : {}) };
    } catch (err) {
        return { success: false, message: (err && err.message) ? err.message : String(err) };
    }
}

// ==========================
// Calendar: move/assign + overlap block + audit
// ==========================
export async function applyCalendarChange(change) {
    try {
        const { bookingId, resourceId, start, end } = change || {};
        if (!bookingId) return { success: false, message: "Missing bookingId" };

        const booking = await wixData.get("BookingsNew", bookingId, { suppressAuth: true });
        if (!booking) return { success: false, message: "Booking not found" };

        if (booking.status === "Canceled") {
            return { success: false, message: "Canceled booking cannot be moved" };
        }

        const newStart = start ? new Date(start) : new Date(booking.pickupDateTime);
        const newEnd = end ? new Date(end) : new Date(booking.dropoffDateTime);

        if (Number.isNaN(newStart.getTime()) || Number.isNaN(newEnd.getTime()) || newEnd <= newStart) {
            return { success: false, message: "Invalid dates" };
        }

        const newAssigned = (!resourceId || resourceId === "unassigned") ? null : resourceId;

        // overlap check
        if (newAssigned) {
            const overlap = await hasOverlap(newAssigned, newStart, newEnd, bookingId);
            if (overlap) return { success: false, message: "BOOKING_OVERLAP" };
        }

        const userId = wixUsersBackend.currentUser?.id || null;
        const now = new Date();

        const assignedChanged = String(booking.assignedVehicle || "") !== String(newAssigned || "");

        booking.pickupDateTime = newStart;
        booking.dropoffDateTime = newEnd;
        booking.assignedVehicle = newAssigned;

        booking.scheduleChangedAt = now;
        booking.scheduleChangedBy = userId;

        if (assignedChanged) {
            booking.assignedVehicleChangedAt = now;
            booking.assignedVehicleChangedBy = userId;
        }

        const saved = await wixData.update("BookingsNew", booking, { suppressAuth: true });

        const event = {
            id: saved._id,
            resourceId: saved.assignedVehicle ? saved.assignedVehicle : "unassigned",
            title: (saved.bookingNumber || "") + " - " + (saved.customerName || ""),
            start: saved.pickupDateTime,
            end: saved.dropoffDateTime,
            status: saved.status || "Pending"
        };

        return { success: true, booking: saved, event };

    } catch (err) {
        return { success: false, message: (err && err.message) ? err.message : String(err) };
    }
}
