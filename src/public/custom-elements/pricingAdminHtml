function markDirty() {
  state.bizDirty = true;
  const b = el('bizDirtyBadge');
  if (b) b.style.display = 'inline-flex';
}

function clearDirty() {
  state.bizDirty = false;
  const b = el('bizDirtyBadge');
  if (b) b.style.display = 'none';
}

function renderBizPane() {
  const c = el('bizPaneContent');
  if (!c) return;
  const pane = PANES.find(p=>p.key===state.bizPane) || PANES[0];
  const s = biz();
  c.innerHTML = `<div class="pane-head"><h3>${pane.label}<span class="pane-badge">${pane.short}</span></h3></div><div id="paneFields">${buildPaneFields(pane.key, s)}</div>`;
  clearDirty();
  // Track unsaved changes on any field in the pane
  c.querySelectorAll('input,select,textarea').forEach(inp => {
    inp.addEventListener('input', markDirty, { once: false });
    inp.addEventListener('change', markDirty, { once: false });
  });
  bindPaneEvents(pane.key);
  requestResize();
}

