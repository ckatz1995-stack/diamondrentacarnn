  const ta = (id, val='', ph='', rows=4) => `<textarea id="${id}" rows="${rows}" placeholder="${esc(ph)}">${esc(String(val??''))}</textarea>`;
  const sel = (id, opts, cur='') => `<select id="${id}">${opts.map(([v,l])=>`<option value="${v}"${v==cur?' selected':''}>${l}</option>`).join('')}</select>`;
  const row2 = (...fields) => `<div class="field-row cols-2">${fields.join('')}</div>`;
  const row3 = (...fields) => `<div class="field-row cols-3">${fields.join('')}</div>`;
  const tog = (id, checked, label, hint='') => `<div class="tog-row"><div class="tog-info"><b>${label}</b>${hint?`<small>${hint}</small>`:''}</div><label class="tog"><input type="checkbox" id="${id}"${checked?' checked':''}><span class="tog-bar"></span></label></div>`;
  const num = (id, val, unit='', ph='') => unit
    ? `<div class="num-row"><input id="${id}" type="number" value="${esc(String(val??''))}" placeholder="${ph||'0'}"><span class="num-unit">${unit}</span></div>`
    : `<input id="${id}" type="number" value="${esc(String(val??''))}" placeholder="${ph||'0'}">`;
  const sc = (ico, title, desc, body) => `<div class="sc"><div class="sc-h"><span class="sc-ico">${ico}</span><h4>${title}</h4>${desc?`<span class="sc-desc">${desc}</span>`:''}</div><div class="sc-b">${body}</div></div>`;

