function renderLocationsPane() {
  const locs = (state.snapshot?.pickupLocations||[]).slice().sort((a,b)=>(a.sortOrder||0)-(b.sortOrder||0));
  const rows = locs.map(l=>`<tr>
    <td>${esc(l.label||l.displayTitle||'—')}</td>
    <td>${esc(l.address||'—')}</td>
    <td>${esc(l.stationKey||'default')}</td>
    <td>${esc(l.locationType||'both')}</td>
    <td>${l.extraFee>0?money(l.extraFee,cur()):'—'}</td>
    <td><span class="badge ${l.active!==false?'active':'inactive'}">${l.active!==false?'Active':'Inactive'}</span></td>
    <td class="btns"><button class="btn sm" onclick="editLocation('${esc(l._id||l.key||'')}')">Edit</button>
    <button class="btn sm danger" onclick="deleteLocation('${esc(l._id||l.key||'')}','${esc(l.label||'')}')">Delete</button></td>
  </tr>`).join('') || '<tr><td colspan="7" class="tbl-empty">No locations yet</td></tr>';
  return `<div class="panel-head" style="margin-bottom:10px">
    <h4>Pickup & dropoff locations</h4>
    <button class="btn primary sm" onclick="openAddLocation()">+ Add location</button>
  </div>
  <div class="tbl-wrap"><table><thead><tr><th>Label</th><th>Address</th><th>Station</th><th>Type</th><th>Fee</th><th>Status</th><th>Actions</th></tr></thead>
  <tbody>${rows}</tbody></table></div>`;
}

function bindPaneEvents(key) {
  if (key === 'backupRestore') {
    el('expFullBtn')?.addEventListener('click', () => {
      if (!state.snapshot) return showToast('No snapshot loaded yet', 'error');
      downloadJson(state.snapshot, `snapshot-${dateStr()}.json`);
    });
    el('expCopyBtn')?.addEventListener('click', () => {
      navigator.clipboard?.writeText(JSON.stringify(state.snapshot, null, 2))
        .then(()=>showToast('Copied to clipboard','success'))
        .catch(()=>showToast('Copy failed','error'));
    });
    el('expSettingsBtn')?.addEventListener('click', () => {
      downloadJson(biz(), `business-settings-${dateStr()}.json`);
    });
    el('validateJsonBtn')?.addEventListener('click', () => {
      const raw = el('importJson')?.value||'';
      const res = el('importResult');
      try {
        const p = JSON.parse(raw);
        const keys = Object.keys(p);
        res.style.color='var(--good)';
        res.textContent=`✓ Valid JSON — ${keys.length} top-level keys: ${keys.slice(0,8).join(', ')}`;
      } catch(e) { res.style.color='var(--danger)'; res.textContent=`✗ ${e.message}`; }
    });
    el('importJsonBtn')?.addEventListener('click', () => {
      const raw = el('importJson')?.value||'';
      try {
        const parsed = JSON.parse(raw);
        if (!confirm('Import this backup? All settings will be overwritten.')) return;
        post('importSnapshot', parsed);
      } catch(e) { showToast('Invalid JSON: '+e.message,'error'); }
    });
  }
}

