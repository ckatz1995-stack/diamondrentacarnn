<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
:root{
  --text:#1A0F05;--sub:#6B5744;--muted:#9E8A78;
  --gold:#C09840;--gold2:#A87830;--gold3:#8B6520;
  --gold-border:rgba(160,120,48,.28);
  --line:rgba(0,0,0,.09);--line2:rgba(0,0,0,.14);
  --card:#FFFBF7;--card2:#FAF5EE;--surface:#F4EDE4;
  --good:#15803D;--good-bg:#F0FDF4;
  --danger:#DC2626;--danger-bg:#FEF2F2;
  --warn:#D97706;--info:#2563EB;
  --f:'Inter',system-ui,-apple-system,sans-serif;
  --r:10px;--r-lg:16px;--r-xl:20px;--r-pill:999px;
  --sh:0 1px 4px rgba(0,0,0,.08);
  --sh-lg:0 4px 20px rgba(0,0,0,.1);
  --sh-gold:0 2px 10px rgba(168,120,48,.2);
}
*{box-sizing:border-box;margin:0;padding:0}
body{font:14px/1.5 var(--f);color:var(--text);background:var(--card);padding:12px;min-height:100vh}
a{color:var(--gold2)}
h2{font-size:20px;font-weight:800;letter-spacing:-.02em}
h3{font-size:15px;font-weight:700;letter-spacing:-.01em;color:var(--text)}
h4{font-size:13px;font-weight:700;color:var(--sub)}

/* ── BUTTONS ── */
.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:var(--r-pill);border:1px solid var(--line2);background:#fff;color:var(--text);font:600 13px var(--f);cursor:pointer;transition:.15s;white-space:nowrap;box-shadow:var(--sh)}
.btn:hover{border-color:var(--gold-border);color:var(--gold2)}
.btn.primary{background:linear-gradient(135deg,#C09840,var(--gold2));border-color:transparent;color:#fff;box-shadow:var(--sh-gold)}
.btn.primary:hover{opacity:.92}
.btn.danger{background:#fff;border-color:rgba(220,38,38,.3);color:var(--danger)}
.btn.danger:hover{background:var(--danger-bg)}
.btn.good{background:#fff;border-color:rgba(21,128,61,.3);color:var(--good)}
.btn.good:hover{background:var(--good-bg)}
.btn.sm{padding:5px 11px;font-size:12px}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btns{display:flex;gap:8px;flex-wrap:wrap;align-items:center}

/* ── INPUTS ── */
input,select,textarea{width:100%;padding:8px 11px;border:1px solid var(--line2);border-radius:var(--r);background:#fff;color:var(--text);font:14px var(--f);transition:.15s;outline:none}
input:focus,select:focus,textarea:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(192,152,64,.12)}
textarea{resize:vertical;min-height:80px}
input[type=checkbox]{width:auto;accent-color:var(--gold2)}
input[type=number]{width:100%}
label{display:block;font:600 12px var(--f);color:var(--sub);margin-bottom:4px;letter-spacing:.02em;text-transform:uppercase}
.field-row{display:grid;gap:12px;margin-bottom:14px}
.field-row.cols-2{grid-template-columns:1fr 1fr}
.field-row.cols-3{grid-template-columns:1fr 1fr 1fr}
.field-row.cols-4{grid-template-columns:1fr 1fr 1fr 1fr}
.field-group{display:flex;flex-direction:column;gap:4px}
.check-row{display:flex;align-items:center;gap:8px;padding:8px 0}
.check-row input[type=checkbox]{width:16px;height:16px}
.check-row label{margin:0;text-transform:none;font-size:13px;color:var(--text);cursor:pointer}
.field-sub{font:700 11px var(--f);letter-spacing:.08em;text-transform:uppercase;color:var(--gold2);padding:16px 0 8px;border-bottom:1px solid var(--line);margin-bottom:12px}
.info-box{padding:10px 14px;border-radius:var(--r);background:rgba(37,99,235,.05);border:1px solid rgba(37,99,235,.15);color:#1d4ed8;font-size:13px;line-height:1.5}
.warn-box{padding:10px 14px;border-radius:var(--r);background:rgba(220,38,38,.05);border:1px solid rgba(220,38,38,.18);color:#991b1b;font-size:13px;line-height:1.5}

/* ── NAV ── */
.nav-shell{background:linear-gradient(180deg,#fff,#FAF5EE);border:1px solid var(--line);border-radius:var(--r-xl);padding:12px 14px;margin-bottom:14px;box-shadow:var(--sh);display:grid;gap:8px}
.nav-top{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.nav-badge{display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border-radius:var(--r-pill);background:linear-gradient(135deg,var(--gold2),var(--gold3));color:#fff;font:800 11px var(--f);letter-spacing:.06em;text-transform:uppercase;box-shadow:var(--sh-gold)}
.nav-badge::before{content:"⚙";font-size:11px}
.nav-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.nav-context{font:500 13px var(--f);color:var(--sub)}
.group-rail{display:flex;gap:6px;flex-wrap:wrap;padding:4px 0}
.gpill{padding:7px 14px;border-radius:var(--r-pill);border:1px solid transparent;background:transparent;color:var(--sub);cursor:pointer;font:700 12px var(--f);white-space:nowrap;transition:.15s}
.gpill:hover{color:var(--gold2);background:var(--surface)}
.gpill.active{background:linear-gradient(135deg,#C09840,var(--gold2));border-color:transparent;color:#fff;box-shadow:var(--sh-gold)}
.sub-rail{display:flex;gap:6px;flex-wrap:wrap;padding:2px 0;border-top:1px solid var(--line);margin-top:2px;padding-top:8px}
.spill{padding:6px 13px;border-radius:var(--r-pill);border:1px solid var(--line);background:#fff;color:var(--sub);cursor:pointer;font:600 12px var(--f);white-space:nowrap;transition:.15s;box-shadow:var(--sh)}
.spill:hover{border-color:var(--gold-border);color:var(--gold2)}
.spill.active{background:linear-gradient(135deg,#C09840,var(--gold2));border-color:transparent;color:#fff;box-shadow:var(--sh-gold);font-weight:700}
.fallback-nav{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}
.ftab{padding:6px 12px;border-radius:var(--r-pill);border:1px solid var(--line);background:#fff;color:var(--sub);cursor:pointer;font:600 12px var(--f)}
.ftab.active{background:var(--gold2);color:#fff;border-color:transparent}

/* ── SECTIONS ── */
.section{display:none}
.section.active{display:block}
.panel{background:linear-gradient(145deg,var(--card),var(--card2));border:1px solid var(--line);border-radius:var(--r-xl);padding:18px;box-shadow:var(--sh);margin-bottom:12px}
.panel-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px;flex-wrap:wrap}
.panel-head h3{margin:0}

/* ── OVERVIEW ── */
.hero-band{background:linear-gradient(135deg,#190E03 0%,#2E1A0A 50%,#4C3620 100%);border-radius:var(--r-xl);padding:20px 24px;margin-bottom:12px;color:#fff;box-shadow:var(--sh-lg)}
.hero-band h1{font-size:22px;font-weight:800;letter-spacing:-.02em;margin-bottom:4px}
.hero-band p{color:rgba(255,255,255,.6);font-size:13px;margin-bottom:16px}
.stat-row{display:flex;gap:16px;flex-wrap:wrap}
.stat{text-align:center}
.stat b{display:block;font-size:20px;font-weight:800;color:#fff}
.stat span{font-size:11px;color:rgba(255,255,255,.55);text-transform:uppercase;letter-spacing:.06em}
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;margin-bottom:12px}
.kpi{padding:12px 14px;background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);box-shadow:var(--sh)}
.kpi b{display:block;font-size:20px;font-weight:800;color:var(--gold2);letter-spacing:-.02em}
.kpi span{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.cmd-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;margin-bottom:12px}
.cmd-card{background:#fff;border:1px solid var(--line);border-radius:var(--r-xl);padding:16px;box-shadow:var(--sh);cursor:pointer;transition:.18s;position:relative;overflow:hidden}
.cmd-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.cmd-card:nth-child(1)::before{background:linear-gradient(90deg,#C09840,#E8C86A,#C09840)}
.cmd-card:nth-child(2)::before{background:linear-gradient(90deg,#10B981,#6EE7B7,#10B981)}
.cmd-card:nth-child(3)::before{background:linear-gradient(90deg,#3B82F6,#93C5FD,#3B82F6)}
.cmd-card:nth-child(4)::before{background:linear-gradient(90deg,#8B5CF6,#C4B5FD,#8B5CF6)}
.cmd-card:hover{transform:translateY(-2px);box-shadow:var(--sh-lg);border-color:var(--gold-border)}
.cmd-icon{width:36px;height:36px;border-radius:var(--r);display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:10px}
.cmd-card h4{font-size:14px;font-weight:700;margin-bottom:4px}
.cmd-card p{font-size:12px;color:var(--muted);line-height:1.4;margin-bottom:10px}
.cmd-links{display:flex;gap:6px;flex-wrap:wrap}
.cmd-link{padding:4px 10px;border-radius:var(--r-pill);border:1px solid var(--line);background:var(--surface);color:var(--sub);font:600 11px var(--f);cursor:pointer;transition:.12s}
.cmd-link:hover{border-color:var(--gold-border);color:var(--gold2)}

/* ── BUSINESS ── */
.biz-shell{display:grid;gap:10px}
.area-rail{display:flex;gap:6px;flex-wrap:wrap;padding:4px 0}
.apill{padding:7px 14px;border-radius:var(--r-pill);border:1px solid var(--line);background:#fff;color:var(--sub);cursor:pointer;font:700 12px var(--f);transition:.15s;box-shadow:var(--sh)}
.apill:hover{border-color:var(--gold-border);color:var(--gold2)}
.apill.active{background:linear-gradient(135deg,#C09840,var(--gold2));border-color:transparent;color:#fff;box-shadow:var(--sh-gold)}
.pane-rail{display:flex;gap:6px;flex-wrap:wrap}
.ppill{padding:5px 11px;border-radius:var(--r-pill);border:1px solid var(--line);background:var(--surface);color:var(--sub);cursor:pointer;font:600 11px var(--f);transition:.12s}
.ppill:hover{border-color:var(--gold-border);color:var(--gold2)}
.ppill.active{background:var(--gold2);border-color:transparent;color:#fff}
#bizPaneContent{background:#fff;border:1px solid var(--line);border-radius:var(--r-xl);padding:18px;box-shadow:var(--sh)}
.pane-head{margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--line)}
.pane-head h3{margin-bottom:4px}
.pane-head p{font-size:13px;color:var(--muted)}
.pane-badge{display:inline-block;padding:3px 9px;border-radius:var(--r-pill);background:var(--surface);color:var(--gold2);font:700 10px var(--f);letter-spacing:.06em;text-transform:uppercase;margin-left:8px}

/* ── TABLES ── */
.tbl-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:var(--r-lg);background:#fff;box-shadow:var(--sh)}
table{width:100%;border-collapse:collapse;min-width:500px}
th{padding:10px 12px;text-align:left;font:700 11px var(--f);letter-spacing:.07em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--line);background:var(--surface);white-space:nowrap}
td{padding:9px 12px;border-bottom:1px solid var(--line);font-size:13px;vertical-align:middle}
tr:last-child td{border-bottom:0}
tr:hover td{background:rgba(0,0,0,.02)}
.badge{display:inline-block;padding:2px 8px;border-radius:var(--r-pill);font:600 11px var(--f)}
.badge.active{background:var(--good-bg);color:var(--good)}
.badge.inactive{background:var(--surface);color:var(--muted)}
.badge.warn{background:#FEF3C7;color:#92400E}
.tbl-search{display:flex;align-items:center;gap:8px;margin-bottom:10px}
.tbl-search input{max-width:280px;padding:7px 11px;font-size:13px}
.tbl-empty{padding:32px;text-align:center;color:var(--muted);font-size:13px}

/* ── MODAL ── */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:100;padding:20px;overflow-y:auto}
.modal-overlay.show{display:flex;align-items:flex-start;justify-content:center}
.modal-box{background:#fff;border-radius:var(--r-xl);width:100%;max-width:680px;box-shadow:var(--sh-lg);margin:auto}
.modal-head{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--line)}
.modal-head h3{margin:0;font-size:17px}
.modal-close{background:none;border:none;font-size:20px;cursor:pointer;color:var(--muted);line-height:1;padding:4px}
.modal-body{padding:20px}
.modal-foot{padding:14px 20px;border-top:1px solid var(--line);display:flex;gap:8px;justify-content:flex-end}

/* ── TOAST ── */
.toast{position:fixed;bottom:16px;right:16px;z-index:200;display:flex;flex-direction:column;gap:8px;pointer-events:none}
.toast-item{padding:11px 16px;border-radius:var(--r-lg);font:600 13px var(--f);box-shadow:var(--sh-lg);max-width:340px;animation:toastIn .22s ease}
.toast-item.success{background:var(--good-bg);color:var(--good);border:1px solid rgba(21,128,61,.2)}
.toast-item.error{background:var(--danger-bg);color:var(--danger);border:1px solid rgba(220,38,38,.2)}
.toast-item.info{background:#EFF6FF;color:var(--info);border:1px solid rgba(37,99,235,.2)}
@keyframes toastIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* ── BUSY ── */
.busy-bar{position:fixed;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--gold),var(--gold2),var(--gold));background-size:200%;animation:busyAnim 1.2s linear infinite;display:none;z-index:300}
.busy-bar.show{display:block}
@keyframes busyAnim{0%{background-position:200%}100%{background-position:-200%}}

/* ── PERM MATRIX ── */
.perm-table{width:100%;border-collapse:collapse;font-size:12px;margin-bottom:12px}
.perm-table th,.perm-table td{padding:6px 8px;text-align:center;border:1px solid var(--line)}
.perm-table th:first-child,.perm-table td:first-child{text-align:left;font-weight:600;color:var(--sub)}

/* ── MISC ── */
.section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px;flex-wrap:wrap}
.chip{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:var(--r-pill);border:1px solid var(--line);background:var(--surface);color:var(--sub);font:600 11px var(--f)}
.chip.linked{border-color:rgba(21,128,61,.25);background:var(--good-bg);color:var(--good)}
.monospace{font-family:monospace;font-size:12px}
</style>
</head>
<body>

<div class="busy-bar" id="busyBar"></div>
<div id="navBar"></div>
<div class="fallback-nav" id="fallbackNav">
  <button class="ftab active" data-s="settingsHome">Overview</button>
  <button class="ftab" data-s="business">Business</button>
  <button class="ftab" data-s="fleetCategories">Fleet categories</button>
  <button class="ftab" data-s="fleetVehicles">Fleet vehicles</button>
  <button class="ftab" data-s="dynamicPricing">Dynamic pricing</button>
  <button class="ftab" data-s="insurance">Insurance</button>
  <button class="ftab" data-s="extras">Extras</button>
  <button class="ftab" data-s="fees">Fees</button>
  <button class="ftab" data-s="roles">Roles</button>
  <button class="ftab" data-s="users">Users</button>
  <button class="ftab" data-s="security">Security</button>
  <button class="ftab" data-s="audit">Audit</button>
</div>

<div id="app">
  <section id="s-settingsHome" class="section active">
    <div class="hero-band">
      <h1>Diamond Rent A Car — Admin Settings</h1>
      <p>Manage all company settings, fleet, pricing, and team access from one place.</p>
      <div class="stat-row" id="ovStats"></div>
    </div>
    <div class="kpi-grid" id="ovKpis"></div>
    <div class="cmd-grid" id="ovCmds"></div>
  </section>

  <section id="s-business" class="section">
    <div class="biz-shell">
      <div class="area-rail" id="bizAreaRail"></div>
      <div class="pane-rail" id="bizPaneRail"></div>
      <div id="bizPaneContent"></div>
      <div class="btns" id="bizActions" style="justify-content:flex-end">
        <button class="btn" id="bizResetBtn">Reset defaults</button>
        <button class="btn primary" id="bizSaveBtn">Save settings</button>
      </div>
    </div>
  </section>

  <section id="s-fleetCategories" class="section">
    <div class="section-head">
      <h2>Fleet categories</h2>
      <button class="btn primary" id="addCatBtn">+ Add category</button>
    </div>
    <div class="tbl-search"><input id="catSearch" placeholder="Search categories…" /></div>
    <div class="tbl-wrap"><table id="catTable"><thead><tr>
      <th>Code</th><th>Title</th><th>Price/day</th><th>Seats</th><th>Status</th><th>Actions</th>
    </tr></thead><tbody id="catBody"></tbody></table></div>
  </section>

  <section id="s-fleetVehicles" class="section">
    <div class="section-head">
      <h2>Fleet vehicles</h2>
      <button class="btn primary" id="addVehBtn">+ Add vehicle</button>
    </div>
    <div class="tbl-search"><input id="vehSearch" placeholder="Search vehicles…" /></div>
    <div class="tbl-wrap"><table id="vehTable"><thead><tr>
      <th>Plate</th><th>Model</th><th>Category</th><th>Status</th><th>Actions</th>
    </tr></thead><tbody id="vehBody"></tbody></table></div>
  </section>

  <section id="s-dynamicPricing" class="section">
    <div class="section-head"><h2>Dynamic pricing</h2></div>
    <div class="panel">
      <div class="panel-head">
        <h3>Pricing seasons</h3>
        <button class="btn primary sm" id="addSeasonBtn">+ Add season</button>
      </div>
      <div class="tbl-wrap"><table><thead><tr>
        <th>Label</th><th>Start</th><th>End</th><th>Priority</th><th>Repeat</th><th>Status</th><th>Actions</th>
      </tr></thead><tbody id="seasonsBody"></tbody></table></div>
    </div>
    <div class="panel">
      <div class="panel-head">
        <h3>Rate rules</h3>
        <button class="btn primary sm" id="addRuleBtn">+ Add rule</button>
      </div>
      <div class="tbl-wrap"><table><thead><tr>
        <th>Category</th><th>Season</th><th>Days</th><th>Price/day</th><th>Status</th><th>Actions</th>
      </tr></thead><tbody id="rulesBody"></tbody></table></div>
    </div>
  </section>

  <section id="s-insurance" class="section">
    <div class="section-head">
      <h2>Insurance plans</h2>
      <button class="btn primary" id="addInsBtn">+ Add plan</button>
    </div>
    <div class="tbl-wrap"><table id="insTable"><thead><tr>
      <th>Key</th><th>Title</th><th>Price/day</th><th>Sort</th><th>Status</th><th>Actions</th>
    </tr></thead><tbody id="insBody"></tbody></table></div>
  </section>

  <section id="s-extras" class="section">
    <div class="section-head">
      <h2>Extra services</h2>
      <button class="btn primary" id="addExtraBtn">+ Add service</button>
    </div>
    <div class="tbl-wrap"><table><thead><tr>
      <th>Key</th><th>Title</th><th>Price</th><th>Billing</th><th>Status</th><th>Actions</th>
    </tr></thead><tbody id="extrasBody"></tbody></table></div>
  </section>

  <section id="s-fees" class="section">
    <div class="section-head">
      <h2>Fee rules</h2>
      <button class="btn primary" id="addFeeBtn">+ Add fee</button>
    </div>
    <div class="tbl-wrap"><table><thead><tr>
      <th>Key</th><th>Title</th><th>Amount</th><th>Billing</th><th>Rule type</th><th>Status</th><th>Actions</th>
    </tr></thead><tbody id="feesBody"></tbody></table></div>
  </section>

  <section id="s-roles" class="section">
    <div class="section-head">
      <h2>Roles</h2>
      <button class="btn primary" id="addRoleBtn">+ Add role</button>
    </div>
    <div class="tbl-wrap"><table><thead><tr>
      <th>Key</th><th>Label</th><th>Status</th><th>Actions</th>
    </tr></thead><tbody id="rolesBody"></tbody></table></div>
  </section>

  <section id="s-users" class="section">
    <div class="section-head">
      <h2>Staff users</h2>
      <button class="btn primary" id="addUserBtn">+ Add / invite user</button>
    </div>
    <div id="userStatsBand" class="btns" style="margin-bottom:10px"></div>
    <div class="tbl-search"><input id="userSearch" placeholder="Search users…" /></div>
    <div class="tbl-wrap"><table><thead><tr>
      <th>Email</th><th>Name</th><th>Role</th><th>Status</th><th>Actions</th>
    </tr></thead><tbody id="usersBody"></tbody></table></div>
  </section>

  <section id="s-security" class="section">
    <div class="section-head"><h2>Security</h2></div>
    <div class="panel">
      <div class="panel-head">
        <h3>Active sessions</h3>
        <button class="btn danger sm" id="revokeAllBtn">Revoke all sessions</button>
      </div>
      <div class="tbl-wrap"><table><thead><tr>
        <th>Email</th><th>Created</th><th>Last seen</th><th>Actions</th>
      </tr></thead><tbody id="sessionsBody"></tbody></table></div>
    </div>
    <div class="panel">
      <h3 style="margin-bottom:14px">Password management</h3>
      <div class="field-row cols-2">
        <div class="field-group"><label>Staff email</label><input id="pwEmail" placeholder="staff@example.com" /></div>
        <div class="field-group"><label>New password</label><input id="pwNew" type="password" placeholder="Min 8 characters" /></div>
      </div>
      <div class="check-row"><input type="checkbox" id="pwMustChange" /><label for="pwMustChange">Must change on next login</label></div>
      <div class="btns" style="margin-top:12px">
        <button class="btn primary" id="pwSetBtn">Set password</button>
        <button class="btn" id="pwResetBtn">Send reset email</button>
        <button class="btn" id="inviteBtn">Send invite</button>
      </div>
      <div id="pwResult" style="margin-top:12px;font-size:13px;color:var(--muted)"></div>
    </div>
  </section>

  <section id="s-audit" class="section">
    <div class="section-head"><h2>Change history</h2></div>
    <div class="tbl-wrap"><table><thead><tr>
      <th>Time</th><th>Actor</th><th>Action</th><th>Entity</th><th>Summary</th>
    </tr></thead><tbody id="auditBody"></tbody></table></div>
  </section>
</div>

<div class="modal-overlay" id="modal">
  <div class="modal-box">
    <div class="modal-head">
      <h3 id="modalTitle">Edit</h3>
      <button class="modal-close" id="modalClose">×</button>
    </div>
    <div class="modal-body" id="modalBody"></div>
    <div class="modal-foot">
      <button class="btn danger sm" id="modalDelete" style="margin-right:auto;display:none">Delete</button>
      <button class="btn sm" id="modalCancel">Cancel</button>
      <button class="btn primary sm" id="modalSave">Save</button>
    </div>
  </div>
</div>

<div class="toast" id="toastContainer"></div>
<script>
'use strict';
// ── STATE ─────────────────────────────────────────────────────────────────
const state = {
  section: 'settingsHome',
  bizArea: 'front',
  bizPane: 'frontBrand',
  snapshot: null,
  access: null,
  modal: null,
  busy: false
};

// ── HELPERS ───────────────────────────────────────────────────────────────
const esc = s => String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const money = (n, cur='EUR') => `${cur} ${Number(n||0).toFixed(2)}`;
const fmtDate = s => s ? new Date(s).toLocaleDateString('el-GR') : '—';
const fmtDT = s => s ? new Date(s).toLocaleString('el-GR') : '—';
const slug = s => String(s||'').toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'');
const el = id => document.getElementById(id);
const biz = () => state.snapshot?.businessSettings || {};
const cur = () => biz().currency || 'EUR';

// ── COMMUNICATION ─────────────────────────────────────────────────────────
function post(type, payload={}) {
  window.parent.postMessage({ type, ...payload }, '*');
}

function requestResize() {
  const h = Math.min(7800, Math.max(1200, document.body.scrollHeight + 40));
  post('resize', { height: h });
}

window.addEventListener('message', e => {
  const msg = e.data;
  if (!msg || !msg.type) return;
  switch (msg.type) {
    case 'adminSnapshot':
      state.snapshot = msg.snapshot || {};
      state.access = msg.accessSnapshot || {};
      renderAll();
      break;
    case 'toast':
      showToast(msg.message, msg.tone || 'info');
      break;
    case 'busy':
      setBusy(!!msg.flag);
      break;
    case 'seedPricingResult':
    case 'resetPricingResult': {
      const r = msg.result || {};
      const parts = [];
      if (r.business) parts.push(`Business: ${r.business.saved||r.business.total||0}`);
      if (r.insurance) parts.push(`Insurance: ${r.insurance.total||0}`);
      if (r.extras) parts.push(`Extras: ${r.extras.total||0}`);
      if (r.fees) parts.push(`Fees: ${r.fees.total||0}`);
      showToast(parts.join(' · ') || 'Done', 'success');
      break;
    }
    case 'staffPasswordResult': {
      const r = msg.result || {};
      const res = el('pwResult');
      if (res) res.textContent = r.success ? `✓ Password ${r.mode==='set'?'set':'reset'} for ${r.email}` : '✗ Failed';
      if (res) res.style.color = r.success ? 'var(--good)' : 'var(--danger)';
      break;
    }
    case 'staffInviteResult': {
      const r = msg.result || {};
      showToast(`Invite sent to ${r.email}${r.tempPassword ? ' — temp: '+r.tempPassword : ''}`, 'success');
      break;
    }
    case 'sessionActionResult': {
      const r = msg.result || {};
      showToast(`${r.revoked||0} session(s) revoked`, 'success');
      break;
    }
  }
});

function setBusy(flag) {
  state.busy = flag;
  el('busyBar')?.classList.toggle('show', flag);
  document.querySelectorAll('.btn.primary').forEach(b => { if(!b.dataset.allowBusy) b.disabled = flag; });
}

function showToast(msg, tone='info') {
  const c = el('toastContainer');
  if (!c) return;
  const item = document.createElement('div');
  item.className = `toast-item ${tone}`;
  item.textContent = msg;
  c.appendChild(item);
  setTimeout(() => item.remove(), 4000);
}

// ── NAVIGATION ────────────────────────────────────────────────────────────
const GROUPS = [
  { key:'settingsHome', label:'Overview', subs:[] },
  { key:'business',     label:'Business', subs:[] },
  { key:'operations',   label:'Operations', subs:['fleetCategories','fleetVehicles'] },
  { key:'pricing',      label:'Pricing rules', subs:['dynamicPricing','insurance','extras','fees'] },
  { key:'team',         label:'Team & access', subs:['roles','users','security','audit'] }
];

const SUB_LABELS = {
  fleetCategories:'Fleet categories', fleetVehicles:'Fleet vehicles',
  dynamicPricing:'Dynamic pricing', insurance:'Insurance', extras:'Extras', fees:'Fees',
  roles:'Roles', users:'Users', security:'Security', audit:'Change history'
};

const AREAS = [
  { key:'front',         label:'Front & content' },
  { key:'operations',    label:'Operations & policy' },
  { key:'policies',      label:'Rental policies' },
  { key:'company',       label:'Company & stations' },
  { key:'communications',label:'Notifications' }
];

const PANES = [
  { key:'frontBrand',      area:'front',         label:'Brand identity',        short:'Brand' },
  { key:'vehicleCatalog',  area:'front',         label:'Vehicle catalog',        short:'Catalog' },
  { key:'uiLabels',        area:'front',         label:'UI Labels',              short:'UI Labels' },
  { key:'rentalTerms',     area:'front',         label:'Rental terms',           short:'Rental terms' },
  { key:'insuranceTexts',  area:'front',         label:'Insurance texts',        short:'Insurance texts' },
  { key:'seoPages',        area:'front',         label:'SEO & pages',            short:'SEO' },
  { key:'socialContact',   area:'front',         label:'Social & contact',       short:'Social' },
  { key:'operations',      area:'operations',    label:'Operational defaults',   short:'Operations' },
  { key:'bookingPolicies', area:'operations',    label:'Booking policies',       short:'Booking' },
  { key:'paymentDeposit',  area:'operations',    label:'Payment & deposit',      short:'Payment' },
  { key:'additionalDriver',area:'operations',    label:'Additional driver',      short:'Add. driver' },
  { key:'pricingDefaults', area:'operations',    label:'Pricing surcharges',     short:'Surcharges' },
  { key:'mileagePolicy',   area:'policies',      label:'Mileage policy',         short:'Mileage' },
  { key:'damageExcess',    area:'policies',      label:'Damage excess',          short:'Damage excess' },
  { key:'locations',       area:'company',       label:'Stations & locations',   short:'Stations' },
  { key:'invoicingContract',area:'company',      label:'Invoicing & contract',   short:'Invoicing' },
  { key:'corporateB2B',    area:'company',       label:'Corporate & B2B',        short:'Corporate' },
  { key:'privacyGdpr',     area:'company',       label:'Privacy & GDPR',         short:'Privacy' },
  { key:'integrations',    area:'company',       label:'Integrations & APIs',    short:'Integrations' },
  { key:'backupRestore',   area:'company',       label:'Backup & restore',       short:'Backup' },
  { key:'automation',      area:'communications',label:'Triggered emails',       short:'Triggered emails' },
  { key:'emailTemplates',  area:'communications',label:'Email templates',        short:'Email templates' }
];

function activeGroup() {
  for (const g of GROUPS) {
    if (g.key === state.section) return g;
    if (g.subs.includes(state.section)) return g;
  }
  return GROUPS[0];
}

function canManageStaff() { return !!(state.access?.currentStaff?.canManageStaff || state.access?.currentStaff?.isAdmin); }
function canViewAudit()   { return !!(state.access?.currentStaff?.canViewAudit   || state.access?.currentStaff?.isAdmin); }
function canEditPricing() { return !!(state.access?.currentStaff?.canManageBusinessSettings || state.access?.currentStaff?.isAdmin || state.access?.accessState !== 'ready'); }

function goto(section, opts={}) {
  state.section = section;
  if (opts.bizArea) state.bizArea = opts.bizArea;
  if (opts.bizPane) state.bizPane = opts.bizPane;
  renderNav();
  renderSections();
  requestResize();
}

function renderNav() {
  const nb = el('navBar');
  if (!nb) return;
  const grp = activeGroup();
  const subs = grp.subs.filter(s => {
    if (['roles','users','security'].includes(s) && !canManageStaff()) return false;
    if (s === 'audit' && !canViewAudit()) return false;
    return true;
  });

  let bizRails = '';
  if (state.section === 'business') {
    const areaBtns = AREAS.map(a =>
      `<button class="apill${a.key===state.bizArea?' active':''}" data-area="${a.key}">${a.label}</button>`
    ).join('');
    const paneBtns = PANES.filter(p=>p.area===state.bizArea).map(p =>
      `<button class="ppill${p.key===state.bizPane?' active':''}" data-pane="${p.key}">${p.short}</button>`
    ).join('');
    bizRails = `<div class="area-rail" id="areaRail">${areaBtns}</div><div class="pane-rail" id="paneRail">${paneBtns}</div>`;
  }

  const bizActions = state.section === 'business' ? `
    <button class="btn sm" id="navResetBtn">Reset defaults</button>
    <button class="btn primary sm" id="navSaveBtn">Save settings</button>` : '';

  const saveSection = state.section === 'business' ? `<div class="btns" style="gap:6px">${bizActions}</div>` : '';

  const gpills = GROUPS.map(g => {
    if (g.key === 'team' && !canManageStaff() && !canViewAudit()) return '';
    return `<button class="gpill${g===grp?' active':''}" data-grp="${g.key}">${g.label}</button>`;
  }).join('');

  const spills = subs.length > 1 ? `<div class="sub-rail">${subs.map(s =>
    `<button class="spill${s===state.section?' active':''}" data-s="${s}">${SUB_LABELS[s]||s}</button>`
  ).join('')}</div>` : '';

  nb.innerHTML = `<div class="nav-shell">
    <div class="nav-top">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <span class="nav-badge">Settings</span>
        <span class="nav-context">${grp.label}</span>
      </div>
      ${saveSection}
    </div>
    <div class="group-rail">${gpills}</div>
    ${spills}
    ${bizRails}
  </div>`;

  el('navBar').querySelectorAll('[data-grp]').forEach(b => b.addEventListener('click', () => {
    const g = GROUPS.find(x=>x.key===b.dataset.grp);
    if (!g) return;
    if (g.key === 'business') { goto('business'); renderBizPane(); }
    else if (g.subs.length) goto(g.subs[0]);
    else goto(g.key);
  }));
  el('navBar').querySelectorAll('[data-s]').forEach(b => b.addEventListener('click', () => goto(b.dataset.s)));
  el('navBar').querySelectorAll('[data-area]').forEach(b => b.addEventListener('click', () => {
    state.bizArea = b.dataset.area;
    state.bizPane = PANES.find(p=>p.area===state.bizArea)?.key || state.bizPane;
    renderNav(); renderBizPane();
  }));
  el('navBar').querySelectorAll('[data-pane]').forEach(b => b.addEventListener('click', () => {
    state.bizPane = b.dataset.pane;
    renderNav(); renderBizPane();
  }));

  el('navSaveBtn')?.addEventListener('click', saveBizSettings);
  el('navResetBtn')?.addEventListener('click', () => {
    if (!confirm('Reset all business settings to defaults? This overwrites current data.')) return;
    post('resetPricingDefaults', { target: 'business' });
  });

  const fb = el('fallbackNav');
  if (fb) {
    fb.style.display = nb.querySelector('.nav-shell') ? 'none' : 'flex';
    fb.querySelectorAll('[data-s]').forEach(b => {
      b.classList.toggle('active', b.dataset.s === state.section);
    });
  }
}

function renderSections() {
  document.querySelectorAll('.section').forEach(sec => {
    const key = sec.id.replace('s-','');
    sec.classList.toggle('active', key === state.section);
  });
}

// ── RENDER ALL ────────────────────────────────────────────────────────────
function renderAll() {
  renderNav();
  renderSections();
  renderOverview();
  renderBizPane();
  renderFleetCats();
  renderFleetVehs();
  renderSeasons();
  renderRules();
  renderInsurance();
  renderExtras();
  renderFees();
  renderRoles();
  renderUsers();
  renderSessions();
  renderAudit();
  bindTableSearch();
  bindCrudButtons();
  bindBizActions();
  bindSecurityButtons();
  requestResize();
}

// ── OVERVIEW ──────────────────────────────────────────────────────────────
function renderOverview() {
  const snap = state.snapshot || {};
  const b = snap.businessSettings || {};
  const cats = snap.vehicleCategories || [];
  const vehs = snap.fleetVehicles || [];
  const ins  = snap.insurancePlans || [];
  const exts = snap.extraServices || [];
  const fees = snap.feeRules || [];
  const seas = snap.pricingSeasons || [];
  const rules= snap.categoryRateRules || [];
  const locs = snap.pickupLocations || [];

  const activeCats = cats.filter(x=>x.active!==false).length;
  const activeVehs = vehs.filter(x=>x.active!==false&&x.status!=='inactive').length;

  const stats = el('ovStats');
  if (stats) stats.innerHTML = [
    { v: b.currency||'EUR', l:'Currency' },
    { v: b.vatRate ? b.vatRate+'%' : '—', l:'VAT' },
    { v: (b.nightStartHour??'—')+'–'+(b.nightEndHour??'—')+'h', l:'Night window' },
    { v: b.defaultDeposit ? money(b.defaultDeposit, b.currency) : '—', l:'Deposit' },
    { v: activeVehs, l:'Active vehicles' },
    { v: activeCats, l:'Categories' }
  ].map(s=>`<div class="stat"><b>${esc(String(s.v))}</b><span>${esc(s.l)}</span></div>`).join('');

  const kpis = el('ovKpis');
  if (kpis) kpis.innerHTML = [
    { b: activeVehs,  s:'Active fleet' },
    { b: activeCats,  s:'Vehicle categories' },
    { b: ins.filter(x=>x.active!==false).length, s:'Insurance plans' },
    { b: exts.filter(x=>x.active!==false).length, s:'Extra services' },
    { b: fees.filter(x=>x.active!==false).length, s:'Fee rules' },
    { b: seas.filter(x=>x.active!==false).length, s:'Pricing seasons' },
    { b: rules.filter(x=>x.active!==false).length, s:'Rate rules' },
    { b: locs.filter(x=>x.active!==false).length, s:'Pickup locations' },
    { b: b.minRentalDays&&b.maxRentalDays ? `${b.minRentalDays}–${b.maxRentalDays}d` : '—', s:'Rental day range' },
    { b: b.minDriverAge ? b.minDriverAge+'+' : '—', s:'Min driver age' },
    { b: money(b.defaultDeposit||0, b.currency), s:'Default deposit' },
    { b: (state.access?.users||[]).filter(u=>u.active!==false).length, s:'Staff users' }
  ].map(k=>`<div class="kpi"><b>${esc(String(k.b))}</b><span>${esc(k.s)}</span></div>`).join('');

  const cmds = el('ovCmds');
  if (cmds) cmds.innerHTML = [
    { icon:'🏢', title:'Business settings', desc:'Brand, operations, policies, integrations', links:['Brand','Operations','Policies','Integrations'], area:'front', panes:['frontBrand','operations','mileagePolicy','integrations'] },
    { icon:'🚗', title:'Fleet & operations', desc:'Vehicle categories and individual fleet vehicles', links:['Fleet categories','Fleet vehicles'], sects:['fleetCategories','fleetVehicles'] },
    { icon:'💰', title:'Pricing rules', desc:'Seasons, rate rules, insurance and extra services', links:['Pricing seasons','Rate rules','Insurance','Extras'], sects:['dynamicPricing','dynamicPricing','insurance','extras'] },
    { icon:'👥', title:'Team & access', desc:'Roles, staff users, security and audit log', links:['Roles','Users','Security','Audit'], sects:['roles','users','security','audit'] }
  ].map((c,i) => `<div class="cmd-card" data-cmd="${i}">
    <div class="cmd-icon">${c.icon}</div>
    <h4>${c.title}</h4>
    <p>${c.desc}</p>
    <div class="cmd-links">${c.links.map((l,j)=>`<span class="cmd-link" data-cmd="${i}" data-idx="${j}">${l}</span>`).join('')}</div>
  </div>`).join('');

  const CMDS_DATA = [
    { sects:['business','business','business','business'], panes:['frontBrand','operations','mileagePolicy','integrations'] },
    { sects:['fleetCategories','fleetVehicles'] },
    { sects:['dynamicPricing','dynamicPricing','insurance','extras'] },
    { sects:['roles','users','security','audit'] }
  ];

  cmds.querySelectorAll('.cmd-card').forEach(card => {
    card.addEventListener('click', e => {
      const ci = parseInt(card.dataset.cmd);
      const li = e.target.dataset.idx !== undefined ? parseInt(e.target.dataset.idx) : 0;
      const cd = CMDS_DATA[ci];
      const sec = cd.sects[li] || cd.sects[0];
      const pane = cd.panes?.[li];
      if (sec === 'business') { state.bizPane = pane||'frontBrand'; state.bizArea = PANES.find(p=>p.key===state.bizPane)?.area||'front'; goto('business'); renderBizPane(); }
      else goto(sec);
    });
  });
}

// ── BUSINESS PANES ────────────────────────────────────────────────────────
function renderBizPane() {
  const c = el('bizPaneContent');
  if (!c) return;
  const pane = PANES.find(p=>p.key===state.bizPane) || PANES[0];
  const s = biz();
  c.innerHTML = `<div class="pane-head"><h3>${pane.label}<span class="pane-badge">${pane.short}</span></h3></div><div id="paneFields">${buildPaneFields(pane.key, s)}</div>`;
  bindPaneEvents(pane.key);
  requestResize();
}

function buildPaneFields(key, s) {
  const f = (label, input) => `<div class="field-group"><label>${label}</label>${input}</div>`;
  const inp = (id, val='', type='text', ph='') => `<input id="${id}" type="${type}" value="${esc(val)}" placeholder="${esc(ph)}">`;
  const ta = (id, val='', ph='') => `<textarea id="${id}" placeholder="${esc(ph)}">${esc(val)}</textarea>`;
  const sel = (id, opts, cur='') => `<select id="${id}">${opts.map(([v,l])=>`<option value="${v}"${v==cur?' selected':''}>${l}</option>`).join('')}</select>`;
  const chk = (id, checked, label) => `<div class="check-row"><input type="checkbox" id="${id}"${checked?' checked':''}><label for="${id}">${label}</label></div>`;
  const row2 = (...fields) => `<div class="field-row cols-2">${fields.join('')}</div>`;
  const row3 = (...fields) => `<div class="field-row cols-3">${fields.join('')}</div>`;
  const sub = txt => `<div class="field-sub">${txt}</div>`;

  switch(key) {
    case 'frontBrand': return `
      ${row2(f('Company name',inp('bsCompanyName',s.companyName,'text','Diamond Rent A Car')),f('Tagline',inp('bsCompanyTagline',s.companyTagline,'text','Drive in style')))}
      ${row2(f('City',inp('bsCompanyCity',s.companyCity)),f('Address',inp('bsCompanyAddress',s.companyAddress)))}
      ${row2(f('Phone',inp('bsCompanyPhone',s.companyPhone,'tel','+30...')),f('Email',inp('bsCompanyEmail',s.companyEmail,'email','info@..')))}
      ${f('Footer note',ta('bsFooterNote',s.footerNote,'Short company footer text...'))}`;

    case 'vehicleCatalog': return `
      ${row2(
        f('Vehicles page display mode',sel('bsVehiclesPageDisplayMode',[['models','By models'],['categories','By category']],s.vehiclesPageDisplayMode)),
        f('Models source',sel('bsVehiclesPageModelsSource',[['vehicles','Fleet vehicles'],['fleet','Fleet catalog']],s.vehiclesPageModelsSource))
      )}
      <div class="info-box">Controls how the public vehicle catalog is displayed to customers.</div>`;

    case 'uiLabels': return `
      ${sub('Booking flow labels')}
      ${row3(f('Daily rate',inp('bsDailyRateLabel',s.dailyRateLabel,'text','Daily rate')),f('Days',inp('bsDaysLabel',s.daysLabel,'text','Days')),f('Booking summary',inp('bsBookingSummaryLabel',s.bookingSummaryLabel,'text','Booking summary')))}
      ${sub('Price breakdown labels')}
      ${row3(f('Base charge',inp('bsBaseChargeLabel',s.baseChargeLabel)),f('Insurance',inp('bsInsuranceLabel',s.insuranceLabel)),f('Extras',inp('bsExtrasLabel',s.extrasLabel)))}
      ${row3(f('Location fee',inp('bsLocationFeeLabel',s.locationFeeLabel)),f('Age fee',inp('bsAgeFeeLabel',s.ageFeeLabel)),f('Night fee',inp('bsNightFeeLabel',s.nightFeeLabel)))}
      ${row2(f('Grand total',inp('bsGrandTotalLabel',s.grandTotalLabel)),f('No extras selected',inp('bsNoExtrasLabel',s.noExtrasLabel)))}`;

    case 'rentalTerms': return `
      ${row2(f('Page title',inp('bsRentalTermsTitle',s.rentalTermsTitle,'text','Rental terms')),f('',''))}
      ${f('Intro',ta('bsRentalTermsIntro',s.rentalTermsIntro,'Short introduction paragraph...'))}
      ${f('Rental terms body',ta('bsRentalTermsBody',s.rentalTermsBody,'Full rental terms text...'))}
      ${f('Driver requirements & guarantee',ta('bsRentalRequirementsBody',s.rentalRequirementsBody))}
      ${f('Policies (fuel, cancellations, delays)',ta('bsRentalPoliciesBody',s.rentalPoliciesBody))}
      ${f('Privacy & other terms',ta('bsRentalPrivacyBody',s.rentalPrivacyBody))}`;

    case 'insuranceTexts': return `
      ${sub('Insurance terms')}
      ${row2(f('Terms page title',inp('bsInsuranceTermsTitle',s.insuranceTermsTitle)),f('Terms intro',inp('bsInsuranceTermsIntro',s.insuranceTermsIntro)))}
      ${f('Terms body',ta('bsInsuranceTermsBody',s.insuranceTermsBody))}
      ${sub('Insurance details')}
      ${row2(f('Details page title',inp('bsInsuranceDetailsTitle',s.insuranceDetailsTitle)),f('Details intro',inp('bsInsuranceDetailsIntro',s.insuranceDetailsIntro)))}
      ${f('Details body',ta('bsInsuranceDetailsBody',s.insuranceDetailsBody))}`;

    case 'seoPages': return `
      ${sub('Homepage')}
      ${row2(f('Title',inp('bsSeoHomeTitle',s.seoHomeTitle)),f('Meta description',inp('bsSeoHomeDescription',s.seoHomeDescription)))}
      ${sub('Vehicles page')}
      ${row2(f('Title',inp('bsSeoVehiclesTitle',s.seoVehiclesTitle)),f('Meta description',inp('bsSeoVehiclesDescription',s.seoVehiclesDescription)))}
      ${sub('Analytics')}
      ${row2(f('Google Analytics 4 ID',inp('bsGa4Id',s.ga4Id,'text','G-XXXXXXXXXX')),f('Google Tag Manager ID',inp('bsGtmId',s.gtmId,'text','GTM-XXXXXXX')))}`;

    case 'socialContact': return `
      ${row2(f('Facebook URL',inp('bsFacebookUrl',s.facebookUrl,'url','https://facebook.com/...')),f('Instagram URL',inp('bsInstagramUrl',s.instagramUrl,'url','https://instagram.com/...')))}
      ${row2(f('WhatsApp number',inp('bsWhatsappNumber',s.whatsappNumber,'tel','+30 69...')),f('Google Maps URL',inp('bsGoogleMapsUrl',s.googleMapsUrl,'url','https://maps.google.com/...')))}
      ${f('TripAdvisor URL',inp('bsTripAdvisorUrl',s.tripAdvisorUrl,'url','https://tripadvisor.com/...'))}`;

    case 'operations': return `
      ${row3(
        f('Currency',sel('bsCurrency',[['EUR','EUR (€)'],['USD','USD ($)'],['GBP','GBP (£)'],['CHF','CHF']],s.currency||'EUR')),
        f('VAT rate %',inp('bsVatRate',s.vatRate,'number','24')),
        f('Default deposit €',inp('bsDefaultDeposit',s.defaultDeposit,'number','0'))
      )}
