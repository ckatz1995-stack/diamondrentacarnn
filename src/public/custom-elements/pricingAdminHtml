function openRoleModal(id='') {
  const item = id ? (state.access?.roles||[]).find(x=>x._id===id)||{} : {};
  const perms = item.permissions||{};
  const MODULES = ['bookings','rentals','customers','pricing','fleet','reports','financials'];
  const ACTIONS = ['view','insert','edit','delete'];
  const SPECIALS = ['cancelBooking','cancelRental','voidInvoice','manageStaff','manageBusinessSettings','overridePricing','approveManualOverride','viewChangeHistory'];
  const moduleMatrix = `<div style="overflow-x:auto"><table class="perm-table"><thead><tr><th>Module</th>${ACTIONS.map(a=>`<th style="text-transform:capitalize">${a}</th>`).join('')}</tr></thead><tbody>
    ${MODULES.map(m=>`<tr><td style="text-transform:capitalize">${m}</td>${ACTIONS.map(a=>`<td><input type="checkbox" id="m_p_${m}_${a}" ${perms[m]?.includes(a)||item.isAdmin?'checked':''}></td>`).join('')}</tr>`).join('')}
    </tbody></table></div>`;
  const specialGrid = `<div style="display:grid;grid-template-columns:1fr 1fr;gap:4px 12px">
    ${SPECIALS.map(s=>`<div class="check-row"><input type="checkbox" id="m_sp_${s}" ${(item.specialPermissions||[]).includes(s)||item.isAdmin?'checked':''}><label for="m_sp_${s}">${s}</label></div>`).join('')}
    </div>`;
  const body =
    msec('👤','Role',
      mr2(mfld('Label *',minp('label',item.label,'text','Manager')),
          mfld('Key *',minp('key',item.key,'text','manager'),'Auto-filled from the label'))
      + mtog('active',item.active!==false,'Active','Inactive roles cannot be assigned')
      + (item.isAdmin?'<div class="info-box" style="margin-top:8px">This is the built-in admin role — it always has every permission.</div>':''))
    + msec('🧩','Module permissions', moduleMatrix, 'view · insert · edit · delete')
    + msec('⭐','Special permissions', specialGrid);
  openModal(id?'Edit role':'Add role', body, () => {
    if (!mv('key')) return merr('key','Role key is required');
    if (!mv('label')) return merr('label','Role label is required');
    const permissions = {};
    MODULES.forEach(m=>{ const acts=ACTIONS.filter(a=>el(`m_p_${m}_${a}`)?.checked); if(acts.length) permissions[m]=acts; });
    const specialPermissions = SPECIALS.filter(s=>el(`m_sp_${s}`)?.checked);
    post('upsertStaffRole',{ _id:id||undefined, key:slug(mv('key')), label:mv('label'), active:mc('active'), permissions, specialPermissions });
