  renderNav();
  renderSections();
  bindAddButtons();
  bindFallback();
  bindBizActions();
  bindCrudButtons();
  bindSecurityButtons();

  // Show loading state until snapshot arrives
  el('ovKpis').innerHTML = '<div class="tbl-empty" style="grid-column:1/-1">Connecting to backend — waiting for data…</div>';

  post('pricingAdminReady', {});
  requestResize();
}

init();
