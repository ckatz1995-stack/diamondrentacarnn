          mfld('Category code *',minp('category',item.category,'text','ECO'),'Short uppercase code'))
      + mfld('Description',mta('description',item.description,'Shown on the vehicle selection page')))
    + msec('⚙️','Specifications',
      mr3(mfld('Price / day',mnum('price',item.price,cur())),
          mfld('Seats',minp('seats',item.seats,'text','5')),
          mfld('Doors',minp('doors',item.doors,'text','4')))
      + mr3(mfld('Luggage',minp('luggage',item.luggage,'text','2')),
            mfld('Transmission',msel('transmission',[['manual','Manual'],['automatic','Automatic'],['cvt','CVT']],item.transmission)),
            mfld('Fuel type',msel('fuelType',[['petrol','Petrol'],['diesel','Diesel'],['hybrid','Hybrid'],['electric','Electric']],item.fuelType)))
      + mtog('airCondition',item.airCondition,'Air conditioning','Vehicle has working A/C'))
