  }, null, { eyebrow:'Access', subtitle:id?'Update this staff member’s details':'Invite a new staff member to the backroom', saveLabel:id?'Save user':'Send invite' });
}

function _locationFieldLabelsBody(item) {
  item = item || {};
  return msec('🏷','Booking form labels',
      mr2(mfld('Pickup info label',minp('pickupInfoLabel',item.pickupInfoLabel||'','text','e.g. Pickup at airport')),
          mfld('Pickup info placeholder',minp('pickupInfoPlaceholder',item.pickupInfoPlaceholder||'','text','e.g. Terminal 2')))
      + mr2(mfld('Dropoff info label',minp('dropoffInfoLabel',item.dropoffInfoLabel||'','text','e.g. Dropoff location')),
            mfld('Dropoff info placeholder',minp('dropoffInfoPlaceholder',item.dropoffInfoPlaceholder||'','text','e.g. Hotel name'))),
      'Custom prompts shown in the booking form')
    + msec('✈️','Origin field',
      mtog('showOriginField',!!(item.showOriginField),'Show origin field','Ask for a flight number, hotel name, etc.')
      + mr2(mfld('Origin field label',minp('originFieldLabel',item.originFieldLabel||'','text','e.g. Flight number')),
            mfld('Origin field placeholder',minp('originFieldPlaceholder',item.originFieldPlaceholder||'','text','e.g. A3 123'))));
}

function _locationPayload(extra) {
  extra = extra || {};
  const base = { label:mv('label'), key:slug(mv('key')||mv('label')), address:mv('address'),
    stationKey:mv('stationKey','default'), locationType:mv('locationType','both'), extraFee:mn('extraFee'),
    mapUrl:mv('mapUrl'), sortOrder:mn('sortOrder'), active:mc('active'), publicVisible:mc('publicVisible'),
    pickupInfoLabel:mv('pickupInfoLabel'), pickupInfoPlaceholder:mv('pickupInfoPlaceholder'),
    dropoffInfoLabel:mv('dropoffInfoLabel'), dropoffInfoPlaceholder:mv('dropoffInfoPlaceholder'),
    showOriginField:mc('showOriginField'), originFieldLabel:mv('originFieldLabel'), originFieldPlaceholder:mv('originFieldPlaceholder') };
  return Object.assign({}, extra, base);
}

function _locationCoreBody(item) {
  item = item || {};
  return msec('📍','Location',
      mr2(mfld('Label *',minp('label',item.label||'','text','Thessaloniki Airport')),
          mfld('Key (slug)',minp('key',item.key||'','text','thessaloniki_airport'),'Auto-filled from the label'))
      + mfld('Address *',minp('address',item.address||'','text','Full street address'))
      + mfld('Google Maps URL',minp('mapUrl',item.mapUrl||'','url','https://maps.google.com/...'),'Optional — adds a map link in the booking flow'))
    + msec('⚙️','Settings',
      mr3(mfld('Station key',minp('stationKey',item.stationKey||'default','text','default'),'Groups locations into hubs'),
          mfld('Location type',msel('locationType',[['both','Pickup & dropoff'],['pickup','Pickup only'],['dropoff','Dropoff only']],item.locationType||'both')),
          mfld('Extra fee',mnum('extraFee',item.extraFee,cur())))
      + mfld('Sort order',mnum('sortOrder',item.sortOrder,'','0'),'Lower numbers appear first')
      + mtog('active',item.active!==false,'Active','Inactive locations are hidden from booking')
      + mtog('publicVisible',item.publicVisible!==false,'Public visible','Show during booking'));
}

function openAddLocation() {
  const body = _locationCoreBody({}) + _locationFieldLabelsBody();
  openModal('Add pickup location', body, () => {
    if (!mv('label')) return merr('label','Location label is required');
    if (!mv('address')) return merr('address','Address is required');
    post('upsertPickupLocation', _locationPayload());
    closeModal(); renderPickupLocations();
  }, null, { eyebrow:'Fleet', subtitle:'Pickup / dropoff point shown in the booking flow', saveLabel:'Create location' });
  wireAutoSlug('label','key');
}

function openEditLocation(id) {
  const item = (state.snapshot?.pickupLocations||[]).find(function(x){return x._id===id||x.key===id;})||{};
  const body = _locationCoreBody(item) + _locationFieldLabelsBody(item);
  openModal('Edit pickup location', body, () => {
    if (!mv('label')) return merr('label','Location label is required');
    if (!mv('address')) return merr('address','Address is required');
    post('upsertPickupLocation', _locationPayload({_id:item._id}));
    closeModal(); renderPickupLocations();
  }, () => {
    if (confirm('Delete location "'+item.label+'"?')) { post('deletePickupLocation',{itemId:item._id,itemKey:item.key}); closeModal(); renderPickupLocations(); }
  }, { eyebrow:'Fleet', subtitle:'Pickup / dropoff point shown in the booking flow', saveLabel:'Save location' });
}

function editLocation(id) { return openEditLocation(id); }

// ── SECURITY BUTTONS ──────────────────────────────────────────────────────
function bindSecurityButtons() {
  el('pwToggleBtn')?.addEventListener('click', () => {
    const inp = el('pwNew'), btn = el('pwToggleBtn');
    if (!inp) return;
    const show = inp.type === 'password';
    inp.type = show ? 'text' : 'password';
    btn.textContent = show ? 'Hide' : 'Show';
  });
  el('revokeAllBtn')?.addEventListener('click', () => {
    if (!confirm('Revoke ALL active sessions? All staff will be logged out.')) return;
    (state.access?.sessionRows||[]).forEach(r => post('revokeStaffSessions',{email:r.email||r.actorEmail}));
  });
  el('pwSetBtn')?.addEventListener('click', () => {
    const emailEl = el('pwEmail');
    const email = emailEl?.value?.trim();
    const pw = el('pwNew')?.value?.trim();
    if (!email) { emailEl?.focus(); return showToast('Enter a staff email','error'); }
    if (!reEmail.test(email)) { emailEl?.focus(); return showToast('Enter a valid email address','error'); }
    if (!pw||pw.length<8) { el('pwNew')?.focus(); return showToast('Password must be at least 8 characters','error'); }
    if (!confirm(`Set password for ${email}?`)) return;
    post('setStaffPassword',{email,newPassword:pw,mustChangePassword:!!el('pwMustChange')?.checked});
  });
  el('pwResetBtn')?.addEventListener('click', () => {
    const emailEl = el('pwEmail');
    const email = emailEl?.value?.trim();
    if (!email) { emailEl?.focus(); return showToast('Enter a staff email','error'); }
    if (!reEmail.test(email)) { emailEl?.focus(); return showToast('Enter a valid email address','error'); }
    if (!confirm(`Send password reset email to ${email}?`)) return;
    post('resetStaffPassword',{email});
  });
  el('inviteBtn')?.addEventListener('click', () => {
    const emailEl = el('pwEmail');
    const email = emailEl?.value?.trim();
    if (!email) { emailEl?.focus(); return showToast('Enter a staff email','error'); }
    if (!reEmail.test(email)) { emailEl?.focus(); return showToast('Enter a valid email address','error'); }
    if (!confirm(`Send invite to ${email}?`)) return;
    post('inviteStaffUser', { email, fullName: '', roleKey: '' });
  });
}

