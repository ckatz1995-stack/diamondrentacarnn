function exportTable(kind) {
  const def = EXPORTS[kind];
  if (!def) return;
  const rows = (def.src()||[]);
  if (!rows.length) return showToast('Nothing to export yet', 'error');
  downloadBlob(toCSV(def.cols, rows), `${def.name}-${dateStr()}.csv`, 'text/csv');
  showToast(`Exported ${rows.length} ${rows.length===1?'row':'rows'}`, 'success');
}

function dateStr() { return new Date().toISOString().slice(0,10); }

