function openRoleModal(id='') {
  const item = id ? (state.access?.roles||[]).find(x=>x._id===id)||{} : {};
  const perms = item.permissions||{};
  const MODULES = ['bookings','rentals','customers','pricing','fleet','reports','financials'];
  const ACTIONS = ['view','insert','edit','delete'];
  const SPECIALS = ['cancelBooking','cancelRental','voidInvoice','manageStaff','manageBusinessSettings','overridePricing','approveManualOverride','viewChangeHistory'];
  const matrix = `<div class="field-sub">Module permissions</div>
    <div style="overflow-x:auto"><table class="perm-table"><thead><tr><th>Module</th>${ACTIONS.map(a=>`<th>${a}</th>`).join('')}</tr></thead><tbody>
    ${MODULES.map(m=>`<tr><td>${m}</td>${ACTIONS.map(a=>`<td><input type="checkbox" id="m_p_${m}_${a}" ${perms[m]?.includes(a)||item.isAdmin?'checked':''}></td>`).join('')}</tr>`).join('')}
    </tbody></table></div>
    <div class="field-sub">Special permissions</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px 12px">
    ${SPECIALS.map(s=>`<div class="check-row"><input type="checkbox" id="m_sp_${s}" ${(item.specialPermissions||[]).includes(s)||item.isAdmin?'checked':''}><label for="m_sp_${s}">${s}</label></div>`).join('')}
    </div>`;
  const body = mr2(mfld('Key *',minp('key',item.key,'text','manager')),mfld('Label *',minp('label',item.label,'text','Manager')))
    + mchk('active',item.active!==false,'Active') + matrix;
  openModal(id?'Edit role':'Add role', body, () => {
    if (!mv('key')||!mv('label')) return showToast('Key and label required','error');
    const permissions = {};
    MODULES.forEach(m=>{ const acts=ACTIONS.filter(a=>el(`m_p_${m}_${a}`)?.checked); if(acts.length) permissions[m]=acts; });
    const specialPermissions = SPECIALS.filter(s=>el(`m_sp_${s}`)?.checked);
    post('upsertStaffRole',{ _id:id||undefined, key:slug(mv('key')), label:mv('label'), active:mc('active'), permissions, specialPermissions });
    closeModal();
  });
}

function openUserModal(id='') {
  const item = id ? (state.access?.users||[]).find(x=>x._id===id)||{} : {};
  const roles = (state.access?.roles||[]);
  const roleOpts = roles.map(r=>[r.key,r.label]);
  const body = mr2(mfld('Full name *',minp('fullName',item.fullName)),mfld('Email *',minp('email',item.email,'email')))
    + mr3(mfld('Role',msel('roleKey',roleOpts,item.roleKey||roles[0]?.key||'')),mfld('Job title',minp('jobTitle',item.jobTitle,'text','Manager')),mfld('Phone',minp('phone',item.phone,'tel','+30 69...')))
    + mr3(mfld('Start date',minp('startDate',item.startDate?.slice(0,10),'date')),mfld('Emergency contact name',minp('emergencyName',item.emergencyName)),mfld('Emergency contact phone',minp('emergencyPhone',item.emergencyPhone,'tel')))
    + mfld('Notes',mta('notes',item.notes))
    + mchk('active',item.active!==false,'Active');
  openModal(id?'Edit staff user':'Add / invite staff user', body, () => {
    if (!mv('fullName')||!mv('email')) return showToast('Name and email required','error');
    const payload = { _id:id||undefined, fullName:mv('fullName'), email:mv('email'), roleKey:mv('roleKey'),
      jobTitle:mv('jobTitle'), phone:mv('phone'), startDate:mv('startDate'), emergencyName:mv('emergencyName'),
      emergencyPhone:mv('emergencyPhone'), notes:mv('notes'), active:mc('active') };
    if (id) post('upsertStaffUser', payload);
    else post('inviteStaffUser', payload);
    closeModal();
  });
}

function _locationFieldLabelsBody(item) {
  item = item || {};
  return '<div class="field-sub">Display labels</div>'
    + mr2(mfld('Pickup info label',minp('pickupInfoLabel',item.pickupInfoLabel||'','text','e.g. Pickup at airport')),mfld('Pickup info placeholder',minp('pickupInfoPlaceholder',item.pickupInfoPlaceholder||'','text','e.g. Terminal 2')))
    + mr2(mfld('Dropoff info label',minp('dropoffInfoLabel',item.dropoffInfoLabel||'','text','e.g. Dropoff location')),mfld('Dropoff info placeholder',minp('dropoffInfoPlaceholder',item.dropoffInfoPlaceholder||'','text','e.g. Hotel name')))
    + '<div class="field-sub">Origin field</div>'
    + mchk('showOriginField',!!(item.showOriginField),'Show origin field (e.g. flight number, hotel name)')
    + mr2(mfld('Origin field label',minp('originFieldLabel',item.originFieldLabel||'','text','e.g. Flight number')),mfld('Origin field placeholder',minp('originFieldPlaceholder',item.originFieldPlaceholder||'','text','e.g. A3 123')));
}

function _locationPayload(extra) {
  extra = extra || {};
  const base = { label:mv('label'), key:slug(mv('key')||mv('label')), address:mv('address'),
    stationKey:mv('stationKey','default'), locationType:mv('locationType','both'), extraFee:mn('extraFee'),
    mapUrl:mv('mapUrl'), sortOrder:mn('sortOrder'), active:mc('active'), publicVisible:mc('publicVisible'),
    pickupInfoLabel:mv('pickupInfoLabel'), pickupInfoPlaceholder:mv('pickupInfoPlaceholder'),
    dropoffInfoLabel:mv('dropoffInfoLabel'), dropoffInfoPlaceholder:mv('dropoffInfoPlaceholder'),
    showOriginField:mc('showOriginField'), originFieldLabel:mv('originFieldLabel'), originFieldPlaceholder:mv('originFieldPlaceholder') };
  return Object.assign({}, extra, base);
}

function openAddLocation() {
  const body = mr2(mfld('Label *',minp('label','','text','Thessaloniki Airport')),mfld('Key (slug)',minp('key','','text','thessaloniki_airport')))
    + mfld('Address *',minp('address'))
    + mr3(mfld('Station key',minp('stationKey','default')),mfld('Location type',msel('locationType',[['both','Pickup & dropoff'],['pickup','Pickup only'],['dropoff','Dropoff only']],'both')),mfld('Extra fee €',minp('extraFee','','number','0')))
    + mfld('Google Maps URL',minp('mapUrl','','url','https://maps.google.com/...'))
    + mr2(mfld('Sort order',minp('sortOrder','','number','0')),mfld('',mchk('active',true,'Active')+mchk('publicVisible',true,'Public visible')))
    + _locationFieldLabelsBody();
  openModal('Add pickup location', body, () => {
    if (!mv('label')||!mv('address')) return showToast('Label and address required','error');
    post('upsertPickupLocation', _locationPayload());
    closeModal(); renderPickupLocations();
  });
}

function openEditLocation(id) {
  const item = (state.snapshot?.pickupLocations||[]).find(function(x){return x._id===id||x.key===id;})||{};
  const body = mr2(mfld('Label *',minp('label',item.label)),mfld('Key',minp('key',item.key)))
    + mfld('Address *',minp('address',item.address))
    + mr3(mfld('Station key',minp('stationKey',item.stationKey||'default')),mfld('Location type',msel('locationType',[['both','Pickup & dropoff'],['pickup','Pickup only'],['dropoff','Dropoff only']],item.locationType||'both')),mfld('Extra fee €',minp('extraFee',item.extraFee,'number','0')))
    + mfld('Google Maps URL',minp('mapUrl',item.mapUrl,'url'))
    + mr2(mfld('Sort order',minp('sortOrder',item.sortOrder,'number','0')),mfld('',mchk('active',item.active!==false,'Active')+mchk('publicVisible',item.publicVisible!==false,'Public visible')))
    + _locationFieldLabelsBody(item);
  openModal('Edit pickup location', body, () => {
    post('upsertPickupLocation', _locationPayload({_id:item._id}));
    closeModal(); renderPickupLocations();
  }, () => {
    if (confirm('Delete location "'+item.label+'"?')) { post('deletePickupLocation',{itemId:item._id,itemKey:item.key}); closeModal(); renderPickupLocations(); }
  });
}

function editLocation(id) { return openEditLocation(id); }

function deleteLocation(id, label) {
  if (!confirm('Delete location "'+label+'"?')) return;
  post('deletePickupLocation',{itemId:id,itemKey:id});
  renderPickupLocations();
}

// ── SECURITY BUTTONS ──────────────────────────────────────────────────────
function bindSecurityButtons() {
  el('revokeAllBtn')?.addEventListener('click', () => {
    if (!confirm('Revoke ALL active sessions? All staff will be logged out.')) return;
    (state.access?.sessionRows||[]).forEach(r => post('revokeStaffSessions',{email:r.email||r.actorEmail}));
  });
  el('pwSetBtn')?.addEventListener('click', () => {
    const email = el('pwEmail')?.value?.trim();
    const pw = el('pwNew')?.value?.trim();
    if (!email) return showToast('Enter a staff email','error');
    if (!pw||pw.length<8) return showToast('Password must be at least 8 characters','error');
    if (!confirm(`Set password for ${email}?`)) return;
    post('setStaffPassword',{email,newPassword:pw,mustChangePassword:!!el('pwMustChange')?.checked});
  });
  el('pwResetBtn')?.addEventListener('click', () => {
    const email = el('pwEmail')?.value?.trim();
    if (!email) return showToast('Enter a staff email','error');
    if (!confirm(`Send password reset email to ${email}?`)) return;
    post('resetStaffPassword',{email});
  });
  el('inviteBtn')?.addEventListener('click', () => {
    const email = el('pwEmail')?.value?.trim();
    if (!email) return showToast('Enter a staff email','error');
    if (!confirm(`Send invite to ${email}?`)) return;
    post('inviteStaffUser', { email, fullName: '', roleKey: '' });
  });
}

