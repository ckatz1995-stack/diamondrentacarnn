function saveBizSettings() {
  const s = biz();
  const v = (id, sk, d='') => { const e=el(id); return e ? e.value.trim() : (s[sk]??d); };
  const n = (id, sk, d=0) => { const e=el(id); return e ? (Number(e.value)||0) : (s[sk]??d); };
  const c = (id, sk) => { const e=el(id); return e ? !!e.checked : !!(s[sk]??false); };
  post('saveBusinessSettings', {
    // Brand identity
    companyName:            v('bsCompanyName','companyName'),
    companyTagline:         v('bsCompanyTagline','companyTagline'),
    companyCity:            v('bsCompanyCity','companyCity'),
    companyAddress:         v('bsCompanyAddress','companyAddress'),
    companyPhone:           v('bsCompanyPhone','companyPhone'),
    companyEmail:           v('bsCompanyEmail','companyEmail'),
    footerNote:             v('bsFooterNote','footerNote'),
    // Social & contact
    facebookUrl:            v('bsFacebookUrl','facebookUrl'),
    instagramUrl:           v('bsInstagramUrl','instagramUrl'),
    whatsappNumber:         v('bsWhatsappNumber','whatsappNumber'),
    googleMapsUrl:          v('bsGoogleMapsUrl','googleMapsUrl'),
    // Financial
    currency:               v('bsCurrency','currency','EUR'),
    vatRate:                n('bsVatRate','vatRate',24),
    defaultDeposit:         n('bsDefaultDeposit','defaultDeposit',300),
    // Night window
    nightStartHour:         n('bsNightStartHour','nightStartHour',22),
    nightEndHour:           n('bsNightEndHour','nightEndHour',8),
    // Booking limits
    minRentalDays:          n('bsMinRentalDays','minRentalDays',1),
    maxRentalDays:          n('bsMaxRentalDays','maxRentalDays',30),
    minDriverAge:           n('bsMinDriverAge','minDriverAge',21),
    billingGraceMinutes:    n('bsBillingGraceMinutes','billingGraceMinutes',30),
    // Operations
    operatingHoursLabel:    v('bsOperatingHoursLabel','operatingHoursLabel'),
    afterHoursNotice:       v('bsAfterHoursNotice','afterHoursNotice'),
    allowOverbooking:       c('bsAllowOverbooking','allowOverbooking'),
    // Catalog display
    vehiclesPageDisplayMode: v('bsVehiclesPageDisplayMode','vehiclesPageDisplayMode','categories'),
    vehiclesPageModelsSource: v('bsVehiclesPageModelsSource','vehiclesPageModelsSource','fleet'),
    // Email automation
    enableTriggeredEmails:  c('bsEnableTriggeredEmails','enableTriggeredEmails'),
    bookingConfirmedTriggerId: v('bsBookingConfirmedTriggerId','bookingConfirmedTriggerId'),
    bookingCanceledTriggerId:  v('bsBookingCanceledTriggerId','bookingCanceledTriggerId'),
    emailFromName:          v('bsEmailFromName','emailFromName'),
    emailReplyTo:           v('bsEmailReplyTo','emailReplyTo'),
    // Rental terms
    rentalTermsTitle:       v('bsRentalTermsTitle','rentalTermsTitle'),
    rentalTermsIntro:       v('bsRentalTermsIntro','rentalTermsIntro'),
    rentalTermsBody:        v('bsRentalTermsBody','rentalTermsBody'),
    rentalRequirementsBody: v('bsRentalRequirementsBody','rentalRequirementsBody'),
    rentalPoliciesBody:     v('bsRentalPoliciesBody','rentalPoliciesBody'),
    rentalPrivacyBody:      v('bsRentalPrivacyBody','rentalPrivacyBody'),
    // Insurance texts
    insuranceTermsTitle:    v('bsInsuranceTermsTitle','insuranceTermsTitle'),
    insuranceTermsIntro:    v('bsInsuranceTermsIntro','insuranceTermsIntro'),
    insuranceTermsBody:     v('bsInsuranceTermsBody','insuranceTermsBody'),
    insuranceDetailsTitle:  v('bsInsuranceDetailsTitle','insuranceDetailsTitle'),
    insuranceDetailsIntro:  v('bsInsuranceDetailsIntro','insuranceDetailsIntro'),
    insuranceDetailsBody:   v('bsInsuranceDetailsBody','insuranceDetailsBody'),
  });
}

