function openCatModal(id='') {
  const item = id ? (state.snapshot?.vehicleCategories||[]).find(x=>x._id===id)||{} : {};
  const body = mr2(mfld('Title *',minp('title',item.title,'text','Economy')),mfld('Category code *',minp('category',item.category,'text','ECO')))
    + mr3(mfld('Price / day €',minp('price',item.price,'number','0')),mfld('Seats',minp('seats',item.seats,'text','5')),mfld('Doors',minp('doors',item.doors,'text','4')))
    + mr3(mfld('Luggage',minp('luggage',item.luggage,'text','2')),mfld('Transmission',msel('transmission',[['manual','Manual'],['automatic','Automatic'],['cvt','CVT']],item.transmission)),mfld('Fuel type',msel('fuelType',[['petrol','Petrol'],['diesel','Diesel'],['hybrid','Hybrid'],['electric','Electric']],item.fuelType)))
    + mchk('airCondition',item.airCondition,'Air conditioning')
    + mfld('Description',mta('description',item.description))
    + mr2(mfld('Sort order',minp('sortOrder',item.sortOrder,'number','0')),mfld('',mchk('active',item.active!==false,'Active')+mchk('publicVisible',item.publicVisible!==false,'Public visible')));
  openModal(id?'Edit fleet category':'Add fleet category', body, () => {
    if (!mv('title')) return showToast('Title is required','error');
    if (!mv('category')) return showToast('Category code is required','error');
    post('upsertVehicleCategory',{ _id:id||undefined, title:mv('title'), category:mv('category').toUpperCase(),
      price:mn('price'), seats:mv('seats'), doors:mv('doors'), luggage:mv('luggage'),
      transmission:mv('transmission'), fuelType:mv('fuelType'), airCondition:mc('airCondition'),
      description:mv('description'), sortOrder:mn('sortOrder'), active:mc('active'), publicVisible:mc('publicVisible') });
    closeModal();
  });
}

function openVehModal(id='') {
  const item = id ? (state.snapshot?.fleetVehicles||[]).find(x=>x._id===id)||{} : {};
  const cats = (state.snapshot?.vehicleCategories||[]);
