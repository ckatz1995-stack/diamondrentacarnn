function bindAddButtons() {
  el('addCatBtn')?.addEventListener('click', ()=>openCatModal());
  el('addVehBtn')?.addEventListener('click', ()=>openVehModal());
  el('addSeasonBtn')?.addEventListener('click', ()=>openSeasonModal());
