// ── MODAL ─────────────────────────────────────────────────────────────────
let modalSaveFn = null, modalDelFn = null;

function openModal(title, bodyHtml, onSave, onDelete=null, meta={}) {
  el('modalTitle').textContent = title;
  el('modalBody').innerHTML = bodyHtml;
  const eb = el('modalEyebrow'); if (eb) { eb.textContent = meta.eyebrow||''; eb.style.display = meta.eyebrow?'inline-flex':'none'; }
  const sub = el('modalSubtitle'); if (sub) { sub.textContent = meta.subtitle||''; sub.style.display = meta.subtitle?'block':'none'; }
  el('modalSave').textContent = meta.saveLabel || 'Save changes';
  el('modalDelete').style.display = onDelete ? 'inline-flex' : 'none';
  modalSaveFn = onSave;
  modalDelFn = onDelete;
  el('modalBody').scrollTop = 0;
  el('modal').classList.add('show');
  // Focus the first editable field in the drawer once the slide-in settles
  setTimeout(() => el('modalBody')?.querySelector('input:not([type=checkbox]):not([type=hidden]),select,textarea')?.focus(), 320);
  requestResize();
}

// Wire auto-slug: while key field is empty, fill it from the source field on input
function wireAutoSlug(srcId, keyId) {
  const src = el('m_'+srcId), key = el('m_'+keyId);
  if (!src || !key) return;
  let locked = key.value !== '';
  key.addEventListener('input', () => { locked = true; }, { once: true });
  src.addEventListener('input', () => { if (!locked) key.value = slug(src.value); });
}

function closeModal() {
  el('modal').classList.remove('show');
  modalSaveFn = null; modalDelFn = null;
}

el('modalClose')?.addEventListener('click', closeModal);
el('modalCancel')?.addEventListener('click', closeModal);
el('modal')?.addEventListener('click', e => { if (e.target === el('modal')) closeModal(); });
el('modalSave')?.addEventListener('click', () => { if (modalSaveFn) modalSaveFn(); });
el('modalDelete')?.addEventListener('click', () => { if (modalDelFn) modalDelFn(); });
document.addEventListener('keydown', e => {
  if (!el('modal')?.classList.contains('show')) return;
  if (e.key === 'Escape') { closeModal(); }
  if ((e.ctrlKey||e.metaKey) && e.key === 'Enter') { e.preventDefault(); if (modalSaveFn) modalSaveFn(); }
});

// Field group: label (with optional required marker) + input + optional hint
function mfld(label, input, hint='') {
  const lab = label ? `<label>${label.replace(/\s\*$/,' <span class="req">*</span>')}</label>` : '';
  return `<div class="field-group">${lab}${input}${hint?`<div class="fhint">${hint}</div>`:''}</div>`;
}
function minp(id, val='', type='text', ph='') { return `<input id="m_${id}" type="${type}" value="${esc(String(val??''))}" placeholder="${esc(ph)}">`; }
function msel(id, opts, cur='') { return `<select id="m_${id}">${opts.map(([v,l])=>`<option value="${v}"${v==cur?' selected':''}>${esc(l)}</option>`).join('')}</select>`; }
function mta(id, val='', ph='', rows=3) { return `<textarea id="m_${id}" rows="${rows}" placeholder="${esc(ph)}">${esc(String(val??''))}</textarea>`; }
// Number input, optionally with a unit badge on the right
function mnum(id, val, unit='', ph='0') { return unit
  ? `<div class="num-row"><input id="m_${id}" type="number" value="${esc(String(val??''))}" placeholder="${esc(ph)}"><span class="num-unit">${esc(unit)}</span></div>`
  : `<input id="m_${id}" type="number" value="${esc(String(val??''))}" placeholder="${esc(ph)}">`; }
// Toggle switch row (replaces plain checkboxes in modals)
function mtog(id, checked, label, hint='') {
  return `<div class="tog-row"><div class="tog-info"><b>${label}</b>${hint?`<small>${hint}</small>`:''}</div><label class="tog"><input type="checkbox" id="m_${id}"${checked?' checked':''}><span class="tog-bar"></span></label></div>`;
}
// Plain checkbox row (kept for dense grids like the role permission matrix)
function mchk(id, checked, label) { return `<div class="check-row"><input type="checkbox" id="m_${id}"${checked?' checked':''}><label for="m_${id}">${label}</label></div>`; }
// Section card inside a modal — reuses the .sc card styles from the panes
function msec(ico, title, body, desc='') { return `<div class="sc"><div class="sc-h"><span class="sc-ico">${ico}</span><h4>${esc(title)}</h4>${desc?`<span class="sc-desc">${esc(desc)}</span>`:''}</div><div class="sc-b">${body}</div></div>`; }
function mv(id, d='') { return el('m_'+id)?.value?.trim()??d; }
function mn(id, d=0) { return Number(el('m_'+id)?.value??d)||d; }
function mc(id) { return !!el('m_'+id)?.checked; }
function mr2(...f) { return `<div class="field-row cols-2">${f.join('')}</div>`; }
function mr3(...f) { return `<div class="field-row cols-3">${f.join('')}</div>`; }
// Highlight invalid field and show toast; returns false to allow caller to abort
function merr(id, msg) {
  const e = el('m_'+id);
  if (e) { e.classList.add('err'); e.focus(); setTimeout(()=>e.classList.remove('err'),2500); }
  showToast(msg, 'error');
  return false;
}
const reEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

// ── CRUD BUTTON BINDINGS ──────────────────────────────────────────────────
function bindCrudButtons() {
  const app = el('app');
  app.addEventListener('click', e => {
    const btn = e.target.closest('[data-edit-cat],[data-del-cat],[data-edit-veh],[data-del-veh],[data-edit-loc],[data-del-loc],[data-edit-season],[data-del-season],[data-edit-rule],[data-del-rule],[data-edit-ins],[data-del-ins],[data-edit-extra],[data-del-extra],[data-edit-fee],[data-del-fee],[data-edit-role],[data-edit-user],[data-deact-user],[data-react-user],[data-revoke-session]');
    if (!btn) return;
    const d = btn.dataset;
    if (d.editCat !== undefined) openCatModal(d.editCat);
    else if (d.delCat !== undefined) { if(confirm(`Delete category "${d.label}"?`)) post('deleteVehicleCategory',{itemId:d.delCat,categoryCode:d.label}); }
    else if (d.editVeh !== undefined) openVehModal(d.editVeh);
    else if (d.delVeh !== undefined) { if(confirm(`Delete vehicle "${d.label}"?`)) post('deleteFleetVehicle',{itemId:d.delVeh,plate:d.label}); }
    else if (d.editLoc !== undefined) openEditLocation(d.editLoc);
    else if (d.delLoc !== undefined) { if(confirm('Delete location "'+d.label+'"?')) post('deletePickupLocation',{itemId:d.delLoc,itemKey:d.key}); }
    else if (d.editSeason !== undefined) openSeasonModal(d.editSeason);
    else if (d.delSeason !== undefined) { if(confirm(`Delete season "${d.label}"?`)) post('deletePricingSeason',{itemId:d.delSeason,itemKey:d.key}); }
    else if (d.editRule !== undefined) openRuleModal(d.editRule);
    else if (d.delRule !== undefined) { if(confirm(`Delete rate rule "${d.label}"?`)) post('deleteCategoryRateRule',{itemId:d.delRule,itemKey:d.key}); }
    else if (d.editIns !== undefined) openInsModal(d.editIns);
    else if (d.delIns !== undefined) { if(confirm(`Delete insurance plan "${d.label}"?`)) post('deletePricingItem',{collectionName:'insurancePlans',itemId:d.delIns,itemKey:d.key}); }
    else if (d.editExtra !== undefined) openExtraModal(d.editExtra);
    else if (d.delExtra !== undefined) { if(confirm(`Delete extra service "${d.label}"?`)) post('deletePricingItem',{collectionName:'extraServices',itemId:d.delExtra,itemKey:d.key}); }
    else if (d.editFee !== undefined) openFeeModal(d.editFee);
    else if (d.delFee !== undefined) { if(confirm(`Delete fee rule "${d.label}"?`)) post('deletePricingItem',{collectionName:'feeRules',itemId:d.delFee,itemKey:d.key}); }
    else if (d.editRole !== undefined) openRoleModal(d.editRole);
    else if (d.editUser !== undefined) openUserModal(d.editUser);
    else if (d.deactUser !== undefined) { if(confirm(`Deactivate user ${d.email}?`)) post('deactivateStaffUser',{itemId:d.deactUser}); }
    else if (d.reactUser !== undefined) { if(confirm(`Reactivate user ${d.email}?`)) post('reactivateStaffUser',{itemId:d.reactUser}); }
    else if (d.revokeSession !== undefined) { if(confirm(`Revoke all sessions for ${d.revokeSession}?`)) post('revokeStaffSessions',{email:d.revokeSession}); }
  });
}

