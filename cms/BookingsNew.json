{
  "collectionId": "BookingsNew",
  "displayName": "Bookings",
  "description": "Customer booking records — the central collection of the app.",
  "permissions": { "read": "Admin", "insert": "Admin", "update": "Admin", "delete": "Admin" },
  "notes": "All reads/writes go through backend functions. Booking numbers follow the pattern RNT-YYYY-NNNN.",
  "fields": [
    { "key": "bookingNumber",           "displayName": "Booking Number",          "type": "Text",    "required": false, "description": "Human-readable ref, e.g. 'RNT-2026-0001'. Auto-generated." },
    { "key": "status",                  "displayName": "Status",                  "type": "Text",    "required": false, "description": "'Pending' | 'Confirmed' | 'Hold' | 'Escalated' | 'Canceled'" },
    { "key": "rentalState",             "displayName": "Rental State",            "type": "Text",    "required": false, "description": "'Booking' | 'Active Rental' | 'Pre Check-In' | 'Closed Rental'" },
    { "key": "statusChangedAt",         "displayName": "Status Changed At",       "type": "DateTime","required": false },
    { "key": "confirmedAt",             "displayName": "Confirmed At",            "type": "DateTime","required": false },
    { "key": "canceledAt",              "displayName": "Canceled At",             "type": "DateTime","required": false },

    { "key": "customerName",            "displayName": "Customer Name",           "type": "Text",    "required": false },
    { "key": "phone",                   "displayName": "Phone",                   "type": "Text",    "required": false },
    { "key": "email",                   "displayName": "Email",                   "type": "Text",    "required": false },
    { "key": "memberId",                "displayName": "Member ID",               "type": "Text",    "required": false, "description": "Wix member ID if customer is a registered member" },
    { "key": "customerCity",            "displayName": "Customer City",           "type": "Text",    "required": false },
    { "key": "originCity",              "displayName": "Origin City",             "type": "Text",    "required": false },
    { "key": "flightNumber",            "displayName": "Flight Number",           "type": "Text",    "required": false },
    { "key": "driverAgeBand",           "displayName": "Driver Age Band",         "type": "Text",    "required": false, "description": "'U25' | '25-29' | '30-64' | '65+'" },

    { "key": "pickupDateTime",          "displayName": "Pickup Date & Time",      "type": "DateTime","required": false },
    { "key": "dropoffDateTime",         "displayName": "Dropoff Date & Time",     "type": "DateTime","required": false },
    { "key": "pickuppoint",             "displayName": "Pickup Location",         "type": "Text",    "required": false, "description": "PickupLocations key or label string" },
    { "key": "dropoffpoint",            "displayName": "Dropoff Location",        "type": "Text",    "required": false },
    { "key": "pickupStation",           "displayName": "Pickup Station",          "type": "Text",    "required": false },
    { "key": "dropoffStation",          "displayName": "Dropoff Station",         "type": "Text",    "required": false },
    { "key": "pickupComment",           "displayName": "Pickup Comment",          "type": "Text",    "required": false },
    { "key": "dropoffComment",          "displayName": "Dropoff Comment",         "type": "Text",    "required": false },
    { "key": "billableDays",            "displayName": "Billable Days",           "type": "Number",  "required": false },

    { "key": "category",               "displayName": "Category Code",           "type": "Text",    "required": false },
    { "key": "categoryId",             "displayName": "Category ID",             "type": "Text",    "required": false },
    { "key": "bookedCategoryCode",     "displayName": "Booked Category Code",    "type": "Text",    "required": false },
    { "key": "assignedVehicle",        "displayName": "Assigned Vehicle ID",     "type": "Text",    "required": false, "description": "FleetNew._id" },
    { "key": "assignedVehiclePlate",   "displayName": "Assigned Vehicle Plate",  "type": "Text",    "required": false },
    { "key": "assignedVehicleModel",   "displayName": "Assigned Vehicle Model",  "type": "Text",    "required": false },
    { "key": "assignedVehicleLabel",   "displayName": "Assigned Vehicle Label",  "type": "Text",    "required": false },
    { "key": "assignedCategoryCode",   "displayName": "Assigned Category Code",  "type": "Text",    "required": false },
    { "key": "transmission",           "displayName": "Transmission Preference", "type": "Text",    "required": false },
    { "key": "fuelType",               "displayName": "Fuel Type Preference",    "type": "Text",    "required": false },

    { "key": "selectedPackage",         "displayName": "Insurance Package",       "type": "Text",    "required": false, "description": "InsurancePlans.key, e.g. 'cdw', 'scdw', 'full'" },
    { "key": "selectedExtras",          "displayName": "Selected Extras",         "type": "LongText","required": false, "description": "JSON array of ExtraServices keys" },
    { "key": "selectedExtrasList",      "displayName": "Selected Extras Detail",  "type": "LongText","required": false, "description": "JSON array of {key, title, price, billingMode}" },
    { "key": "extras",                  "displayName": "Extras Summary",          "type": "Text",    "required": false },

    { "key": "basePricePerDay",         "displayName": "Base Price / Day",        "type": "Number",  "required": false },
    { "key": "insuranceExtraPerDay",    "displayName": "Insurance Extra / Day",   "type": "Number",  "required": false },
    { "key": "extrasTotal",             "displayName": "Extras Total",            "type": "Number",  "required": false },
    { "key": "ageFee",                  "displayName": "Age Fee",                 "type": "Number",  "required": false },
    { "key": "nightFee",                "displayName": "Night Fee",               "type": "Number",  "required": false },
    { "key": "locationFee",             "displayName": "Location Fee",            "type": "Number",  "required": false },
    { "key": "pickupLocationFee",       "displayName": "Pickup Location Fee",     "type": "Number",  "required": false },
    { "key": "dropoffLocationFee",      "displayName": "Dropoff Location Fee",    "type": "Number",  "required": false },
    { "key": "totalPrice",              "displayName": "Total Price",             "type": "Number",  "required": false },
    { "key": "totalBalance",            "displayName": "Total Balance",           "type": "Number",  "required": false },
    { "key": "paymentStatus",           "displayName": "Payment Status",          "type": "Text",    "required": false, "description": "'Paid' | 'Pending' | 'Partial'" },

    { "key": "pricingSnapshot",         "displayName": "Pricing Snapshot",        "type": "LongText","required": false, "description": "JSON: full pricing breakdown at time of booking" },
    { "key": "financialSnapshot",       "displayName": "Financial Snapshot",      "type": "LongText","required": false, "description": "JSON: settlement and payment details" },

    { "key": "source",                  "displayName": "Source",                  "type": "Text",    "required": false, "description": "'backroom' | 'website' | 'agent' | 'cdp'" },
    { "key": "agent",                   "displayName": "Agent",                   "type": "Text",    "required": false },
    { "key": "cdp",                     "displayName": "CDP (Corporate)",         "type": "Text",    "required": false },
    { "key": "channel",                 "displayName": "Channel",                 "type": "Text",    "required": false },
    { "key": "companyName",             "displayName": "Company Name",            "type": "Text",    "required": false, "description": "Corporate booking company name" },
    { "key": "voucherNumber",           "displayName": "Voucher Number",          "type": "Text",    "required": false },
    { "key": "confirmationNumber",      "displayName": "Confirmation Number",     "type": "Text",    "required": false },

    { "key": "triageOwner",             "displayName": "Triage Owner",            "type": "Text",    "required": false },
    { "key": "triageUpdatedAt",         "displayName": "Triage Updated At",       "type": "DateTime","required": false },
    { "key": "triageLastAction",        "displayName": "Triage Last Action",      "type": "Text",    "required": false },
    { "key": "triageLastNote",          "displayName": "Triage Last Note",        "type": "LongText","required": false },
    { "key": "triageNextFollowUpAt",    "displayName": "Triage Next Follow-Up",   "type": "DateTime","required": false },
    { "key": "triageHistorySummary",    "displayName": "Triage History",          "type": "LongText","required": false, "description": "JSON array of triage history entries" },
    { "key": "triageAudit",             "displayName": "Triage Audit",            "type": "LongText","required": false, "description": "JSON object: full triage state" },
    { "key": "triageScore",             "displayName": "Triage Score",            "type": "Number",  "required": false },
    { "key": "vehicleServiceBlocked",   "displayName": "Vehicle Service Blocked", "type": "Boolean", "required": false },

    { "key": "internalMemo",            "displayName": "Internal Memo",           "type": "LongText","required": false },
    { "key": "remarks",                 "displayName": "Remarks",                 "type": "LongText","required": false },
    { "key": "customerComments",        "displayName": "Customer Comments",       "type": "LongText","required": false }
  ]
}
