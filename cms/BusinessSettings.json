{
  "collectionId": "BusinessSettings",
  "displayName": "Business Settings",
  "description": "Singleton record. Global company configuration — brand, financials, policies, email triggers, and content.",
  "permissions": { "read": "Admin", "insert": "Admin", "update": "Admin", "delete": "Admin" },
  "notes": "Only one record should exist. Backend always reads the first item (sorted by _createdDate).",
  "fields": [
    { "key": "title",                        "displayName": "Title",                       "type": "Text",     "required": false, "description": "Internal label, e.g. 'Main Settings'" },
    { "key": "companyName",                  "displayName": "Company Name",                "type": "Text",     "required": false },
    { "key": "companyTagline",               "displayName": "Company Tagline",             "type": "Text",     "required": false },
    { "key": "companyCity",                  "displayName": "Company City",                "type": "Text",     "required": false },
    { "key": "companyAddress",               "displayName": "Company Address",             "type": "Text",     "required": false },
    { "key": "companyPhone",                 "displayName": "Company Phone",               "type": "Text",     "required": false },
    { "key": "companyEmail",                 "displayName": "Company Email",               "type": "Text",     "required": false },
    { "key": "footerNote",                   "displayName": "Footer Note",                 "type": "Text",     "required": false },
    { "key": "facebookUrl",                  "displayName": "Facebook URL",                "type": "URL",      "required": false },
    { "key": "instagramUrl",                 "displayName": "Instagram URL",               "type": "URL",      "required": false },
    { "key": "whatsappNumber",               "displayName": "WhatsApp Number",             "type": "Text",     "required": false },
    { "key": "googleMapsUrl",                "displayName": "Google Maps URL",             "type": "URL",      "required": false },
    { "key": "currency",                     "displayName": "Currency",                    "type": "Text",     "required": false, "description": "ISO 4217, e.g. EUR" },
    { "key": "vatRate",                      "displayName": "VAT Rate (%)",                "type": "Number",   "required": false, "description": "e.g. 24" },
    { "key": "vatRateDecimal",               "displayName": "VAT Rate (decimal)",          "type": "Number",   "required": false, "description": "e.g. 0.24 — computed from vatRate" },
    { "key": "defaultDeposit",               "displayName": "Default Deposit",             "type": "Number",   "required": false },
    { "key": "nightStartHour",               "displayName": "Night Start Hour",            "type": "Number",   "required": false, "description": "e.g. 22" },
    { "key": "nightEndHour",                 "displayName": "Night End Hour",              "type": "Number",   "required": false, "description": "e.g. 8" },
    { "key": "billingGraceMinutes",          "displayName": "Billing Grace Minutes",       "type": "Number",   "required": false },
    { "key": "minRentalDays",               "displayName": "Min Rental Days",             "type": "Number",   "required": false },
    { "key": "maxRentalDays",               "displayName": "Max Rental Days",             "type": "Number",   "required": false },
    { "key": "minDriverAge",                 "displayName": "Min Driver Age",              "type": "Number",   "required": false },
    { "key": "operatingHoursLabel",          "displayName": "Operating Hours Label",       "type": "Text",     "required": false, "description": "e.g. '09:00 – 21:00'" },
    { "key": "afterHoursNotice",             "displayName": "After-Hours Notice",          "type": "Text",     "required": false },
    { "key": "allowOverbooking",             "displayName": "Allow Overbooking",           "type": "Boolean",  "required": false },
    { "key": "vehiclesPageDisplayMode",      "displayName": "Vehicles Page Display Mode",  "type": "Text",     "required": false, "description": "'categories' | 'models'" },
    { "key": "vehiclesPageModelsSource",     "displayName": "Vehicles Page Models Source", "type": "Text",     "required": false, "description": "'fleet' | 'vehicles'" },
    { "key": "enableTriggeredEmails",        "displayName": "Enable Triggered Emails",     "type": "Boolean",  "required": false },
    { "key": "bookingConfirmedTriggerId",    "displayName": "Booking Confirmed Trigger ID","type": "Text",     "required": false },
    { "key": "bookingCanceledTriggerId",     "displayName": "Booking Canceled Trigger ID", "type": "Text",     "required": false },
    { "key": "emailFromName",                "displayName": "Email From Name",             "type": "Text",     "required": false },
    { "key": "emailReplyTo",                 "displayName": "Email Reply-To",              "type": "Text",     "required": false },
    { "key": "rentalTermsTitle",             "displayName": "Rental Terms Title",          "type": "Text",     "required": false },
    { "key": "rentalTermsIntro",             "displayName": "Rental Terms Intro",          "type": "LongText", "required": false },
    { "key": "rentalTermsBody",              "displayName": "Rental Terms Body",           "type": "LongText", "required": false },
    { "key": "rentalRequirementsBody",       "displayName": "Rental Requirements Body",    "type": "LongText", "required": false },
    { "key": "rentalPoliciesBody",           "displayName": "Rental Policies Body",        "type": "LongText", "required": false },
    { "key": "rentalPrivacyBody",            "displayName": "Rental Privacy Body",         "type": "LongText", "required": false },
    { "key": "insuranceTermsTitle",          "displayName": "Insurance Terms Title",       "type": "Text",     "required": false },
    { "key": "insuranceTermsIntro",          "displayName": "Insurance Terms Intro",       "type": "LongText", "required": false },
    { "key": "insuranceTermsBody",           "displayName": "Insurance Terms Body",        "type": "LongText", "required": false },
    { "key": "insuranceDetailsTitle",        "displayName": "Insurance Details Title",     "type": "Text",     "required": false },
    { "key": "insuranceDetailsIntro",        "displayName": "Insurance Details Intro",     "type": "LongText", "required": false },
    { "key": "insuranceDetailsBody",         "displayName": "Insurance Details Body",      "type": "LongText", "required": false },
    { "key": "stationProfiles",              "displayName": "Station Profiles",            "type": "LongText", "required": false, "description": "JSON array of station config objects: [{key, label, description, city, address, sortOrder, active}]" },
    { "key": "active",                       "displayName": "Active",                      "type": "Boolean",  "required": false }
  ]
}
