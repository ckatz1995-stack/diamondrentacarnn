{
  "collectionId": "StaffCredentials",
  "displayName": "Staff Credentials",
  "description": "Stores hashed passwords and credential metadata for staff accounts. Never exposes raw passwords.",
  "permissions": { "read": "Admin", "insert": "Admin", "update": "Admin", "delete": "Admin" },
  "notes": "One record per StaffUsers entry. passwordHash is a bcrypt hash. Backend enforces that this collection is never exposed to the client.",
  "fields": [
    { "key": "staffId",               "displayName": "Staff User ID",           "type": "Text",    "required": true,  "description": "StaffUsers._id (one-to-one)" },
    { "key": "username",              "displayName": "Username",                "type": "Text",    "required": true,  "description": "Denormalised for login lookup without a join" },
    { "key": "displayTitle",          "displayName": "Display Title",           "type": "Text",    "required": false, "description": "Computed: username. Written by backend." },
    { "key": "passwordHash",          "displayName": "Password Hash",           "type": "Text",    "required": false, "description": "bcrypt hash of the staff member's password" },
    { "key": "passwordChangedAt",     "displayName": "Password Changed At",     "type": "DateTime","required": false },
    { "key": "resetToken",            "displayName": "Reset Token",             "type": "Text",    "required": false, "description": "Temporary token for password reset flow" },
    { "key": "resetTokenExpiresAt",   "displayName": "Reset Token Expires At",  "type": "DateTime","required": false },
    { "key": "failedAttempts",        "displayName": "Failed Login Attempts",   "type": "Number",  "required": false },
    { "key": "lockedUntil",           "displayName": "Locked Until",            "type": "DateTime","required": false, "description": "Account locked after too many failed attempts" }
  ]
}
